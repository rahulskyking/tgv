@model IReadOnlyList<TheGameVoice.Domain.Entities.Tag>

<div class="space-y-6">

    @if (TempData["Success"] != null)
    {
        <div class="rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-green-700">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
            @TempData["Error"]
        </div>
    }
    <div class="flex items-center justify-between">

        <h1 class="text-3xl font-bold">
            Tags
        </h1>

        <a asp-action="Create"
           class="tgv-button-primary">
            Create Tag
        </a>

    </div>

    <div class="overflow-hidden rounded-2xl bg-white shadow-sm">

        <table class="min-w-full">

            <thead class="border-b bg-gray-50">

                <tr>

                    <th class="px-6 py-4 text-left">
                        Name
                    </th>

                    <th class="px-6 py-4 text-left">
                        Slug
                    </th>

                    <th class="px-6 py-4 text-left">
                        Created
                    </th>

                    <th class="px-6 py-4 text-center w-40">
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var tag in Model)
                {
                    <tr class="border-b hover:bg-slate-50">

                        <td class="px-6 py-4 font-medium">
                            @tag.Name
                        </td>

                        <td class="px-6 py-4 text-gray-500">
                            @tag.Slug
                        </td>

                        <td class="px-6 py-4">
                            @tag.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </td>

                        <td class="px-6 py-4">

                            <div class="flex justify-center">

                                <form asp-action="Delete"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this tag?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@tag.Id" />

                                    <button type="submit"
                                            class="rounded-lg bg-red-500 px-4 py-2 text-sm font-medium text-white transition hover:bg-red-600">

                                        Delete

                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>