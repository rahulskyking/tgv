@model TheGameVoice.Web.Areas.Admin.ViewModels.Tags.EditTagViewModel
@{ ViewData["Title"] = "Edit Tag"; }

<div class="mx-auto max-w-2xl space-y-6 text-ink">
    <a asp-action="Index" class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary"><span aria-hidden="true">←</span> Back to tag library</a>
    <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-widest text-primary">Content library</p>
        <h1 class="text-fluid-3xl font-bold">Edit tag</h1>
        <p class="mt-2 break-words text-sm text-ink-muted">Update the display name for @Model.Name.</p>
    </div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-6 rounded-2xl border border-line bg-surface p-5 md:p-8">
        <input asp-for="Id" type="hidden" />
        <partial name="_NameField" model="Model" />
        <div class="rounded-xl bg-primary/10 p-4 text-sm leading-relaxed text-ink-soft">
            <p class="font-semibold">Your public URL stays the same</p>
            <p class="mt-1 break-all">/tag/@Model.Slug</p>
            <p class="mt-2">Renaming updates the tag label, not its URL or article assignments. Existing links will keep working.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3 border-t border-line pt-5">
            <button type="submit" class="min-h-11 rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-white hover:bg-primary-hover">Save changes</button>
            <a asp-action="Index" class="inline-flex min-h-11 items-center rounded-xl border border-line px-5 py-3 text-sm font-semibold">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
