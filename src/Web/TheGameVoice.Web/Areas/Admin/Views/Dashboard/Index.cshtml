@model TheGameVoice.Web.Areas.Admin.ViewModels.Dashboard.DashboardViewModel

<div class="space-y-8">

    <div>

        <h1 class="text-3xl font-bold text-gray-800">

            Dashboard

        </h1>

        <p class="mt-2 text-gray-500">

            Welcome back to TheGameVoice CMS

        </p>

    </div>

    <!-- KPI CARDS -->

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">

        <div class="rounded-2xl bg-white p-6 shadow-sm">

            <p class="text-sm text-gray-500">

                Draft Articles

            </p>

            <h2 class="mt-3 text-4xl font-bold text-[#fa743e]">

                @Model.DraftArticlesCount

            </h2>

        </div>

        <div class="rounded-2xl bg-white p-6 shadow-sm">

            <p class="text-sm text-gray-500">

                Pending Reviews

            </p>

            <h2 class="mt-3 text-4xl font-bold text-blue-600">

                @Model.ReviewPendingCount

            </h2>

        </div>

        <div class="rounded-2xl bg-white p-6 shadow-sm">

            <p class="text-sm text-gray-500">

                Published Articles

            </p>

            <h2 class="mt-3 text-4xl font-bold text-green-600">

                @Model.PublishedArticlesCount

            </h2>

        </div>

        <div class="rounded-2xl bg-white p-6 shadow-sm">

            <p class="text-sm text-gray-500">

                Archived Articles

            </p>

            <h2 class="mt-3 text-4xl font-bold text-gray-600">

                @Model.ArchivedArticlesCount

            </h2>

        </div>

    </div>

    <!-- SYSTEM CARDS -->

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">

        <div class="rounded-2xl bg-white p-6 shadow-sm">

            <p class="text-sm text-gray-500">

                Users

            </p>

            <h2 class="mt-3 text-4xl font-bold text-[#fa743e]">

                @Model.UsersCount

            </h2>

        </div>

        <div class="rounded-2xl bg-white p-6 shadow-sm">

            <p class="text-sm text-gray-500">

                Media Files

            </p>

            <h2 class="mt-3 text-4xl font-bold text-[#fa743e]">

                @Model.MediaCount

            </h2>

        </div>

        <div class="rounded-2xl bg-white p-6 shadow-sm">

            <p class="text-sm text-gray-500">

                Categories

            </p>

            <h2 class="mt-3 text-4xl font-bold text-[#fa743e]">

                @Model.CategoriesCount

            </h2>

        </div>

        <div class="rounded-2xl bg-white p-6 shadow-sm">

            <p class="text-sm text-gray-500">

                Tags

            </p>

            <h2 class="mt-3 text-4xl font-bold text-[#fa743e]">

                @Model.TagsCount

            </h2>

        </div>

    </div>

    <!-- QUICK ACTIONS -->

    <div class="rounded-2xl bg-white p-6 shadow-sm">

        <h2 class="mb-6 text-xl font-bold">

            Quick Actions

        </h2>

        <div class="flex flex-wrap gap-4">

            <a asp-controller="Articles"
               asp-action="Create"
               class="rounded-xl bg-[#fa743e] px-5 py-3 text-white">

                Create Article

            </a>

            <a asp-controller="Media"
               asp-action="Upload"
               class="rounded-xl bg-[#fa743e] px-5 py-3 text-white">

                Upload Media

            </a>

            <a asp-controller="Users"
               asp-action="Create"
               class="rounded-xl bg-[#fa743e] px-5 py-3 text-white">

                Create User

            </a>

            <a asp-controller="Categories"
               asp-action="Index"
               class="rounded-xl bg-[#fa743e] px-5 py-3 text-white">

                Categories

            </a>

        </div>

    </div>

    <!-- RECENT ARTICLES -->

    <div class="rounded-2xl bg-white p-6 shadow-sm">

        <div class="mb-6 flex items-center justify-between">

            <h2 class="text-xl font-bold">

                Recent Articles

            </h2>

            <a asp-controller="Articles"
               asp-action="Index"
               class="text-[#fa743e]">

                View All

            </a>

        </div>

        <div class="overflow-x-auto">

            <table class="w-full">

                <thead>

                    <tr class="border-b">

                        <th class="px-4 py-3 text-left">

                            Title

                        </th>

                        <th class="px-4 py-3 text-left">

                            Status

                        </th>

                        <th class="px-4 py-3 text-left">

                            Created

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var article in Model.RecentArticles)
                    {
                        <tr class="border-b">

                            <td class="px-4 py-4">

                                @article.Title

                            </td>

                            <td class="px-4 py-4">

                                @if (article.Status == "Draft")
                                {
                                    <span class="rounded-full bg-gray-100 px-3 py-1 text-sm">

                                        Draft

                                    </span>
                                }
                                else if (article.Status == "ReviewPending")
                                {
                                    <span class="rounded-full bg-blue-100 px-3 py-1 text-sm text-blue-700">

                                        Pending

                                    </span>
                                }
                                else if (article.Status == "Published")
                                {
                                    <span class="rounded-full bg-green-100 px-3 py-1 text-sm text-green-700">

                                        Published

                                    </span>
                                }
                                else if (article.Status == "Rejected")
                                {
                                    <span class="rounded-full bg-red-100 px-3 py-1 text-sm text-red-700">

                                        Rejected

                                    </span>
                                }
                                else
                                {
                                    <span class="rounded-full bg-gray-200 px-3 py-1 text-sm">

                                        Archived

                                    </span>
                                }

                            </td>

                            <td class="px-4 py-4">

                                @article.CreatedAt.ToString("dd MMM yyyy")

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>