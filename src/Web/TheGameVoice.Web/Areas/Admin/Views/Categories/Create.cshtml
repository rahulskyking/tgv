@model TheGameVoice.Web.Areas.Admin.ViewModels.Categories.CreateCategoryViewModel

<div class="max-w-2xl space-y-6">

    <h1 class="text-3xl font-bold">
        Create Category
    </h1>

    <form method="post"
          class="space-y-6">

        <div>

            <label class="mb-2 block font-medium">
                Category Name
            </label>

            <input asp-for="Name"
                   class="w-full rounded-lg border px-4 py-3" />

        </div>

        <button type="submit"
                class="rounded-lg bg-[#fa743e] px-6 py-3 text-white">
            Create Category
        </button>

    </form>

</div>