@model TheGameVoice.Web.Areas.Admin.ViewModels.Categories.CreateCategoryViewModel

<div class="max-w-2xl space-y-6">

    <h1 class="text-3xl font-bold">
        Create Category
    </h1>

    <form method="post"
          class="space-y-6">

        <div>

            <label class="mb-2 block font-medium">
                Category Name
            </label>

            <input asp-for="Name"
                   class="w-full rounded-lg border px-4 py-3" />

        </div>

        <div>

            <label class="mb-2 block font-medium">
                Show in section
            </label>

            <p class="mb-3 text-sm text-slate-500">
                Which side of the site this category appears in
                (header navigation and listings).
            </p>

            <label class="mb-2 flex items-center gap-3 rounded-lg border px-4 py-3">

                <input asp-for="IsPcConsole" class="h-4 w-4" />

                <span>PC / Console games</span>

            </label>

            <label class="flex items-center gap-3 rounded-lg border px-4 py-3">

                <input asp-for="IsMobile" class="h-4 w-4" />

                <span>Mobile games</span>

            </label>

        </div>

        <button type="submit"
                class="rounded-lg bg-[#fa743e] px-6 py-3 text-white">
            Create Category
        </button>

    </form>

</div>