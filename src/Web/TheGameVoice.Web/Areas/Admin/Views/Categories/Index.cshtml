@model IReadOnlyList<TheGameVoice.Domain.Entities.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="space-y-8">

    <div class="flex items-center justify-between">

        <div>
            <h1 class="text-3xl font-bold text-slate-900">
                Categories
            </h1>

            <p class="mt-1 text-sm text-slate-500">
                Drag and drop categories to control their order across the website.
            </p>
        </div>

        <div class="flex gap-3">

            <a asp-action="Create"
               class="rounded-xl bg-[#fa743e] px-5 py-3 font-medium text-white shadow transition hover:opacity-90">

                + Create Category

            </a>

            <button id="saveOrder"
                    class="rounded-xl bg-[#7c3aed] px-5 py-3 font-medium text-white shadow transition hover:bg-[#6d28d9]">

                Save Order

            </button>

        </div>

    </div>

    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">

        <ul id="categoryList">

            @foreach (var category in Model)
            {
                <li data-id="@category.Id"
                    class="flex cursor-move items-center justify-between border-b border-slate-100 px-6 py-5 transition hover:bg-violet-50">

                    <div class="flex items-center gap-4">

                        <div class="text-2xl text-slate-400">
                            ☰
                        </div>

                        <div>

                            <div class="font-semibold text-slate-900">
                                @category.Name
                            </div>

                            <div class="text-sm text-slate-500">
                                @category.Slug
                            </div>

                        </div>

                    </div>

                    <div class="text-sm text-slate-400">

                        @category.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")

                    </div>

                </li>
            }

        </ul>

    </div>

</div>



    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

    <script>

        new Sortable(document.getElementById("categoryList"),{

            animation:200,

            ghostClass:"bg-violet-100"

        });

        document
        .getElementById("saveOrder")
        .addEventListener("click",async()=>{

            const ids=[...document.querySelectorAll("#categoryList li")]
                .map(x=>x.dataset.id);

            const token=document.querySelector("input[name='__RequestVerificationToken']")?.value;

            const response=await fetch("@Url.Action("Reorder")",{

                method:"POST",

                headers:{
                    "Content-Type":"application/json",
                    "RequestVerificationToken":token
                },

                body:JSON.stringify(ids)

            });

            if(response.ok){

                location.reload();

            }else{

                alert("Unable to save order.");

            }

        });

    </script>

    @Html.AntiForgeryToken()
