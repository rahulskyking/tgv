@model TheGameVoice.Web.Areas.Admin.ViewModels.Users.CreateUserViewModel

<div class="space-y-6">

    <div class="flex items-center justify-between">

        <h1 class="text-3xl font-bold">
            Create User
        </h1>

        <a asp-action="Index"
           class="rounded-xl border px-4 py-2">

            Back

        </a>

    </div>

    <form method="post"
          class="space-y-6 rounded-2xl bg-white p-6 shadow-sm">

        <div>

            <label class="mb-2 block font-medium">

                Full Name

            </label>

            <input asp-for="FullName"
                   class="w-full rounded-xl border px-4 py-3" />

            <span asp-validation-for="FullName"
                  class="text-red-500 text-sm"></span>

        </div>

        <div>

            <label class="mb-2 block font-medium">

                Username

            </label>

            <input asp-for="UserName"
                   class="w-full rounded-xl border px-4 py-3" />

            <span asp-validation-for="UserName"
                  class="text-red-500 text-sm"></span>

        </div>

        <div>

            <label class="mb-2 block font-medium">

                Email

            </label>

            <input asp-for="Email"
                   class="w-full rounded-xl border px-4 py-3" />

            <span asp-validation-for="Email"
                  class="text-red-500 text-sm"></span>

        </div>

        <div>

            <label class="mb-2 block font-medium">

                Password

            </label>

            <input asp-for="Password"
                   type="password"
                   class="w-full rounded-xl border px-4 py-3" />

            <span asp-validation-for="Password"
                  class="text-red-500 text-sm"></span>

        </div>

        <div>

            <label class="mb-2 block font-medium">

                Role

            </label>

            <select asp-for="Role"
                    class="w-full rounded-xl border px-4 py-3">

                <option value="">
                    Select Role
                </option>

                @foreach (var role in Model.Roles)
                {
                    <option value="@role.Value">
                        @role.Text
                    </option>
                }

            </select>

            <span asp-validation-for="Role"
                  class="text-red-500 text-sm"></span>

        </div>

        <button type="submit"
                class="rounded-xl bg-primary px-6 py-3 text-white">

            Create User

        </button>

    </form>

</div>