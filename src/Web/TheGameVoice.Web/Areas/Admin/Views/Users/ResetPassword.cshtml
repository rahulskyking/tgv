@model TheGameVoice.Web.Areas.Admin.ViewModels.Users.ResetPasswordViewModel

<div class="space-y-6">

    <h1 class="text-3xl font-bold">

        Reset Password

    </h1>

    <form method="post"
          class="space-y-6 rounded-2xl bg-white p-6 shadow-sm">

        <input asp-for="UserId"
               type="hidden" />

        <div>

            <label class="mb-2 block font-medium">

                Username

            </label>

            <input asp-for="UserName"
                   readonly
                   class="w-full rounded-xl border bg-slate-100 px-4 py-3" />

        </div>

        <div>

            <label class="mb-2 block font-medium">

                New Password

            </label>

            <input asp-for="NewPassword"
                   type="password"
                   class="w-full rounded-xl border px-4 py-3" />

            <span asp-validation-for="NewPassword"
                  class="text-sm text-red-500"></span>

        </div>

        <div>

            <label class="mb-2 block font-medium">

                Confirm Password

            </label>

            <input asp-for="ConfirmPassword"
                   type="password"
                   class="w-full rounded-xl border px-4 py-3" />

            <span asp-validation-for="ConfirmPassword"
                  class="text-sm text-red-500"></span>

        </div>

        <button type="submit"
                class="rounded-xl bg-primary px-6 py-3 text-black">

            Reset Password

        </button>

    </form>

</div>