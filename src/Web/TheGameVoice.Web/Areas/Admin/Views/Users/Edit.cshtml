@model TheGameVoice.Web.Areas.Admin.ViewModels.Users.EditUserViewModel

<div class="space-y-6">

    <div class="flex items-center justify-between">

        <h1 class="text-3xl font-bold">
            Create User
        </h1>

        <a asp-action="Index"
           class="rounded-xl border px-4 py-2">

            Back

        </a>

    </div>

    <form method="post"
          class="space-y-6 rounded-2xl bg-white p-6 shadow-sm">

        <div>

            <label class="mb-2 block font-medium">

                Full Name

            </label>

            <input asp-for="FullName"
                   class="w-full rounded-xl border px-4 py-3" />

            <span asp-validation-for="FullName"
                  class="text-red-500 text-sm"></span>

        </div>

        <div>

            <label class="mb-2 block font-medium">

                Username

            </label>

            <input asp-for="UserName"
                   class="w-full rounded-xl border px-4 py-3" />

            <span asp-validation-for="UserName"
                  class="text-red-500 text-sm"></span>

        </div>

        <div>

            <label class="mb-2 block font-medium">

                Email

            </label>

            <input asp-for="Email"
                   class="w-full rounded-xl border px-4 py-3" />

            <span asp-validation-for="Email"
                  class="text-red-500 text-sm"></span>

        </div>

       

        <div>

            <label class="mb-2 block font-medium">

                Role

            </label>

            <select asp-for="Role"
                    class="w-full rounded-xl border px-4 py-3">

                <option value="">
                    Select Role
                </option>

                @foreach (var role in Model.Roles)
                {
                    <option value="@role.Value">
                        @role.Text
                    </option>
                }

            </select>

            <span asp-validation-for="Role"
                  class="text-red-500 text-sm"></span>

        </div>
        <hr class="my-6" />

        <h2 class="text-xl font-semibold">

            Author Profile

        </h2>

        <div>

            <label class="mb-2 block font-medium">

                Slug

            </label>

            <input asp-for="Slug"
                   class="w-full rounded-xl border px-4 py-3" />

        </div>

        <div>

            <label class="mb-2 block font-medium">

                Bio

            </label>

            <textarea asp-for="Bio"
                      rows="5"
                      class="w-full rounded-xl border px-4 py-3"></textarea>

        </div>
        <div>

            <label class="mb-2 block font-medium">

                Avatar

            </label>

            <select asp-for="AvatarImageId"
                    id="avatar-image-select"
                    class="w-full rounded-xl border px-4 py-3">

                <option value="">
                    Select Avatar
                </option>

                @foreach (var media in Model.MediaItems)
                {
                    <option value="@media.Id"
                            data-image="@media.FilePath">

                        @media.FileName

                    </option>
                }

            </select>

        </div>
        <div id="avatar-preview"
             class="mt-4 overflow-hidden rounded-xl border bg-slate-50">

            <img id="avatar-preview-image"
                 class="hidden h-48 w-full object-cover" />

            <div id="avatar-preview-placeholder"
                 class="flex h-48 items-center justify-center text-sm text-gray-500">

                No avatar selected

            </div>

        </div>
        <div>

            <label class="mb-2 block font-medium">

                Twitter / X

            </label>

            <input asp-for="TwitterUrl"
                   class="w-full rounded-xl border px-4 py-3" />

        </div>

        <div>

            <label class="mb-2 block font-medium">

                YouTube

            </label>

            <input asp-for="YouTubeUrl"
                   class="w-full rounded-xl border px-4 py-3" />

        </div>

        <div>

            <label class="mb-2 block font-medium">

                Website

            </label>

            <input asp-for="WebsiteUrl"
                   class="w-full rounded-xl border px-4 py-3" />

        </div>
        <input asp-for="IsActive"
               type="checkbox" />
        <button type="submit"
                class="rounded-xl bg-primary px-6 py-3 text-white">

            Create User

        </button>

    </form>

</div>