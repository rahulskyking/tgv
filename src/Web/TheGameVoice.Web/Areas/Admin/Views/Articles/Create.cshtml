@model TheGameVoice.Web.Areas.Admin.ViewModels.Articles.CreateArticleViewModel

<div class="space-y-6">

    <div>
        <h1 class="text-3xl font-bold">
            Create Article
        </h1>
    </div>

    <form method="post"
          class="space-y-6">

        <div>

            <label class="mb-2 block font-medium">
                Title
            </label>

            <input asp-for="Title"
                   class="w-full rounded-lg border px-4 py-3" />

        </div>

        <div>

            <label class="mb-2 block font-medium">
                Summary
            </label>

            <textarea asp-for="Summary"
                      rows="4"
                      class="w-full rounded-lg border px-4 py-3"></textarea>

        </div>

        <div>

            <label class="mb-2 block font-medium">
                Content
            </label>

            <textarea asp-for="Content"
                      id="editor"
                      rows="12"
                      class="w-full rounded-lg border px-4 py-3"></textarea>

        </div>

        <div>

            <label class="mb-2 block font-medium">
                SEO Title
            </label>

            <input asp-for="SeoTitle"
                   class="w-full rounded-lg border px-4 py-3" />

        </div>

        <div>

            <label class="mb-2 block font-medium">
                SEO Description
            </label>

            <textarea asp-for="SeoDescription"
                      rows="3"
                      class="w-full rounded-lg border px-4 py-3"></textarea>

        </div>

        <button type="submit"
                class="rounded-lg bg-[#fa743e] px-6 py-3 text-white">
            Save Draft
        </button>

    </form>

</div>