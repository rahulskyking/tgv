@using TheGameVoice.Infrastructure.Identity
@model TheGameVoice.Web.Areas.Admin.ViewModels.Articles.ArticleFormViewModel


<div class="grid grid-cols-1 gap-8 xl:grid-cols-[1fr_350px]">

    <!-- MAIN CONTENT -->

    <div class="space-y-6">

        <div class="rounded-2xl border bg-white p-6 shadow-sm">

        <div>

            <label class="mb-2 block text-sm font-semibold">
                Title
            </label>

            <input asp-for="Title"
                   class="w-full rounded-xl border border-default px-4 py-3" />

        </div>

        <div>

            <label class="mb-2 block text-sm font-semibold">
                Summary
            </label>

            <textarea asp-for="Summary"
                      rows="4"
                      class="w-full rounded-xl border border-default px-4 py-3">
            </textarea>

        </div>
            
        </div>

        <div class="rounded-2xl border bg-white p-6 shadow-sm">

            <label class="mb-3 block text-sm font-bold uppercase tracking-wide">

                Content

            </label>

            <textarea asp-for="Content"
                      id="editor">
    </textarea>

        </div>
        <partial name="Components/_ReviewEditor"
                 model="Model" />
    </div>

    <!-- SIDEBAR -->

    <aside class="space-y-6 xl:sticky xl:top-6 xl:self-start">

        <div class="rounded-2xl border border-default bg-white p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                Publishing

            </h3>

            <div class="mb-4 rounded-xl bg-slate-100 px-4 py-3">

                <div class="text-xs uppercase tracking-wide text-gray-500">

                    Current Status

                </div>
                <div class="mt-1 font-semibold">

                    @Model.StatusDisplay

                </div>

            </div>

            <div class="space-y-3">

                <button type="submit"
                        class="w-full rounded-xl bg-primary px-4 py-3 text-black">

                    Save Draft

                </button>

                @if (Model is TheGameVoice.Web.Areas.Admin.ViewModels.Articles.EditArticleViewModel editModel)
                {
                    <a asp-action="Preview"
                       asp-route-id="@editModel.Id"
                       target="_blank"
                       class="block w-full rounded-xl border border-[#fa743e] px-4 py-3 text-center font-medium text-[#fa743e]">

                        Preview Article

                    </a>
                }

                <button type="button"
                        disabled
                        class="w-full cursor-not-allowed rounded-xl bg-slate-200 px-4 py-3 text-slate-500">

                    Submit For Review
                    (Coming Soon)

                </button>

            </div>
            <div class="rounded-2xl border border-default bg-white p-5">

                <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                    Author

                </h3>

                @if (User.IsInRole(Roles.Author))
                {
                    <input asp-for="AuthorId"
                           type="hidden" />

                    <div class="rounded-xl bg-slate-100 px-4 py-3">

                        @Model.Authors
                        .FirstOrDefault(
                        x => x.Value ==
                        Model.AuthorId.ToString())
                        ?.Text

                    </div>
                }
                else
                {
                    <select asp-for="AuthorId"
                            class="w-full rounded-xl border border-default px-4 py-3">

                        @foreach (var author in Model.Authors)
                        {
                            <option value="@author.Value">
                                @author.Text
                            </option>
                        }

                    </select>
                }

            </div>

        </div>

        <div class="rounded-2xl border border-default bg-white p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                Category

            </h3>

            <select asp-for="CategoryId"
                    class="w-full rounded-xl border border-default px-4 py-3">

                <option value="">
                    Select Category
                </option>

                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Value">
                        @category.Text
                    </option>
                }

            </select>

        </div>

        <div class="rounded-2xl border border-default bg-white p-5">

            <div class="mb-4 flex items-center justify-between">

                <h3 class="text-sm font-bold uppercase tracking-wide">
                    Tags
                </h3>

                <button type="button"
                        id="open-tag-modal"
                        class="rounded-lg bg-primary px-3 py-2 text-xs text-black">

                    + Add

                </button>

            </div>

            <select asp-for="SelectedTagIds"
                    multiple
                    id="tags-select"
                    placeholder="Search tags...">

                @foreach (var tag in Model.Tags)
                {
                    <option value="@tag.Value">
                        @tag.Text
                    </option>
                }

            </select>

        </div>

        <div class="rounded-2xl border border-default bg-white p-5">

            <div class="mb-4 flex items-center justify-between">

                <h3 class="text-sm font-bold uppercase tracking-wide">
                    Games
                </h3>

                <button type="button"
                        id="open-game-modal"
                        class="rounded-lg bg-primary px-3 py-2 text-xs text-black">

                    + Add

                </button>

            </div>
            <select asp-for="SelectedGameIds"
                    multiple
                    id="games-select"
                    placeholder="Search games...">

                @foreach (var game in Model.Games)
                {
                    <option value="@game.Value">
                        @game.Text
                    </option>
                }

            </select>

        </div>

        <div class="rounded-2xl border border-default bg-white p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                Featured Image

            </h3>

            <select asp-for="FeaturedImageId"
                    id="featured-image-select"
                    class="w-full rounded-xl border border-default px-4 py-3">

                <option value="">
                    Select Image
                </option>

                @foreach (var media in Model.MediaItems)
                {
                    <option value="@media.Id"
                            data-image="@media.FilePath">

                        @media.FileName

                    </option>
                }

            </select>

            <div id="image-preview"
                 class="mt-4 overflow-hidden rounded-xl border bg-slate-50">

                <img id="preview-image"
                     class="hidden h-48 w-full object-cover" />

                <div id="preview-placeholder"
                     class="flex h-48 items-center justify-center text-sm text-gray-500">

                    No image selected

                </div>

            </div>
            <button type="button"
                    id="open-media-picker"
                    class="mt-4 w-full rounded-xl border px-4 py-3">

                Choose From Media Library

            </button>

        </div>
        <div class="rounded-2xl border border-default bg-white p-5">

            <div class="mb-4 flex items-center justify-between">

                <h3 class="text-sm font-bold uppercase tracking-wide">

                    Gallery Images

                </h3>

                <button type="button"
                        id="open-gallery-picker"
                        class="rounded-lg bg-primary px-3 py-2 text-sm text-black">

                    Add Images

                </button>

            </div>

            <div id="gallery-preview"
                 class="grid grid-cols-2 gap-3">

                @foreach (var image in Model.GalleryImages)
                {
                    <div class="overflow-hidden rounded-xl border">

                        <img src="@image.FilePath"
                             class="aspect-video w-full object-cover" />

                    </div>
                }

            </div>

        </div>
        <div id="gallery-hidden-inputs">
        </div>
        <div class="rounded-2xl border border-default bg-white p-5">

            <div class="mb-4 flex items-center justify-between">

                <h3 class="text-sm font-bold uppercase tracking-wide">

                    Videos

                </h3>

                <button type="button"
                        id="add-video-btn"
                        class="rounded-lg bg-primary px-3 py-2 text-sm text-white">

                    Add Video

                </button>

            </div>

            <div id="video-container">

                @for (var i = 0; i < Model.Videos.Count; i++)
                {
                    <div class="video-item mb-4 rounded-xl border p-4">

                        <input asp-for="Videos[i].Title"
                               class="mb-3 w-full rounded-lg border px-4 py-3" />

                        <input asp-for="Videos[i].VideoUrl"
                               class="w-full rounded-lg border px-4 py-3" />

                    </div>
                }

            </div>

        </div>
        <div class="rounded-2xl border border-default bg-white p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                SEO

            </h3>

            <input asp-for="SeoTitle"
                   placeholder="SEO Title"
                   class="mb-3 w-full rounded-xl border border-default px-4 py-3" />

            <textarea asp-for="SeoDescription"
                      rows="4"
                      placeholder="SEO Description"
                      class="w-full rounded-xl border border-default px-4 py-3">
            </textarea>

        </div>

    </aside>

</div>
<div id="media-picker-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-6xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-white p-6 shadow-2xl">

        <div class="mb-6 flex items-center justify-between">

            <h2 class="text-2xl font-bold">

                Media Library

            </h2>

            <button type="button"
                    id="close-media-picker">

                ✕

            </button>

        </div>

        <div class="mb-6 flex items-center justify-between">

            <input type="text"
                   id="media-search"
                   placeholder="Search media..."
                   class="w-full rounded-xl border px-4 py-3" />

            <a asp-area="Admin"
               asp-controller="Media"
               asp-action="Upload"
               target="_blank"
               class="ml-4 rounded-xl bg-primary px-4 py-3 text-black">

                Upload New

            </a>

        </div>

        <div id="media-grid"
             class="grid max-h-[600px] grid-cols-2 gap-4 overflow-y-auto md:grid-cols-4">

            @foreach (var media in Model.MediaItems)
            {
                <div class="media-item cursor-pointer overflow-hidden rounded-xl border-2 border-transparent transition hover:border-primary"
                     data-id="@media.Id"
                     data-image="@media.FilePath"
                     data-name="@media.FileName">

                    <img src="@media.FilePath"
                         class="aspect-video w-full object-cover" />

                    <div class="p-2 text-xs truncate">

                        @media.FileName

                    </div>

                </div>
            }

        </div>

    </div>

</div>
<div id="gallery-picker-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-6xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-white p-6 shadow-2xl">

        <div class="mb-6 flex items-center justify-between">

            <h2 class="text-2xl font-bold">

                Select Gallery Images

            </h2>

            <button type="button"
                    id="close-gallery-picker">

                ✕

            </button>

        </div>

        <div class="grid max-h-[600px] grid-cols-2 gap-4 overflow-y-auto md:grid-cols-4">

            @foreach (var media in Model.MediaItems)
            {
                <div class="gallery-media-item cursor-pointer overflow-hidden rounded-xl border-2 border-transparent transition hover:border-primary"
                     data-id="@media.Id"
                     data-image="@media.FilePath"
                     data-name="@media.FileName">

                    <img src="@media.FilePath"
                         class="aspect-video w-full object-cover" />

                    <div class="p-2 text-xs truncate">

                        @media.FileName

                    </div>

                </div>
            }

        </div>

        <div class="mt-6 flex justify-end">

            <button type="button"
                    id="done-gallery-selection"
                    class="rounded-xl bg-primary px-6 py-3 text-white">

                Done

            </button>

        </div>

    </div>

</div>
<div id="editor-media-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-6xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-white p-6 shadow-2xl">

        <div class="mb-6 flex items-center justify-between">

            <h2 class="text-2xl font-bold">

                Insert Image

            </h2>

            <button type="button"
                    onclick="document.getElementById('editor-media-modal').classList.add('hidden')">

                ✕

            </button>

        </div>

        <div class="grid max-h-[600px] grid-cols-2 gap-4 overflow-y-auto md:grid-cols-4">

            @foreach (var media in Model.MediaItems)
            {
                <div class="cursor-pointer overflow-hidden rounded-xl border hover:border-primary"
                     onclick="insertImageIntoEditor('@media.FilePath')">

                    <img src="@media.FilePath"
                         class="aspect-video w-full object-cover" />

                    <div class="p-2 text-xs truncate">

                        @media.FileName

                    </div>

                </div>
            }

        </div>

    </div>

</div>
<div id="video-insert-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-white p-6 shadow-2xl">

        <div class="mb-6 flex items-center justify-between">

            <h2 class="text-2xl font-bold">

                Insert YouTube Video

            </h2>

            <button type="button"
                    onclick="document.getElementById('video-insert-modal').classList.add('hidden')">

                ✕

            </button>

        </div>

        <input type="text"
               id="video-url-input"
               placeholder="https://www.youtube.com/watch?v=..."
               class="mb-6 w-full rounded-xl border px-4 py-3" />

        <div class="flex justify-end gap-3">

            <button type="button"
                    onclick="document.getElementById('video-insert-modal').classList.add('hidden')"
                    class="rounded-xl border px-4 py-3">

                Cancel

            </button>

            <button type="button"
                    onclick="insertVideoIntoEditor()"
                    class="rounded-xl bg-primary px-4 py-3 text-black">

                Insert Video

            </button>

        </div>

    </div>

</div>
<div id="tag-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-white p-6">

        <h2 class="mb-4 text-xl font-bold">

            Create Tag

        </h2>

        <input type="text"
               id="tag-name"
               placeholder="Tag Name"
               class="mb-4 w-full rounded-xl border px-4 py-3" />

        <div class="flex justify-end gap-3">

            <button type="button"
                    id="close-tag-modal"
                    class="rounded-xl border px-4 py-3">

                Cancel

            </button>

            <button type="button"
                    id="save-tag-btn"
                    class="rounded-xl bg-primary px-4 py-3 text-black">

                Save

            </button>

        </div>

    </div>

</div>
<div id="game-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-white p-6">

        <h2 class="mb-4 text-xl font-bold">

            Create Game

        </h2>

        <input type="text"
               id="game-name"
               placeholder="Game Name"
               class="mb-4 w-full rounded-xl border px-4 py-3" />

        <div class="flex justify-end gap-3">

            <button type="button"
                    id="close-game-modal"
                    class="rounded-xl border px-4 py-3">

                Cancel

            </button>

            <button type="button"
                    id="save-game-btn"
                    class="rounded-xl bg-primary px-4 py-3 text-black">

                Save

            </button>

        </div>

    </div>

</div>