@model TheGameVoice.Web.Areas.Admin.ViewModels.Articles.ArticleFormViewModel

<div class="grid grid-cols-1 gap-8 xl:grid-cols-[1fr_350px]">

    <!-- MAIN CONTENT -->

    <div class="space-y-6">

        <div class="rounded-2xl border bg-white p-6 shadow-sm">

        <div>

            <label class="mb-2 block text-sm font-semibold">
                Title
            </label>

            <input asp-for="Title"
                   class="w-full rounded-xl border border-default px-4 py-3" />

        </div>

        <div>

            <label class="mb-2 block text-sm font-semibold">
                Summary
            </label>

            <textarea asp-for="Summary"
                      rows="4"
                      class="w-full rounded-xl border border-default px-4 py-3">
            </textarea>

        </div>
        </div>

        <div class="rounded-2xl border bg-white p-6 shadow-sm">

            <label class="mb-3 block text-sm font-bold uppercase tracking-wide">

                Content

            </label>

            <textarea asp-for="Content"
                      id="editor">
    </textarea>

        </div>

    </div>

    <!-- SIDEBAR -->

    <aside class="space-y-6 xl:sticky xl:top-6 xl:self-start">

        <div class="rounded-2xl border border-default bg-white p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                Publishing

            </h3>

            <button type="submit"
                    class="w-full rounded-xl bg-primary px-4 py-3 text-white">

                Save Draft

            </button>

        </div>

        <div class="rounded-2xl border border-default bg-white p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                Category

            </h3>

            <select asp-for="CategoryId"
                    class="w-full rounded-xl border border-default px-4 py-3">

                <option value="">
                    Select Category
                </option>

                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Value">
                        @category.Text
                    </option>
                }

            </select>

        </div>

        <div class="rounded-2xl border border-default bg-white p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                Tags

            </h3>

            <select asp-for="SelectedTagIds"
                    multiple
                    id="tags-select"
                    placeholder="Search tags...">

                @foreach (var tag in Model.Tags)
                {
                    <option value="@tag.Value">
                        @tag.Text
                    </option>
                }

            </select>

        </div>

        <div class="rounded-2xl border border-default bg-white p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                Games

            </h3>
            <select asp-for="SelectedGameIds"
                    multiple
                    id="games-select"
                    placeholder="Search games...">

                @foreach (var game in Model.Games)
                {
                    <option value="@game.Value">
                        @game.Text
                    </option>
                }

            </select>

        </div>

        <div class="rounded-2xl border border-default bg-white p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                Featured Image

            </h3>

            <select asp-for="FeaturedImageId"
                    id="featured-image-select"
                    class="w-full rounded-xl border border-default px-4 py-3">

                <option value="">
                    Select Image
                </option>

                @foreach (var media in Model.MediaItems)
                {
                    <option value="@media.Id"
                            data-image="@media.FilePath">

                        @media.FileName

                    </option>
                }

            </select>

            <div id="image-preview"
                 class="mt-4 overflow-hidden rounded-xl border bg-slate-50">

                <img id="preview-image"
                     class="hidden h-48 w-full object-cover" />

                <div id="preview-placeholder"
                     class="flex h-48 items-center justify-center text-sm text-gray-500">

                    No image selected

                </div>

            </div>
            <button type="button"
                    id="open-media-picker"
                    class="mt-4 w-full rounded-xl border px-4 py-3">

                Choose From Media Library

            </button>

        </div>

        <div class="rounded-2xl border border-default bg-white p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                SEO

            </h3>

            <input asp-for="SeoTitle"
                   placeholder="SEO Title"
                   class="mb-3 w-full rounded-xl border border-default px-4 py-3" />

            <textarea asp-for="SeoDescription"
                      rows="4"
                      placeholder="SEO Description"
                      class="w-full rounded-xl border border-default px-4 py-3">
            </textarea>

        </div>

    </aside>

</div>
<div id="media-picker-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-6xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-white p-6 shadow-2xl">

        <div class="mb-6 flex items-center justify-between">

            <h2 class="text-2xl font-bold">

                Media Library

            </h2>

            <button type="button"
                    id="close-media-picker">

                ✕

            </button>

        </div>

        <div class="mb-6 flex items-center justify-between">

            <input type="text"
                   id="media-search"
                   placeholder="Search media..."
                   class="w-full rounded-xl border px-4 py-3" />

            <a asp-area="Admin"
               asp-controller="Media"
               asp-action="Upload"
               target="_blank"
               class="ml-4 rounded-xl bg-primary px-4 py-3 text-black">

                Upload New

            </a>

        </div>

        <div id="media-grid"
             class="grid max-h-[600px] grid-cols-2 gap-4 overflow-y-auto md:grid-cols-4">

            @foreach (var media in Model.MediaItems)
            {
                <div class="media-item cursor-pointer overflow-hidden rounded-xl border-2 border-transparent transition hover:border-primary"
                     data-id="@media.Id"
                     data-image="@media.FilePath"
                     data-name="@media.FileName">

                    <img src="@media.FilePath"
                         class="aspect-video w-full object-cover" />

                    <div class="p-2 text-xs truncate">

                        @media.FileName

                    </div>

                </div>
            }

        </div>

    </div>

</div>