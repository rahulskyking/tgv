@using TheGameVoice.Infrastructure.Identity
@model TheGameVoice.Web.Areas.Admin.ViewModels.Articles.ArticleFormViewModel

@if (!ViewData.ModelState.IsValid)
{
    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-5">

        <div class="mb-3 font-semibold text-red-700">

            Please fix the following errors:

        </div>

        <div asp-validation-summary="All"
             class="text-sm text-red-600">
        </div>

    </div>
}

<!-- STICKY ACTION BAR (always visible while editing) -->
<div class="sticky top-0 z-30 mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-line bg-surface/95 px-5 py-3 shadow-sm backdrop-blur">

    <div class="flex items-center gap-3">
        <span class="text-xs font-bold uppercase tracking-wide text-ink-muted">
            Status
        </span>
        <span class="rounded-full bg-surface-raised px-3 py-1 text-sm font-semibold text-ink">
            @Model.StatusDisplay
        </span>
    </div>

    <div class="flex items-center gap-3">

        <button type="submit"
                id="preview-button"
                formaction="@Url.Action("Preview", "Articles", new { area = "Admin" })"
                formmethod="post"
                formtarget="_blank"
                class="inline-flex items-center gap-2 rounded-xl border border-[#fa743e] px-4 py-2.5 font-semibold text-[#fa743e] transition hover:bg-[#fa743e] hover:text-white">

            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z" />
                <circle cx="12" cy="12" r="3" />
            </svg>

            Preview

        </button>

        <button type="submit"
                data-save-button
                class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 font-semibold text-black transition hover:bg-primary-hover">

            Save Draft

            <span class="text-xs font-normal opacity-70">Ctrl+S</span>

        </button>

    </div>

</div>

<!-- TABS -->
<div class="mb-6 flex gap-1 border-b border-line" role="tablist">

    <button type="button"
            data-tab="content"
            role="tab"
            aria-selected="true"
            class="tgv-form-tab tgv-form-tab--active">

        Content

    </button>

    <button type="button"
            data-tab="details"
            role="tab"
            aria-selected="false"
            class="tgv-form-tab">

        Details

    </button>

    <button type="button"
            data-tab="media"
            role="tab"
            aria-selected="false"
            class="tgv-form-tab">

        Media &amp; SEO

    </button>

</div>

<!-- TAB: CONTENT -->
<section data-tab-panel="content">

    <div class="space-y-6">

        <div class="rounded-2xl border bg-surface p-6 shadow-sm">

            <div>

                <label class="mb-2 block text-sm font-semibold">
                    Title
                </label>

                <input asp-for="Title"
                       class="w-full rounded-xl border border-default px-4 py-3" />

            </div>

            <div class="mt-4">

                <label class="mb-2 block text-sm font-semibold">
                    Summary
                </label>

                <textarea asp-for="Summary"
                          rows="4"
                          class="w-full rounded-xl border border-default px-4 py-3">
                </textarea>

            </div>

        </div>

        <div class="rounded-2xl border bg-surface p-6 shadow-sm">

            <label class="mb-3 block text-sm font-bold uppercase tracking-wide">

                Content

            </label>

            <textarea asp-for="Content"
                      id="editor">
            </textarea>

        </div>

        <partial name="Components/_ReviewEditor"
                 model="Model" />

    </div>

    <!-- Tab footer -->
    <div class="mt-6 flex justify-end">

        <button type="button"
                data-goto-tab="details"
                class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 font-semibold text-black transition hover:bg-primary-hover">

            Next: Details

            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" />
            </svg>

        </button>

    </div>

</section>

<!-- TAB: DETAILS -->
<section data-tab-panel="details" class="hidden">

    <div class="grid gap-6 md:grid-cols-2">

        <div class="rounded-2xl border border-default bg-surface p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                Category

            </h3>

            <select asp-for="CategoryId"
                    class="w-full rounded-xl border border-default px-4 py-3">

                <option value="">
                    Select Category
                </option>

                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Value">
                        @category.Text
                    </option>
                }

            </select>

            <span asp-validation-for="CategoryId"
                  class="mt-2 block text-xs text-red-600">
            </span>

        </div>

        <div class="rounded-2xl border border-default bg-surface p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                Author

            </h3>

            @if (User.IsInRole(Roles.Author))
            {
                <input asp-for="AuthorId"
                       type="hidden" />

                <div class="rounded-xl bg-surface-raised px-4 py-3">

                    @Model.Authors
                    .FirstOrDefault(
                    x => x.Value ==
                    Model.AuthorId.ToString())
                    ?.Text

                </div>
            }
            else
            {
                <select asp-for="AuthorId"
                        class="w-full rounded-xl border border-default px-4 py-3">

                    @foreach (var author in Model.Authors)
                    {
                        <option value="@author.Value">
                            @author.Text
                        </option>
                    }

                </select>
            }

        </div>

        <div class="rounded-2xl border border-default bg-surface p-5">

            <h3 class="mb-2 text-sm font-bold uppercase tracking-wide">

                Section

            </h3>

            <p class="mb-3 text-xs text-ink-muted">

                Where this article appears on the site. Tick both if it is
                relevant to PC / console and mobile players.

            </p>

            <label class="mb-2 flex items-center gap-3 rounded-xl border border-default px-4 py-3">

                <input asp-for="IsPcConsole"
                       class="h-4 w-4" />

                <span class="text-sm font-semibold">
                    PC / Console games
                </span>

            </label>

            <label class="flex items-center gap-3 rounded-xl border border-default px-4 py-3">

                <input asp-for="IsMobile"
                       class="h-4 w-4" />

                <span class="text-sm font-semibold">
                    Mobile games
                </span>

            </label>

            <span asp-validation-for="IsPcConsole"
                  class="mt-2 block text-xs text-red-600">
            </span>

        </div>

        <div class="rounded-2xl border border-default bg-surface p-5">

            <div class="mb-4 flex items-center justify-between">

                <h3 class="text-sm font-bold uppercase tracking-wide">
                    Tags
                </h3>

                <button type="button"
                        id="open-tag-modal"
                        class="rounded-lg bg-primary px-3 py-2 text-xs text-black">

                    + Add

                </button>

            </div>

            <select asp-for="SelectedTagIds"
                    multiple
                    id="tags-select"
                    placeholder="Search tags...">

                @foreach (var tag in Model.Tags)
                {
                    <option value="@tag.Value">
                        @tag.Text
                    </option>
                }

            </select>

        </div>

        <div class="rounded-2xl border border-default bg-surface p-5 md:col-span-2">

            <div class="mb-4 flex items-center justify-between">

                <h3 class="text-sm font-bold uppercase tracking-wide">
                    Games
                </h3>

                <button type="button"
                        id="open-game-modal"
                        class="rounded-lg bg-primary px-3 py-2 text-xs text-black">

                    + Add

                </button>

            </div>

            <select asp-for="SelectedGameIds"
                    multiple
                    id="games-select"
                    placeholder="Search games...">

                @foreach (var game in Model.Games)
                {
                    <option value="@game.Value">
                        @game.Text
                    </option>
                }

            </select>

        </div>

    </div>

    <!-- Tab footer -->
    <div class="mt-6 flex items-center justify-between">

        <button type="button"
                data-goto-tab="content"
                class="inline-flex items-center gap-2 rounded-xl border border-line px-5 py-3 font-semibold text-ink transition hover:bg-surface-muted">

            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M11 19l-7-7 7-7" />
            </svg>

            Back

        </button>

        <button type="button"
                data-goto-tab="media"
                class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 font-semibold text-black transition hover:bg-primary-hover">

            Next: Media &amp; SEO

            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" />
            </svg>

        </button>

    </div>

</section>

<!-- TAB: MEDIA & SEO -->
<section data-tab-panel="media" class="hidden">

    <div class="grid gap-6 lg:grid-cols-2">

        <div class="rounded-2xl border border-default bg-surface p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                Featured Image

            </h3>

            <select asp-for="FeaturedImageId"
                    id="featured-image-select"
                    class="w-full rounded-xl border border-default px-4 py-3">

                <option value="">
                    Select Image
                </option>

                @foreach (var media in Model.MediaItems)
                {
                    <option value="@media.Id"
                            data-image="@media.FilePath">

                        @media.FileName

                    </option>
                }

            </select>

            <div id="image-preview"
                 class="mt-4 overflow-hidden rounded-xl border bg-surface-muted">

                <img id="preview-image"
                     class="hidden h-48 w-full object-cover" />

                <div id="preview-placeholder"
                     class="flex h-48 items-center justify-center text-sm text-ink-muted">

                    No image selected

                </div>

            </div>

            <button type="button"
                    id="open-media-picker"
                    class="mt-4 w-full rounded-xl border px-4 py-3">

                Choose From Media Library

            </button>

        </div>

        <div class="rounded-2xl border border-default bg-surface p-5">

            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide">

                SEO

            </h3>

            <label class="mb-2 block text-xs font-semibold text-ink-muted">
                SEO Title
            </label>

            <input asp-for="SeoTitle"
                   placeholder="SEO Title"
                   class="mb-3 w-full rounded-xl border border-default px-4 py-3" />

            <p class="text-xs text-ink-muted">
                If left blank, the article title is used for SEO and sharing.
            </p>

        </div>

    </div>

    <!-- Tab footer -->
    <div class="mt-6 flex items-center justify-between">

        <button type="button"
                data-goto-tab="details"
                class="inline-flex items-center gap-2 rounded-xl border border-line px-5 py-3 font-semibold text-ink transition hover:bg-surface-muted">

            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M11 19l-7-7 7-7" />
            </svg>

            Back

        </button>

        <button type="submit"
                data-save-button
                class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 font-semibold text-black transition hover:bg-primary-hover">

            Save Draft

            <span class="text-xs font-normal opacity-70">Ctrl+S</span>

        </button>

    </div>

</section>

<div id="media-picker-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-6xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-surface p-6 shadow-2xl">

        <div class="mb-6 flex items-center justify-between">

            <h2 class="text-2xl font-bold">

                Media Library

            </h2>

            <button type="button"
                    id="close-media-picker">

                ✕

            </button>

        </div>

        <div class="mb-6 flex items-center justify-between">

            <input type="text"
                   id="media-search"
                   placeholder="Search media..."
                   class="w-full rounded-xl border px-4 py-3" />

            <input type="file"
                   id="inline-media-file"
                   multiple
                   accept="image/jpeg,image/png,image/webp"
                   class="hidden" />

            <button type="button"
                    id="inline-media-upload-btn"
                    class="ml-4 shrink-0 rounded-xl bg-primary px-4 py-3 text-black">

                Upload New

            </button>

        </div>

        <p id="inline-media-status"
           class="mb-4 hidden text-sm">
        </p>

        <div id="media-grid"
             class="grid max-h-[600px] grid-cols-2 gap-4 overflow-y-auto md:grid-cols-4">

            @foreach (var media in Model.MediaItems)
            {
                <div class="media-item cursor-pointer overflow-hidden rounded-xl border-2 border-transparent transition hover:border-primary"
                     data-id="@media.Id"
                     data-image="@media.FilePath"
                     data-name="@media.FileName">

                    <img src="@media.FilePath"
                         class="aspect-video w-full object-cover" />

                    <div class="p-2 text-xs truncate">

                        @media.FileName

                    </div>

                </div>
            }

        </div>

    </div>

</div>
<div id="gallery-picker-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-6xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-surface p-6 shadow-2xl">

        <div class="mb-6 flex items-center justify-between">

            <h2 class="text-2xl font-bold">

                Select Gallery Images

            </h2>

            <button type="button"
                    id="close-gallery-picker">

                ✕

            </button>

        </div>

        <div id="gallery-media-grid"
             class="grid max-h-[600px] grid-cols-2 gap-4 overflow-y-auto md:grid-cols-4">

            @foreach (var media in Model.MediaItems)
            {
                <div class="gallery-media-item cursor-pointer overflow-hidden rounded-xl border-2 border-transparent transition hover:border-primary"
                     data-id="@media.Id"
                     data-image="@media.FilePath"
                     data-name="@media.FileName">

                    <img src="@media.FilePath"
                         class="aspect-video w-full object-cover" />

                    <div class="p-2 text-xs truncate">

                        @media.FileName

                    </div>

                </div>
            }

        </div>

        <div class="mt-6 flex justify-end">

            <button type="button"
                    id="done-gallery-selection"
                    class="rounded-xl bg-primary px-6 py-3 text-white">

                Done

            </button>

        </div>

    </div>

</div>
<div id="editor-media-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-6xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-surface p-6 shadow-2xl">

        <div class="mb-6 flex items-center justify-between">

            <h2 class="text-2xl font-bold">

                Insert Image

            </h2>

            <button type="button"
                    onclick="document.getElementById('editor-media-modal').classList.add('hidden')">

                ✕

            </button>

        </div>

        <div class="mb-6 flex items-center justify-between">

            <input type="text"
                   id="editor-media-search"
                   placeholder="Search media..."
                   class="w-full rounded-xl border px-4 py-3" />

            <input type="file"
                   id="editor-media-file"
                   multiple
                   accept="image/jpeg,image/png,image/webp"
                   class="hidden" />

            <button type="button"
                    id="editor-media-upload-btn"
                    class="ml-4 shrink-0 rounded-xl bg-primary px-4 py-3 text-black">

                Upload New

            </button>

        </div>

        <p id="editor-media-status"
           class="mb-4 hidden text-sm">
        </p>

        <div id="editor-media-grid"
             class="grid max-h-[600px] grid-cols-2 gap-4 overflow-y-auto md:grid-cols-4">

            @foreach (var media in Model.MediaItems)
            {
                <div class="cursor-pointer overflow-hidden rounded-xl border hover:border-primary"
                     data-name="@media.FileName"
                     onclick="insertImageIntoEditor('@media.FilePath')">

                    <img src="@media.FilePath"
                         class="aspect-video w-full object-cover" />

                    <div class="p-2 text-xs truncate">

                        @media.FileName

                    </div>

                </div>
            }

        </div>

    </div>

</div>
<div id="video-insert-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-surface p-6 shadow-2xl">

        <div class="mb-6 flex items-center justify-between">

            <h2 class="text-2xl font-bold">

                Insert YouTube Video

            </h2>

            <button type="button"
                    onclick="document.getElementById('video-insert-modal').classList.add('hidden')">

                ✕

            </button>

        </div>

        <input type="text"
               id="video-url-input"
               placeholder="https://www.youtube.com/watch?v=..."
               class="mb-6 w-full rounded-xl border px-4 py-3" />

        <div class="flex justify-end gap-3">

            <button type="button"
                    onclick="document.getElementById('video-insert-modal').classList.add('hidden')"
                    class="rounded-xl border px-4 py-3">

                Cancel

            </button>

            <button type="button"
                    onclick="insertVideoIntoEditor()"
                    class="rounded-xl bg-primary px-4 py-3 text-black">

                Insert Video

            </button>

        </div>

    </div>

</div>
<div id="tag-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-surface p-6">

        <h2 class="mb-4 text-xl font-bold">

            Create Tag

        </h2>

        <input type="text"
               id="tag-name"
               placeholder="Tag Name"
               class="mb-4 w-full rounded-xl border px-4 py-3" />

        <div class="flex justify-end gap-3">

            <button type="button"
                    id="close-tag-modal"
                    class="rounded-xl border px-4 py-3">

                Cancel

            </button>

            <button type="button"
                    id="save-tag-btn"
                    class="rounded-xl bg-primary px-4 py-3 text-black">

                Save

            </button>

        </div>

    </div>

</div>
<div id="game-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-surface p-6">

        <h2 class="mb-4 text-xl font-bold">

            Create Game

        </h2>

        <input type="text"
               id="game-name"
               placeholder="Game Name"
               class="mb-4 w-full rounded-xl border px-4 py-3" />

        <div class="flex justify-end gap-3">

            <button type="button"
                    id="close-game-modal"
                    class="rounded-xl border px-4 py-3">

                Cancel

            </button>

            <button type="button"
                    id="save-game-btn"
                    class="rounded-xl bg-primary px-4 py-3 text-black">

                Save

            </button>

        </div>

    </div>

</div>

<script>
    // Tab switching for the article form.
    document.addEventListener("DOMContentLoaded", function () {
        var tabs = document.querySelectorAll("[data-tab]");
        var panels = document.querySelectorAll("[data-tab-panel]");

        function activate(name) {
            tabs.forEach(function (t) {
                var on = t.getAttribute("data-tab") === name;
                t.classList.toggle("tgv-form-tab--active", on);
                t.setAttribute("aria-selected", on ? "true" : "false");
            });

            panels.forEach(function (p) {
                var on = p.getAttribute("data-tab-panel") === name;
                p.classList.toggle("hidden", !on);
            });

            // Jump to the top of the form so the user lands on the tab
            // header, not mid-content.
            var stickyBar = document.querySelector(".sticky.top-0");
            if (stickyBar) {
                stickyBar.scrollIntoView({ behavior: "smooth", block: "start" });
            }
        }

        tabs.forEach(function (t) {
            t.addEventListener("click", function () {
                activate(t.getAttribute("data-tab"));
            });
        });

        // "Next" / "Back" buttons inside each tab footer.
        document.querySelectorAll("[data-goto-tab]").forEach(function (btn) {
            btn.addEventListener("click", function () {
                activate(btn.getAttribute("data-goto-tab"));
            });
        });
    });

    // Ensure TinyMCE pushes its content into the textarea before the
    // preview form submits to a new tab.
    document.getElementById("preview-button")
        ?.addEventListener("click", function () {
            if (window.tinymce) {
                window.tinymce.triggerSave();
            }
        });
</script>
