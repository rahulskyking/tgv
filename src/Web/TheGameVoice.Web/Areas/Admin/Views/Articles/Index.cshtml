@using TheGameVoice.Domain.Enums
@using TheGameVoice.Domain.Common.Extensions
@using TheGameVoice.Infrastructure.Identity
@using TheGameVoice.Application.Modules.Articles.Filters
@model TheGameVoice.Web.Areas.Admin.ViewModels.Articles.ArticleIndexViewModel

@{
    // Keeps every other active filter when a tab or a column header is clicked.
    Dictionary<string, string> RouteWith(
        ArticleStatus? status = null,
        ArticleSort? sort = null,
        bool keepStatus = true)
    {
        var route = new Dictionary<string, string>();

        var effectiveStatus = status ?? (keepStatus ? Model.Filter.Status : null);

        if (effectiveStatus.HasValue)
        {
            route["Filter.Status"] = ((int)effectiveStatus.Value).ToString();
        }

        if (!string.IsNullOrWhiteSpace(Model.Filter.Search))
        {
            route["Filter.Search"] = Model.Filter.Search;
        }

        if (Model.Filter.Segment.HasValue)
        {
            route["Filter.Segment"] = ((int)Model.Filter.Segment.Value).ToString();
        }

        if (Model.Filter.CategoryId.HasValue)
        {
            route["Filter.CategoryId"] = Model.Filter.CategoryId.Value.ToString();
        }

        if (Model.Filter.AuthorId.HasValue)
        {
            route["Filter.AuthorId"] = Model.Filter.AuthorId.Value.ToString();
        }

        route["Filter.SortBy"] = ((int)(sort ?? Model.Filter.SortBy)).ToString();

        return route;
    }
}

<div class="space-y-6">

    <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

        <div>

            <h1 class="text-fluid-3xl font-bold text-ink">

                Articles

            </h1>

            <p class="mt-1 text-sm text-ink-muted">

                Manage articles, reviews and editorial workflow.

            </p>

        </div>

        <a asp-action="Create"
           class="inline-flex items-center gap-2 rounded-xl bg-[#fa743e] px-5 py-3 font-semibold text-white transition hover:bg-[#e56734]">

            <i data-lucide="plus" class="h-5 w-5"></i>

            <span>New Article</span>

        </a>

    </div>

    <!-- Summary: article counts and view totals for the current filter -->
    <div class="mb-6 grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-5">

        <div class="rounded-2xl border border-line bg-surface p-4 shadow-sm">

            <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">
                Total Articles
            </p>

            <p class="mt-1.5 text-2xl font-bold text-ink">
                @Model.Summary.TotalArticles.ToString("N0")
            </p>

        </div>

        <div class="rounded-2xl border border-line bg-surface p-4 shadow-sm">

            <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">
                Published
            </p>

            <p class="mt-1.5 text-2xl font-bold text-green-600">
                @Model.Summary.PublishedArticles.ToString("N0")
            </p>

        </div>

        <div class="rounded-2xl border border-line bg-surface p-4 shadow-sm">

            <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">
                In Review / Draft
            </p>

            <p class="mt-1.5 text-2xl font-bold text-amber-600">
                @Model.Summary.ReviewPendingArticles.ToString("N0")
                <span class="text-base font-medium text-ink-faint">
                    / @Model.Summary.DraftArticles.ToString("N0")
                </span>
            </p>

        </div>

        <div class="rounded-2xl border border-line bg-surface p-4 shadow-sm">

            <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">
                Total Views
            </p>

            <p class="mt-1.5 text-2xl font-bold text-[#fa743e]">
                @Model.Summary.TotalViews.ToString("N0")
            </p>

        </div>

        <div class="rounded-2xl border border-line bg-surface p-4 shadow-sm">

            <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">
                Avg Views / Published
            </p>

            <p class="mt-1.5 text-2xl font-bold text-ink">
                @Model.Summary.AverageViewsPerPublishedArticle.ToString("N0")
            </p>

        </div>

    </div>

    <!-- Quick status tabs: the three filters most people use every day -->

    <div class="mb-5 flex flex-wrap items-center gap-2">

        @{
            var tabs = new (string Label, ArticleStatus? Status, int Count)[]
            {
                ("All", null, Model.Summary.TotalArticles),
                ("Drafts", ArticleStatus.Draft, Model.Summary.DraftArticles),
                ("In review", ArticleStatus.ReviewPending, Model.Summary.ReviewPendingArticles),
                ("Scheduled", ArticleStatus.Scheduled, Model.Summary.ScheduledArticles),
                ("Published", ArticleStatus.Published, Model.Summary.PublishedArticles),
                ("Rejected", ArticleStatus.Rejected, Model.Summary.RejectedArticles),
                ("Archived", ArticleStatus.Archived, Model.Summary.ArchivedArticles)
            };
        }

        @foreach (var tab in tabs)
        {
            var isActive = Model.Filter.Status == tab.Status;

            <a asp-action="Index"
               asp-all-route-data="RouteWith(status: tab.Status, keepStatus: false)"
               class="tgv-tab @(isActive ? "is-active" : string.Empty)">

                @tab.Label

                <span class="tgv-tab__count">@tab.Count.ToString("N0")</span>

            </a>
        }

    </div>

    <div class="mb-6 rounded-2xl border border-default bg-surface p-5 shadow-sm">

        <form method="get">

            <div class="flex flex-wrap items-end gap-4">

                <!-- Search -->

                <div class="min-w-[300px] flex-1">

                    <label class="mb-2 block text-sm font-medium">

                        Search

                    </label>

                    <input asp-for="Filter.Search"
                           placeholder="Search articles..."
                           class="w-full rounded-xl border border-default px-4 py-3" />

                </div>

                <!-- Status -->

                <div class="w-44">

                    <label class="mb-2 block text-sm font-medium">

                        Status

                    </label>

                    <select asp-for="Filter.Status"
                            asp-items="Model.Statuses"
                            class="w-full rounded-xl border border-default px-4 py-3">

                        <option value="">All Status</option>

                    </select>

                </div>

                <!-- Section (PC / Console vs Mobile) -->

                <div class="w-52">

                    <label class="mb-2 block text-sm font-medium">

                        Section

                    </label>

                    <select asp-for="Filter.Segment"
                            asp-items="Model.Segments"
                            class="w-full rounded-xl border border-default px-4 py-3">

                        <option value="">All Sections</option>

                    </select>

                </div>

                <!-- Category -->

                <div class="w-52">

                    <label class="mb-2 block text-sm font-medium">

                        Category

                    </label>

                    <select asp-for="Filter.CategoryId"
                            asp-items="Model.Categories"
                            class="w-full rounded-xl border border-default px-4 py-3">

                        <option value="">All Categories</option>

                    </select>

                </div>

                @if (!User.IsInRole(Roles.Author))
                {
                    <div class="w-52">

                        <label class="mb-2 block text-sm font-medium">

                            Author

                        </label>

                        <select asp-for="Filter.AuthorId"
                                asp-items="Model.Authors"
                                class="w-full rounded-xl border border-default px-4 py-3">

                            <option value="">All Authors</option>

                        </select>

                    </div>
                }

                <!-- Sort -->

                <div class="w-44">

                    <label class="mb-2 block text-sm font-medium">

                        Sort

                    </label>

                    <select asp-for="Filter.SortBy"
                            asp-items="Model.SortOptions"
                            class="w-full rounded-xl border border-default px-4 py-3">
                    </select>

                </div>

                <!-- Buttons -->

                <div class="ml-auto flex gap-2">

                    <a asp-action="Index"
                       class="rounded-xl border border-default px-5 py-3">

                        Reset

                    </a>

                    <button class="rounded-xl bg-primary px-6 py-3 font-semibold text-white">

                        Apply

                    </button>

                </div>

            </div>

        </form>

    </div>
    <div class="rounded-xl bg-surface shadow-sm">

        <table class="min-w-full">

            <thead class="border-b bg-surface-muted">

                <tr>

                    <th class="px-4 py-4 text-left">
                        <input type="checkbox"
                               data-bulk-master
                               class="h-4 w-4 rounded border-line-strong"
                               aria-label="Select all articles on this page" />
                    </th>

                    <th class="px-6 py-4 text-left">
                        Thumbnail
                    </th>
                    <th class="px-6 py-4 text-left">
                        @{
                            var titleSorted = Model.Filter.SortBy == ArticleSort.Title;
                        }
                        <a asp-action="Index"
                           asp-all-route-data="RouteWith(sort: ArticleSort.Title)"
                           class="tgv-sort">
                            Title
                            @if (titleSorted)
                            {
                                <span class="tgv-sort__arrow">&#9650;</span>
                            }
                        </a>
                    </th>
                    <th class="px-6 py-4 text-left">
                        Author
                    </th>
                    <th class="px-6 py-4 text-left">
                        Category
                    </th>
                    <th class="px-6 py-4 text-left">
                        Section
                    </th>
                    <th class="px-6 py-4 text-left">
                        Status
                    </th>

                    <th class="px-6 py-4 text-left">
                        @{
                            var newestSorted = Model.Filter.SortBy == ArticleSort.Latest;
                        }
                        <a asp-action="Index"
                           asp-all-route-data="RouteWith(sort: newestSorted ? ArticleSort.Oldest : ArticleSort.Latest)"
                           class="tgv-sort">
                            Created
                            @if (newestSorted)
                            {
                                <span class="tgv-sort__arrow">&#9660;</span>
                            }
                            else if (Model.Filter.SortBy == ArticleSort.Oldest)
                            {
                                <span class="tgv-sort__arrow">&#9650;</span>
                            }
                        </a>
                    </th>

                    <th class="px-6 py-4 text-left">
                        <a asp-action="Index"
                           asp-all-route-data="RouteWith(sort: ArticleSort.Updated)"
                           class="tgv-sort">
                            Published
                            @if (Model.Filter.SortBy == ArticleSort.Updated)
                            {
                                <span class="tgv-sort__arrow">&#9660;</span>
                            }
                        </a>
                    </th>

                    <th class="px-6 py-4 text-right">
                        <a asp-action="Index"
                           asp-all-route-data="RouteWith(sort: ArticleSort.MostViewed)"
                           class="tgv-sort">
                            Views
                            @if (Model.Filter.SortBy == ArticleSort.MostViewed)
                            {
                                <span class="tgv-sort__arrow">&#9660;</span>
                            }
                        </a>
                    </th>

                    <th class="px-6 py-4 text-left">
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var article in Model.Articles.Items)
                {
                    <tr class="border-b">

                        <td class="px-4 py-4">
                            <input type="checkbox"
                                   data-bulk-item
                                   value="@article.Id"
                                   class="h-4 w-4 rounded border-line-strong"
                                   aria-label="Select @article.Title" />
                        </td>
                        <td class="px-6 py-4">

                            @if (article.FeaturedImage != null)
                            {
                                <img src="@article.FeaturedImage.FilePath"
                                     class="h-16 w-24 rounded-lg object-cover" />
                            }

                        </td>
                        <td class="px-6 py-4">
                            @article.Title
                        </td>
                    <td class="px-6 py-4 text-ink-mid">

                        @{
                            var authorName =
                                Model.AuthorNames.TryGetValue(article.AuthorId, out var author)
                                    ? author
                                    : "Unknown";
                        }

                        @if (Model.CanViewAuthorStats)
                        {
                            <a asp-area="Admin"
                               asp-controller="Dashboard"
                               asp-action="Author"
                               asp-route-id="@article.AuthorId"
                               class="font-medium text-ink-soft underline-offset-2 hover:text-[#fa743e] hover:underline"
                               title="View author statistics">
                                @authorName
                            </a>
                        }
                        else
                        {
                            @authorName
                        }

                    </td>
                        <td class="px-6 py-4">
                            @article.Category.Name
                        </td>
                        <td class="px-6 py-4">

                            @if (article.Segment.Includes(GameSegment.PcConsole))
                            {
                                <span class="mr-1 inline-block rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-semibold text-indigo-800">
                                    PC / Console
                                </span>
                            }

                            @if (article.Segment.Includes(GameSegment.Mobile))
                            {
                                <span class="inline-block rounded-full bg-teal-100 px-2.5 py-0.5 text-xs font-semibold text-teal-800">
                                    Mobile
                                </span>
                            }

                        </td>
                        <td class="px-6 py-4">

                            @{
                                var badgeClass =
                                article.Status switch
                                {
                                    ArticleStatus.Draft =>
                                                    "bg-surface-raised text-ink-soft",

                                    ArticleStatus.ReviewPending =>
                                                    "bg-amber-100 text-amber-800",

                                    ArticleStatus.Published =>
                                                    "bg-green-100 text-green-800",

                                    ArticleStatus.Rejected =>
                                                    "bg-red-100 text-red-800",

                                    ArticleStatus.Archived =>
                                                    "bg-line text-ink-soft",
                                    ArticleStatus.Scheduled =>
                                                    "bg-blue-100 text-blue-800",

                                    _ =>
                                                    "bg-surface-raised text-ink-soft"
                                };

                                var displayStatus =
                                article.Status switch
                                {
                                    ArticleStatus.ReviewPending =>
                                                    "In Review",

                                    ArticleStatus.Scheduled =>
                                                    "Scheduled",

                                    _ =>
                                                    article.Status.ToString()
                                };
                            }

                            <span class="rounded-full px-3 py-1 text-sm font-medium @badgeClass">
                                @displayStatus
                            </span>

                        </td>

                        @{
                            var indiaTimeZone = TimeZoneInfo.FindSystemTimeZoneById(
                            OperatingSystem.IsWindows()
                            ? "India Standard Time"
                            : "Asia/Kolkata");
                        }

                        <!-- Created At -->
                        <td class="px-6 py-4">

                            @{
                                var createdUtc = DateTime.SpecifyKind(
                                article.CreatedAt,
                                DateTimeKind.Utc);

                                var createdIndiaTime =
                                TimeZoneInfo.ConvertTimeFromUtc(
                                createdUtc,
                                indiaTimeZone);
                            }

                            @createdIndiaTime.ToString("dd MMM yyyy hh:mm tt")

                        </td>


                        <!-- Published / Scheduled At -->
                        <td class="px-6 py-4">

                            @if (article.Status == ArticleStatus.Scheduled &&
                                                    article.ScheduledPublishAt.HasValue)
                            {
                                var scheduledUtc = DateTime.SpecifyKind(
                                article.ScheduledPublishAt.Value,
                                DateTimeKind.Utc);

                                var scheduledIndiaTime =
                                TimeZoneInfo.ConvertTimeFromUtc(
                                scheduledUtc,
                                indiaTimeZone);

                                <span class="font-medium text-blue-600">
                                    @scheduledIndiaTime.ToString("dd MMM yyyy hh:mm tt")
                                </span>
                            }
                            else if (article.PublishedAt.HasValue)
                            {
                                var publishedUtc = DateTime.SpecifyKind(
                                article.PublishedAt.Value,
                                DateTimeKind.Utc);

                                var publishedIndiaTime =
                                TimeZoneInfo.ConvertTimeFromUtc(
                                publishedUtc,
                                indiaTimeZone);

                                <span>
                                    @publishedIndiaTime.ToString("dd MMM yyyy hh:mm tt")
                                </span>
                            }
                            else
                            {
                                <span class="text-ink-faint">-</span>
                            }

                        </td>

                        <!-- Views -->
                        <td class="whitespace-nowrap px-6 py-4 text-right">

                            <span class="inline-flex items-center gap-1.5 text-sm font-semibold tabular-nums text-ink-soft"
                                  title="Total views for this article">

                                <i data-lucide="eye" class="h-4 w-4 text-ink-faint"></i>

                                @article.ViewCount.ToString("N0")

                            </span>

                        </td>

                        <td class="px-6 py-4">

                            <partial name="_ArticleActions"
                                     model="article" />

                        </td>

                    </tr>
                }

            </tbody>

        </table>
        <div class="mt-6 flex items-center justify-between text-sm text-ink-muted">

            <span>

                Total Articles:
                <strong>@Model.Articles.TotalCount</strong>

            </span>

            @if (Model.Articles.HasMultiplePages)
            {
                <div class="mt-8 flex items-center justify-between">

                    <div class="text-sm text-ink-muted">

                        Showing
                        <strong>@Model.Articles.StartItem</strong>
                        -
                        <strong>@Model.Articles.EndItem</strong>
                        of
                        <strong>@Model.Articles.TotalCount</strong>

                    </div>

                    <div class="flex items-center gap-2">

                        @if (Model.Articles.HasPreviousPage)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.Articles.CurrentPage - 1)"
                               asp-route-search="@Model.Filter.Search"
                               asp-route-status="@Model.Filter.Status"
                               asp-route-segment="@Model.Filter.Segment"
                               asp-route-categoryId="@Model.Filter.CategoryId"
                               asp-route-authorId="@Model.Filter.AuthorId"
                               asp-route-sortBy="@Model.Filter.SortBy"
                               class="rounded-lg border border-default px-4 py-2 hover:bg-surface-muted">

                                ← Previous

                            </a>
                        }

                        @{
                            var start = Math.Max(1, Model.Articles.CurrentPage - 2);
                            var end = Math.Min(Model.Articles.TotalPages, Model.Articles.CurrentPage + 2);
                        }

                        @if (start > 1)
                        {
                            <a asp-action="Index"
                               asp-route-page="1"
                               asp-route-search="@Model.Filter.Search"
                               asp-route-status="@Model.Filter.Status"
                               asp-route-segment="@Model.Filter.Segment"
                               asp-route-categoryId="@Model.Filter.CategoryId"
                               asp-route-authorId="@Model.Filter.AuthorId"
                               asp-route-sortBy="@Model.Filter.SortBy"
                               class="rounded-lg border border-default px-4 py-2">

                                1

                            </a>

                            @if (start > 2)
                            {
                                <span class="px-2">...</span>
                            }
                        }

                        @for (var i = start; i <= end; i++)
                        {
                            if (i == Model.Articles.CurrentPage)
                            {
                                <span class="rounded-lg bg-primary px-4 py-2 font-semibold text-white">

                                    @i

                                </span>
                            }
                            else
                            {
                                <a asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-search="@Model.Filter.Search"
                                   asp-route-status="@Model.Filter.Status"
                               asp-route-segment="@Model.Filter.Segment"
                                   asp-route-categoryId="@Model.Filter.CategoryId"
                                   asp-route-authorId="@Model.Filter.AuthorId"
                                   asp-route-sortBy="@Model.Filter.SortBy"
                                   class="rounded-lg border border-default px-4 py-2 hover:bg-surface-muted">

                                    @i

                                </a>
                            }
                        }

                        @if (end < Model.Articles.TotalPages)
                        {
                            @if (end < Model.Articles.TotalPages - 1)
                            {
                                <span class="px-2">...</span>
                            }

                            <a asp-action="Index"
                               asp-route-page="@Model.Articles.TotalPages"
                               asp-route-search="@Model.Filter.Search"
                               asp-route-status="@Model.Filter.Status"
                               asp-route-segment="@Model.Filter.Segment"
                               asp-route-categoryId="@Model.Filter.CategoryId"
                               asp-route-authorId="@Model.Filter.AuthorId"
                               asp-route-sortBy="@Model.Filter.SortBy"
                               class="rounded-lg border border-default px-4 py-2">

                                @Model.Articles.TotalPages

                            </a>
                        }

                        @if (Model.Articles.HasNextPage)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.Articles.CurrentPage + 1)"
                               asp-route-search="@Model.Filter.Search"
                               asp-route-status="@Model.Filter.Status"
                               asp-route-segment="@Model.Filter.Segment"
                               asp-route-categoryId="@Model.Filter.CategoryId"
                               asp-route-authorId="@Model.Filter.AuthorId"
                               asp-route-sortBy="@Model.Filter.SortBy"
                               class="rounded-lg border border-default px-4 py-2 hover:bg-surface-muted">

                                Next →

                            </a>
                        }

                    </div>

                </div>
            }

        </div>
    </div>
    <div id="scheduleModal"
         class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">

        <div class="w-full max-w-md rounded-2xl bg-surface p-6">

            <h2 class="mb-5 text-xl font-bold">

                Schedule Publication

            </h2>

            <form asp-action="Schedule"
                  method="post">

                @Html.AntiForgeryToken()
                <input id="scheduleArticleId"
                       type="hidden"
                       name="id" />

                <label class="mb-2 block">

                    Publish Date & Time

                </label>

                <input id="scheduledPublishAt"
                       name="scheduledPublishAt"
                       type="datetime-local"
                       class="w-full rounded-xl border border-default px-4 py-3"
                       required />

                <div class="flex justify-end gap-3">

                    <button id="closeScheduleModal"
                            type="button"
                            class="rounded-lg p-2 hover:bg-surface-raised">

                        <i data-lucide="x"
                           class="h-5 w-5"></i>

                    </button>

                    <button type="submit"
                            class="rounded-lg bg-[#fa743e] px-5 py-2 text-white">

                        Schedule

                    </button>

                </div>

            </form>

        </div>

    </div>

    <!-- BULK ACTION BAR (appears when rows are selected) -->

    <form method="post"
          asp-action="BulkAction"
          class="tgv-bulk-bar"
          data-bulk-bar>

        <span data-bulk-ids></span>

        <span class="tgv-bulk-bar__count" data-bulk-count>0</span>

        <span class="text-sm font-semibold text-ink">selected</span>

        <span class="mx-1 h-5 w-px bg-line"></span>

        <button type="submit"
                name="action"
                value="publish"
                data-confirm="The selected articles will go live immediately."
                data-confirm-title="Publish selected articles?"
                data-confirm-action="Publish"
                data-confirm-tone="primary">
            Publish
        </button>

        <button type="submit"
                name="action"
                value="review">
            Send to review
        </button>

        <button type="submit"
                name="action"
                value="draft">
            Move to draft
        </button>

        <button type="submit"
                name="action"
                value="archive"
                data-confirm="Archived articles disappear from the public site. You can restore them later."
                data-confirm-title="Archive selected articles?"
                data-confirm-action="Archive">
            Archive
        </button>

        <span class="mx-1 h-5 w-px bg-line"></span>

        <button type="submit"
                name="action"
                value="section-pc">
            &#8594; PC / Console
        </button>

        <button type="submit"
                name="action"
                value="section-mobile">
            &#8594; Mobile
        </button>

        <button type="button"
                class="ml-1 rounded-lg px-2 py-2 text-ink-faint hover:text-ink"
                data-bulk-clear
                aria-label="Clear selection">
            &times;
        </button>

    </form>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const modal =
            document.getElementById("scheduleModal");

        const articleId =
            document.getElementById("scheduleArticleId");

        document.querySelectorAll(".openScheduleModal")
            .forEach(button => {

                button.addEventListener("click", function () {

                    articleId.value =
                        this.dataset.articleId;

                    modal.classList.remove("hidden");
                    modal.classList.add("flex");

                });

            });

        document
            .getElementById("closeScheduleModal")
            ?.addEventListener("click", function () {

                modal.classList.add("hidden");
                modal.classList.remove("flex");

            });

    });

</script>

<script>

    document.addEventListener("DOMContentLoaded", () => {

        /* -----------------------------
           Action Menu
        ------------------------------*/

        document.querySelectorAll(".actionMenuButton").forEach(button => {

            button.addEventListener("click", function (e) {

                e.stopPropagation();

                document.querySelectorAll(".actionMenu").forEach(menu => {

                    if (menu !== this.parentElement.nextElementSibling) {

                        menu.classList.add("hidden");

                    }

                });

                this.parentElement
                    .nextElementSibling
                    .classList
                    .toggle("hidden");

            });

        });

        document.addEventListener("click", () => {

            document.querySelectorAll(".actionMenu")
                .forEach(menu => menu.classList.add("hidden"));

        });


        /* -----------------------------
           Schedule Modal
        ------------------------------*/

        const scheduleModal =
            document.getElementById("scheduleModal");

        const articleId =
            document.getElementById("scheduleArticleId");

        const publishAt =
            document.getElementById("scheduledPublishAt");

        document.querySelectorAll(".openScheduleModal")
            .forEach(button => {

                button.addEventListener("click", function () {

                    articleId.value =
                        this.dataset.articleId;

                    publishAt.value =
                        this.dataset.publish ?? "";

                    scheduleModal.classList.remove("hidden");

                });

            });


        /* -----------------------------
           Close Modal
        ------------------------------*/

        document
            .getElementById("closeScheduleModal")
            ?.addEventListener("click", () => {

                scheduleModal.classList.add("hidden");

            });

        scheduleModal?.addEventListener("click", function (e) {

            if (e.target === this) {

                this.classList.add("hidden");

            }

        });

        document.addEventListener("keydown", function (e) {

            if (e.key === "Escape") {

                scheduleModal?.classList.add("hidden");

            }

        });


        /* -----------------------------
           Lucide Refresh
        ------------------------------*/

        if (window.lucide) {

            lucide.createIcons();

        }

    });

</script>