@using TheGameVoice.Domain.Enums
@using TheGameVoice.Infrastructure.Identity
@model IReadOnlyList<TheGameVoice.Domain.Entities.Article>

<div class="space-y-6">

    <div class="flex items-center justify-between">

        <h1 class="text-3xl font-bold">
            Articles
        </h1>

        <a asp-action="Create"
           class="rounded-lg bg-[#fa743e] px-4 py-2 text-white">
            Create Article
        </a>

    </div>

    <div class="rounded-xl bg-white shadow-sm">

        <table class="min-w-full">

            <thead class="border-b bg-gray-50">

                <tr>

                    <th class="px-6 py-4 text-left">
                        Thumbnail
                    </th>
                    <th class="px-6 py-4 text-left">
                        Title
                    </th>
                    <th class="px-6 py-4 text-left">
                        Category
                    </th>
                    <th class="px-6 py-4 text-left">
                        Status
                    </th>

                    <th class="px-6 py-4 text-left">
                        Created
                    </th>

                    <th class="px-6 py-4 text-left">
                        Published
                    </th>

                    <th class="px-6 py-4 text-left">
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var article in Model)
                {
                    <tr class="border-b">
                        <td class="px-6 py-4">

                            @if (article.FeaturedImage != null)
                            {
                                <img src="@article.FeaturedImage.FilePath"
                                     class="h-16 w-24 rounded-lg object-cover" />
                            }

                        </td>
                        <td class="px-6 py-4">
                            @article.Title
                        </td>
                        <td class="px-6 py-4">
                            @article.Category.Name
                        </td>
                        <td class="px-6 py-4">

                            @{
                                var badgeClass =
                                article.Status switch
                                {
                                    ArticleStatus.Draft =>
                                                    "bg-slate-100 text-slate-700",

                                    ArticleStatus.ReviewPending =>
                                                    "bg-amber-100 text-amber-800",

                                    ArticleStatus.Published =>
                                                    "bg-green-100 text-green-800",

                                    ArticleStatus.Rejected =>
                                                    "bg-red-100 text-red-800",

                                    ArticleStatus.Archived =>
                                                    "bg-gray-200 text-gray-700",

                                    _ =>
                                                    "bg-slate-100 text-slate-700"
                                };

                                var displayStatus =
                                article.Status switch
                                {
                                    ArticleStatus.ReviewPending =>
                                                    "In Review",

                                    _ =>
                                                    article.Status.ToString()
                                };
                            }

                            <span class="rounded-full px-3 py-1 text-sm font-medium @badgeClass">
                                @displayStatus
                            </span>

                        </td>

                        <td class="px-6 py-4">
                            @(article.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") ?? "-")
                        </td>

                        <td class="px-6 py-4">
                            @article.PublishedAt
                        </td>

                        <td class="px-6 py-4">

                            <div class="flex flex-wrap items-center gap-3">

                                <a asp-action="Edit"
                                   asp-route-id="@article.Id"
                                   class="font-medium text-[#fa743e]">

                                    Edit

                                </a>
                                @if (
                                User.IsInRole(Roles.Author) ||
                                User.IsInRole(Roles.Editor) ||
                                User.IsInRole(Roles.Admin) ||
                                User.IsInRole(Roles.SuperAdmin))
    {
                                @if (article.Status == ArticleStatus.Draft)
                                {
                                    <form asp-action="SubmitForReview"
                                          asp-route-id="@article.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="font-medium text-blue-600">

                                            Submit Review

                                        </button>

                                    </form>
                                }
                                }
                                @if (
                                User.IsInRole(Roles.Editor) ||
                                User.IsInRole(Roles.Admin) ||
                                User.IsInRole(Roles.SuperAdmin))
    {
                                @if (article.Status == ArticleStatus.ReviewPending)
                                {
                                    <form asp-action="Publish"
                                          asp-route-id="@article.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="font-medium text-green-600">

                                            Publish

                                        </button>

                                    </form>

                                    <form asp-action="Reject"
                                          asp-route-id="@article.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="font-medium text-red-600">

                                            Reject

                                        </button>

                                    </form>
                                     }
                                }

                                @if (
                                User.IsInRole(Roles.Admin) ||
                                User.IsInRole(Roles.SuperAdmin))
                                {
                                @if (article.Status == ArticleStatus.Published)
                                {
                                    <form asp-action="Archive"
                                          asp-route-id="@article.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="font-medium text-gray-600">

                                            Archive

                                        </button>

                                    </form>
                                }
                                }
                                @if (article.Status == ArticleStatus.Rejected)
                                {
                                    <form asp-action="Restore"
                                          asp-route-id="@article.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="font-medium text-blue-600">

                                            Return To Draft

                                        </button>

                                    </form>
                                }
                                @if (
                                User.IsInRole(Roles.Admin) ||
                                User.IsInRole(Roles.SuperAdmin))
                                {
                                @if (article.Status == ArticleStatus.Archived)
                                {
                                    <form asp-action="Restore"
                                          asp-route-id="@article.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="font-medium text-green-600">

                                            Restore

                                        </button>

                                    </form>
                                }
                            }
                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>