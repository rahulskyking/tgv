@model TheGameVoice.Web.Areas.Admin.ViewModels.Games.CreateGameViewModel

<div class="mx-auto max-w-5xl space-y-6">

    <div>
        <h1 class="text-fluid-3xl font-bold text-ink">Create Game</h1>
        <p class="mt-1 text-sm text-ink-muted">
            Import verified game information from IGDB or enter it manually.
        </p>
    </div>

    <section class="overflow-hidden rounded-2xl border border-line bg-surface shadow-sm"
             aria-labelledby="igdb-import-title">
        <div class="flex items-start gap-3 border-b border-line bg-surface-muted px-4 py-4 sm:px-5">
            <div class="rounded-xl bg-violet-100 p-2.5 text-violet-700">
                <i data-lucide="database" class="h-5 w-5"></i>
            </div>
            <div class="min-w-0">
                <h2 id="igdb-import-title" class="font-semibold text-ink">Import from IGDB</h2>
                <p class="mt-0.5 text-xs text-ink-muted">
                    Search once, select the correct game, then review every field before saving.
                </p>
            </div>
        </div>

        <div class="p-4 sm:p-5">
            <div class="flex gap-2">
                <div class="relative min-w-0 flex-1">
                    <i data-lucide="search"
                       class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-faint"></i>
                    <input id="igdb-search"
                           type="search"
                           autocomplete="off"
                           placeholder="Search by game name…"
                           class="h-11 w-full rounded-xl border border-line bg-surface pl-10 pr-4 text-sm text-ink shadow-sm focus:outline-none focus:ring-2 focus:ring-violet-200" />
                </div>
                <button id="igdb-search-button"
                        type="button"
                        class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-violet-600 px-4 text-sm font-semibold text-white transition hover:bg-violet-700 disabled:cursor-not-allowed disabled:opacity-60">
                    <i data-lucide="search" class="h-4 w-4 sm:hidden"></i>
                    <span class="hidden sm:inline">Search IGDB</span>
                </button>
            </div>

            <div id="igdb-status" class="mt-3 hidden text-sm" role="status" aria-live="polite"></div>
            <div id="igdb-results" class="mt-4 hidden grid-cols-1 gap-2 md:grid-cols-2"></div>
        </div>
    </section>

    <form method="post"
          class="space-y-6 rounded-2xl border border-line bg-surface p-5 shadow-sm sm:p-7">

        <input asp-for="SteamUrl" type="hidden" />
        <input asp-for="SteamAppId" type="hidden" />
        <input asp-for="IgdbGameId" type="hidden" />
        <input asp-for="IgdbCoverUrl" type="hidden" />
        <input asp-for="IgdbBannerUrl" type="hidden" />

        <div>

            <label class="mb-2 block font-medium">
                Game Name
            </label>

            <input asp-for="Name"
                   class="w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-200" />

            <span asp-validation-for="Name"
                  class="text-sm text-red-600">
            </span>

        </div>
        <div>
            <label class="mb-2 block font-medium">
                Summary
            </label>

            <textarea asp-for="Summary"
                      rows="3"
                      class="w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-200"></textarea>
        </div>

        <div>
            <label class="mb-2 block font-medium text-ink">
                Description
            </label>

            <textarea asp-for="Description"
                      rows="6"
                      class="w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink focus:outline-none focus:ring-2 focus:ring-orange-200"></textarea>
        </div>
        <div>
            <label class="mb-2 block font-medium">
                Release Date
            </label>

            <input asp-for="ReleaseDate"
                   type="date"
                   class="w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-200" />
        </div>
        <div class="grid gap-6 md:grid-cols-2">

            <div>
                <label class="mb-2 block font-medium">
                    Developer
                </label>

                <input asp-for="Developer"
                       class="w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-200" />
            </div>

            <div>
                <label class="mb-2 block font-medium">
                    Publisher
                </label>

                <input asp-for="Publisher"
                       class="w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-200" />
            </div>

        </div>
        <div class="grid gap-6 md:grid-cols-2">

            <div>
                <label class="mb-2 block font-medium">
                    Platforms
                </label>

                <input asp-for="Platforms"
                       placeholder="PC, PS5, Xbox Series X"
                       class="w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-200" />

                <div class="mt-4 rounded-xl border border-line bg-surface-muted px-4 py-3">

                    <div class="mb-2 text-sm font-medium">
                        Site section
                    </div>

                    <label class="mb-1 flex items-center gap-3">

                        <input asp-for="IsPcConsole" class="h-4 w-4" />

                        <span class="text-sm">PC / Console game</span>

                    </label>

                    <label class="flex items-center gap-3">

                        <input asp-for="IsMobile" class="h-4 w-4" />

                        <span class="text-sm">Mobile game</span>

                    </label>

                </div>
            </div>

            <div>
                <label class="mb-2 block font-medium">
                    Genres
                </label>

                <input asp-for="Genres"
                       placeholder="Action RPG, Open World"
                       class="w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-200" />
            </div>

        </div>
        <div>
            <label class="mb-2 block font-medium">
                Wishlist Game (Link)
            </label>

            <input asp-for="OfficialWebsite"
                   class="w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-200" />
        </div>
       @*  <div class="grid gap-6 md:grid-cols-2">

            <div>
                <label class="mb-2 block font-medium">
                    Steam URL
                </label>

                <input asp-for="SteamUrl"
                       class="w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-200" />
            </div>

            <div>
                <label class="mb-2 block font-medium">
                    Steam App ID
                </label>

                <input asp-for="SteamAppId"
                       class="w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-200" />
            </div>

        </div> *@
        <div class="rounded-2xl border bg-surface p-5">

            <h3 class="mb-4 font-semibold">

                Cover Image

            </h3>

            <input asp-for="CoverImageId"
                   id="cover-image-select"
                   type="hidden" />

            <div id="cover-preview"
                 class="overflow-hidden rounded-xl border border-line bg-surface-muted">

                <img id="cover-preview-image"
                     class="hidden h-64 w-full object-cover" />

                <div id="cover-placeholder"
                     class="flex h-64 items-center justify-center text-ink-muted">

                    No cover image selected

                </div>

            </div>

            <button type="button"
                    id="open-game-media-picker"
                    class="mt-4 w-full rounded-xl border border-line px-4 py-3 text-sm font-semibold text-ink-soft transition hover:border-primary hover:text-primary">

                Choose Cover Image

            </button>

        </div>

        <button type="submit"
                class="tgv-button-primary">

            Create Game

        </button>

    </form>

</div>
<div id="media-picker-modal"
     class="fixed inset-0 z-50 hidden">

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="absolute left-1/2 top-1/2 w-full max-w-6xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-surface p-6 shadow-2xl">

        <div class="mb-6 flex items-center justify-between">

            <h2 class="text-2xl font-bold">
                Media Library
            </h2>

            <button type="button"
                    id="close-media-picker">
                ✕
            </button>

        </div>

        <div class="grid max-h-[600px] grid-cols-2 gap-4 overflow-y-auto md:grid-cols-4">

            @foreach (var media in Model.MediaItems)
            {
                <div class="media-item cursor-pointer overflow-hidden rounded-xl border-2 border-transparent transition hover:border-primary"
                     data-id="@media.Id"
                     data-image="@media.FilePath">

                    <img src="@media.FilePath"
                         class="aspect-video w-full object-cover" />

                    <div class="p-2 text-xs truncate">
                        @media.FileName
                    </div>

                </div>
            }

        </div>

    </div>

</div>
<script>
    (() => {
        const input = document.getElementById("igdb-search");
        const button = document.getElementById("igdb-search-button");
        const results = document.getElementById("igdb-results");
        const status = document.getElementById("igdb-status");
        let controller;

        const setStatus = (message, isError = false) => {
            status.textContent = message;
            status.className = `mt-3 text-sm ${isError ? "text-red-600" : "text-ink-muted"}`;
        };

        const setValue = (id, value) => {
            const element = document.getElementById(id);
            if (element) element.value = value ?? "";
        };

        const chooseGame = game => {
            setValue("Name", game.name);
            setValue("Summary", game.summary);
            setValue("Description", game.description);
            setValue("ReleaseDate", game.releaseDate);
            setValue("Developer", game.developer);
            setValue("Publisher", game.publisher);
            setValue("Platforms", (game.platforms || []).join(", "));
            setValue("Genres", (game.genres || []).join(", "));
            setValue("OfficialWebsite", game.officialWebsite || game.steamUrl);
            setValue("SteamUrl", game.steamUrl);
            setValue("SteamAppId", game.steamAppId);
            setValue("IgdbGameId", game.externalId);
            setValue("IgdbCoverUrl", game.coverUrl);
            setValue("IgdbBannerUrl", game.bannerUrl);

            document.getElementById("IsPcConsole").checked = game.isPcConsole;
            document.getElementById("IsMobile").checked = game.isMobile;

            if (game.coverUrl) {
                const preview = document.getElementById("cover-preview-image");
                preview.src = game.coverUrl;
                preview.classList.remove("hidden");
                document.getElementById("cover-placeholder").classList.add("hidden");
            }

            results.classList.add("hidden");
            setStatus(`Imported ${game.name}. Review the details below before creating it.`);
            document.getElementById("Name").focus();
        };

        const render = games => {
            results.replaceChildren();
            results.classList.remove("hidden");
            results.classList.add("grid");

            if (!games.length) {
                setStatus("No matching games found. Try a more specific title.");
                results.classList.add("hidden");
                return;
            }

            games.forEach(game => {
                const item = document.createElement("button");
                item.type = "button";
                item.className = "group flex min-w-0 items-center gap-3 rounded-xl border border-line p-3 text-left transition hover:border-violet-300 hover:bg-violet-50";

                const imageWrap = document.createElement("span");
                imageWrap.className = "flex h-16 w-12 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-surface-raised text-ink-faint";
                if (game.coverUrl) {
                    const image = document.createElement("img");
                    image.src = game.coverUrl;
                    image.alt = "";
                    image.loading = "lazy";
                    image.className = "h-full w-full object-cover";
                    imageWrap.appendChild(image);
                } else {
                    imageWrap.textContent = "—";
                }

                const copy = document.createElement("span");
                copy.className = "min-w-0 flex-1";
                const name = document.createElement("strong");
                name.className = "block truncate text-sm text-ink group-hover:text-violet-700";
                name.textContent = game.name;
                const meta = document.createElement("span");
                meta.className = "mt-1 block line-clamp-2 text-xs text-ink-muted";
                const year = game.releaseDate ? game.releaseDate.slice(0, 4) : "Date unknown";
                meta.textContent = `${year} · ${(game.platforms || []).slice(0, 3).join(", ") || "Platforms unknown"}`;
                copy.append(name, meta);

                const action = document.createElement("span");
                action.className = "shrink-0 text-xs font-semibold text-violet-700";
                action.textContent = "Use";
                item.append(imageWrap, copy, action);
                item.addEventListener("click", () => chooseGame(game));
                results.appendChild(item);
            });

            setStatus(`${games.length} result${games.length === 1 ? "" : "s"} found.`);
        };

        const search = async () => {
            const query = input.value.trim();
            if (query.length < 2) {
                setStatus("Enter at least two characters.", true);
                return;
            }

            controller?.abort();
            controller = new AbortController();
            button.disabled = true;
            results.classList.add("hidden");
            setStatus("Searching IGDB…");

            try {
                const response = await fetch(
                    `@Url.Action("SearchIgdb", "Games", new { area = "Admin" })?query=${encodeURIComponent(query)}`,
                    { signal: controller.signal, headers: { "Accept": "application/json" } });
                const data = await response.json();
                if (!response.ok) throw new Error(data.message || "Search failed.");
                render(data);
            } catch (error) {
                if (error.name !== "AbortError") setStatus(error.message, true);
            } finally {
                button.disabled = false;
            }
        };

        button.addEventListener("click", search);
        input.addEventListener("keydown", event => {
            if (event.key === "Enter") {
                event.preventDefault();
                search();
            }
        });
    })();

    document
        .getElementById("open-game-media-picker")
        .addEventListener("click", function ()
        {
            document
                .getElementById("media-picker-modal")
                .classList.remove("hidden");
        });

    document
        .getElementById("close-media-picker")
        .addEventListener("click", function ()
        {
            document
                .getElementById("media-picker-modal")
                .classList.add("hidden");
        });

    document
        .querySelectorAll(".media-item")
        .forEach(item =>
        {
            item.addEventListener("click", function ()
            {
                const imageId =
                    this.dataset.id;

                const imageUrl =
                    this.dataset.image;

                document
                    .getElementById("cover-image-select")
                    .value = imageId;

                const preview =
                    document
                        .getElementById("cover-preview-image");

                preview.src = imageUrl;

                preview.classList.remove("hidden");

                document
                    .getElementById("cover-placeholder")
                    .classList.add("hidden");

                document
                    .getElementById("media-picker-modal")
                    .classList.add("hidden");
            });
        });

</script>