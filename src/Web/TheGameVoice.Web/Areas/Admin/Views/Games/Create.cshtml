@model TheGameVoice.Web.Areas.Admin.ViewModels.Games.CreateGameViewModel

<div class="max-w-2xl space-y-6">

    <h1 class="text-3xl font-bold">
        Create Game
    </h1>

    <form method="post"
          class="space-y-6">

        <div>

            <label class="mb-2 block font-medium">
                Game Name
            </label>

            <input asp-for="Name"
                   class="w-full rounded-2xl border px-4 py-3" />

        </div>

        <button type="submit"
                class="tgv-button-primary">

            Create Game

        </button>

    </form>

</div>