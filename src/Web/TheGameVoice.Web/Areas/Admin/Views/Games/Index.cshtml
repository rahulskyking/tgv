@model IReadOnlyList<TheGameVoice.Domain.Entities.Game>

<div class="space-y-6">

    <div class="flex items-center justify-between">

        <h1 class="text-3xl font-bold">
            Games
        </h1>

        <a asp-action="Create"
           class="tgv-button-primary">
            Create Game
        </a>

    </div>

    <div class="overflow-hidden rounded-2xl bg-white shadow-sm">

        <table class="min-w-full">

            <thead class="bg-gray-50">

                <tr>

                    <th class="px-6 py-4 text-left">
                        Cover
                    </th>

                    <th class="px-6 py-4 text-left">
                        Name
                    </th>

                    <th class="px-6 py-4 text-left">
                        Release Date
                    </th>

                    <th class="px-6 py-4 text-left">
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var game in Model)
                {
                    <tr class="border-t">

                        <td class="px-6 py-4">

                            @if (game.CoverImage != null)
                            {
                                <img src="@game.CoverImage.FilePath"
                                     class="h-16 w-28 rounded-lg object-cover" />
                            }
                            else
                            {
                                <div class="flex h-16 w-28 items-center justify-center rounded-lg border text-xs text-gray-400">
                                    No Image
                                </div>
                            }

                        </td>

                        <td class="px-6 py-4 font-medium">
                            @game.Name
                        </td>

                        <td class="px-6 py-4">
                            @(game.ReleaseDate?.ToString("dd MMM yyyy") ?? "-")
                        </td>

                        <td class="px-6 py-4">

                            <div class="flex gap-3">

                                <a asp-action="Edit"
                                   asp-route-id="@game.Id"
                                   class="text-blue-600 hover:text-blue-800">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@game.Id"
                                      method="post"
                                      onsubmit="return confirm('Delete this game?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="text-red-600 hover:text-red-800">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>