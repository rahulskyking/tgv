@model TheGameVoice.Web.Areas.Admin.ViewModels.LoginViewModel

<h2>Admin Login</h2>

<form asp-area="Admin"
      asp-controller="Auth"
      asp-action="Login"
      method="post">

    <div asp-validation-summary="All"></div>

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <div>
        <label>Password</label>
        <input asp-for="Password" type="password" />
    </div>

    <div>
        <input asp-for="RememberMe" type="checkbox" />
        <label>Remember Me</label>
    </div>

    <button type="submit">
        Login
    </button>

</form>