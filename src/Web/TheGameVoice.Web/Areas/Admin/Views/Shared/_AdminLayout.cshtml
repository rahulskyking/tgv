@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@functions
{
    private string NavClass(string controller)
    {
        var current =
            ViewContext.RouteData.Values["controller"]?.ToString();

        return current == controller
            ? "flex items-center gap-3 rounded-lg bg-gray-800 px-3 py-2.5 text-sm font-medium text-white"
            : "flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-gray-300 transition hover:bg-gray-800 hover:text-white";
    }
}
<!DOCTYPE html>
<html data-theme="light">
<head>
    <title>TheGameVoice Admin</title>

    @*  THEME BOOTSTRAP — must stay first, prevents a white flash. *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem("tgv-theme");

                var theme = saved
                    || (window.matchMedia
                        && window.matchMedia("(prefers-color-scheme: dark)").matches
                            ? "dark"
                            : "light");

                document.documentElement.setAttribute("data-theme", theme);
            } catch (e) { }
        })();
    </script>

    <meta charset="utf-8" />
    @*  Was missing entirely — without it phones render the admin at a
        980px virtual width and zoom out. *@
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />

    @*  One compiled stylesheet (see tailwind.config.js + wwwroot/css/app.css) *@
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css"
          rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
</head>

<body class="bg-canvas">

    <!-- MOBILE TOP BAR (hidden from 1024px up) -->

    <div class="tgv-admin-topbar">

        <button type="button"
                class="tgv-admin-burger"
                data-admin-nav-toggle
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="admin-sidebar">
            <i data-lucide="menu" class="h-5 w-5"></i>
        </button>

        <span class="text-lg font-bold">TGV Admin</span>

    </div>

    <div class="tgv-admin-backdrop" data-admin-nav-close></div>

    <div class="tgv-admin-shell flex min-h-screen">

        <aside id="admin-sidebar" class="tgv-admin-sidebar w-64 bg-gray-900 text-white">

            <div class="p-4 text-2xl font-bold">
                TGV Admin
            </div>

            <nav class="mt-6 space-y-1 px-3">

                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="@NavClass("Dashboard")">
                    <i data-lucide="layout-dashboard" class="h-4 w-4"></i>
                    Dashboard
                </a>

                <a asp-area="Admin"
                   asp-controller="Articles"
                   asp-action="Index"
                   class="@NavClass("Articles")">
                    <i data-lucide="file-text" class="h-4 w-4"></i>
                    Articles
                </a>

                <a href="#"
                   class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-gray-300 transition hover:bg-gray-800 hover:text-white">
                    <i data-lucide="star" class="h-4 w-4"></i>
                    Reviews
                </a>

                <a asp-area="Admin"
                   asp-controller="Media"
                   asp-action="Index"
                   class="@NavClass("Media")">
                    <i data-lucide="image" class="h-4 w-4"></i>
                    Media
                </a>

                <a asp-area="Admin"
                   asp-controller="Categories"
                   asp-action="Index"
                   class="@NavClass("Categories")">
                    <i data-lucide="folder" class="h-4 w-4"></i>
                    Categories
                </a>

                <a asp-area="Admin"
                   asp-controller="Tags"
                   asp-action="Index"
                   class="@NavClass("Tags")">
                    <i data-lucide="tag" class="h-4 w-4"></i>
                    Tags
                </a>

                <a asp-area="Admin"
                   asp-controller="Games"
                   asp-action="Index"
                   class="@NavClass("Games")">
                    <i data-lucide="gamepad-2" class="h-4 w-4"></i>
                    Games
                </a>

                @*  Users is Admin/SuperAdmin only — showing it to an author
                    just hands them a 403. *@
                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <a asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Index"
                       class="@NavClass("Users")">
                        <i data-lucide="users" class="h-4 w-4"></i>
                        Users
                    </a>
                }

                <div class="mt-4 border-t border-gray-800 pt-4">

                    <a asp-area="Admin"
                       asp-controller="Profile"
                       asp-action="Index"
                       class="@NavClass("Profile")">
                        <i data-lucide="user-circle" class="h-4 w-4"></i>
                        My profile
                    </a>

                    <a asp-area="Admin"
                       asp-controller="Auth"
                       asp-action="Logout"
                       class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-gray-300 transition hover:bg-gray-800 hover:text-white">
                        <i data-lucide="log-out" class="h-4 w-4"></i>
                        Sign out
                    </a>

                    @{
                        ViewData["ThemeToggleClass"] = "tgv-theme-toggle--sidebar";
                        ViewData["ThemeToggleLabel"] = true;
                    }

                    <partial name="~/Views/Shared/Components/_ThemeToggle.cshtml" />

                    @{
                        ViewData["ThemeToggleClass"] = null;
                        ViewData["ThemeToggleLabel"] = null;
                    }

                </div>

            </nav>

        </aside>

        <main class="tgv-admin-main">

            <partial name="~/Views/Shared/Components/_Alerts.cshtml" />

            @RenderBody()

        </main>

    </div>

    <script src="https://cdn.tiny.cloud/1/@Configuration["TinyMce:ApiKey"]/tinymce/8/tinymce.min.js"
            referrerpolicy="origin"
            crossorigin="anonymous">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="~/js/imagepicker.js?v=1.0"></script>
    <script src="~/js/tomselect.js?v=1.0"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/admin-ux.js" asp-append-version="true"></script>
    <script src="~/js/admin-nav.js" asp-append-version="true"></script>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        lucide.createIcons();
    </script>
    <script>
            const tinyMceApiKey = '@Configuration["TinyMce:ApiKey"]';
        document.addEventListener("DOMContentLoaded", function () {

            const select =
                document.getElementById("featured-image-select");

            const image =
                document.getElementById("preview-image");

            const placeholder =
                document.getElementById("preview-placeholder");

            if (!select)
                return;

            function updatePreview() {

                const option =
                    select.options[select.selectedIndex];

                const imagePath =
                    option.dataset.image;

                if (imagePath) {

                    image.src = imagePath;

                    image.classList.remove("hidden");

                    placeholder.classList.add("hidden");

                }
                else {

                    image.classList.add("hidden");

                    placeholder.classList.remove("hidden");

                }

            }

            select.addEventListener(
                "change",
                updatePreview);

            updatePreview();

        });

    </script>
    <script>

        let activeEditor = null;
        let activeVideoEditor = null;

        function openEditorMediaPicker(editor)
        {
            activeEditor = editor;

            document
                .getElementById("editor-media-modal")
                .classList.remove("hidden");
        }

        function insertImageIntoEditor(imageUrl)
        {
            if (!activeEditor)
            {
                return;
            }

            activeEditor.insertContent(
                '<figure class="article-image">' +
                '<img src="' + imageUrl + '" alt="" loading="lazy" />' +
                '</figure>' +
                '<p></p>'
            );

            document
                .getElementById("editor-media-modal")
                .classList.add("hidden");
        }

        function openVideoModal(editor)
        {
            activeVideoEditor = editor;

            document
                .getElementById("video-insert-modal")
                .classList.remove("hidden");
        }

        function getYoutubeEmbedUrl(url)
        {
            try
            {
                const parsed =
                    new URL(url);

                if (
                    parsed.hostname.includes(
                        "youtube.com"))
                {
                    const id =
                        parsed.searchParams.get("v");

                    if (!id)
                    {
                        return null;
                    }

                    return `https://www.youtube.com/embed/${id}`;
                }

                if (
                    parsed.hostname.includes(
                        "youtu.be"))
                {
                    const id =
                        parsed.pathname.replace("/", "");

                    return `https://www.youtube.com/embed/${id}`;
                }

                return null;
            }
            catch
            {
                return null;
            }
        }

        function insertVideoIntoEditor()
        {
            const url =
                document
                    .getElementById(
                        "video-url-input")
                    .value
                    .trim();

            const embedUrl =
                getYoutubeEmbedUrl(url);

            if (!embedUrl)
            {
                alert(
                    "Please enter a valid YouTube URL.");

                return;
            }

            activeVideoEditor.insertContent(
                '<div class="article-video">' +
                    '<iframe ' +
                        'src="' + embedUrl + '" ' +
                        'width="100%" ' +
                        'height="500" ' +
                        'allowfullscreen ' +
                        'loading="lazy">' +
                    '</iframe>' +
                '</div>' +
                '<p></p>'
            );

            document
                .getElementById(
                    "video-insert-modal")
                .classList.add("hidden");

            document
                .getElementById(
                    "video-url-input")
                .value = "";
        }

        function tgvIsDark() {
            return document.documentElement.getAttribute("data-theme") === "dark";
        }

        function tgvEditorSkin() {
            return tgvIsDark()
                ? { skin: "oxide-dark", content_css: "dark" }
                : { skin: "oxide", content_css: "default" };
        }

        // Re-create the editor when the theme flips, otherwise a dark admin
        // keeps a blinding white editor iframe.
        document.addEventListener("click", function (event) {
            if (!event.target.closest("[data-theme-toggle]")) {
                return;
            }

            window.setTimeout(function () {
                var editor = window.tinymce && window.tinymce.get("editor");

                if (!editor) {
                    return;
                }

                var content = editor.getContent();

                editor.remove();

                tinymce.init(Object.assign({}, window.tgvEditorConfig, tgvEditorSkin()))
                    .then(function (editors) {
                        if (editors && editors[0]) {
                            editors[0].setContent(content);
                        }
                    });
            }, 60);
        });

                tinymce.init(window.tgvEditorConfig = Object.assign({

            selector: '#editor',

            apiKey: 'YOUR_NEW_TINYMCE_API_KEY',

            height: 700,

            menubar: false,

            plugins: [
                'link',
                'image',
                'media',
                'table',
                'lists',
                'code',
                'fullscreen',
                'wordcount'
            ],

            toolbar:
                'undo redo | styles | bold italic underline | ' +
                'alignleft aligncenter alignright | ' +
                'bullist numlist | link image media table | ' +
                'tgvMediaLibrary tgvVideo | fullscreen code',

            setup: function (editor)
            {
                editor.ui.registry.addButton(
                    'tgvMediaLibrary',
                    {
                        text: 'Photos',

                        onAction: function ()
                        {
                            openEditorMediaPicker(editor);
                        }
                    });

                editor.ui.registry.addButton(
                    'tgvVideo',
                    {
                        text: 'Video',

                        onAction: function ()
                        {
                            openVideoModal(editor);
                        }
                    });
            }
        }, tgvEditorSkin()));

    </script>
   
 
    <script>

        document.addEventListener("DOMContentLoaded", () => {

            const openBtn =
                document.getElementById("open-media-picker");

            const closeBtn =
                document.getElementById("close-media-picker");

            const modal =
                document.getElementById("media-picker-modal");

            const featuredSelect =
                document.getElementById("featured-image-select");

            if (!openBtn || !modal || !featuredSelect)
                return;

            // Open Modal

            openBtn.addEventListener("click", () => {

                modal.classList.remove("hidden");

            });

            // Close Modal Button

            if (closeBtn) {

                closeBtn.addEventListener("click", () => {

                    modal.classList.add("hidden");

                });

            }

            // Close Modal on Backdrop Click

            modal.addEventListener("click", (e) => {

                if (e.target === modal) {

                    modal.classList.add("hidden");

                }

            });

            // Image Selection

            document
                .querySelectorAll(".media-item")
                .forEach(item => {

                    item.addEventListener("click", () => {

                        document
                            .querySelectorAll(".media-item")
                            .forEach(x =>
                                x.classList.remove(
                                    "border-primary"));

                        item.classList.add(
                            "border-primary");

                        const mediaId =
                            item.dataset.id;

                        console.log(
                            "Selected Media:",
                            mediaId);

                        featuredSelect.value =
                            mediaId;

                        featuredSelect.dispatchEvent(
                            new Event("change", {
                                bubbles: true
                            }));

                        modal.classList.add("hidden");

                    });

                });

        });

    </script>
    <script>

        // Inline media upload — uploads straight from the article form's
        // Media Library modal, then adds the new items to every picker so
        // the admin does not have to save + re-edit to see them.
        function addMediaItem(item)
        {
            const id = item.id;
            const filePath = String(item.filePath);
            const fileName = item.fileName;
            // 1) Media Library modal grid
            const mediaGrid =
                document.getElementById("media-grid");

            if (mediaGrid)
            {
                const div =
                    document.createElement("div");

                div.className =
                    "media-item cursor-pointer overflow-hidden " +
                    "rounded-xl border-2 border-transparent transition " +
                    "hover:border-primary";

                div.dataset.id = id;
                div.dataset.image = filePath;
                div.dataset.name = fileName;

                div.innerHTML =
                    `<img src="${filePath}" class="aspect-video w-full object-cover" />` +
                    `<div class="p-2 text-xs truncate">${fileName}</div>`;

                div.addEventListener("click", () => {

                    document
                        .querySelectorAll(".media-item")
                        .forEach(x =>
                            x.classList.remove("border-primary"));

                    div.classList.add("border-primary");

                    const featuredSelect =
                        document.getElementById("featured-image-select");

                    if (featuredSelect)
                    {
                        featuredSelect.value = id;

                        featuredSelect.dispatchEvent(
                            new Event("change", { bubbles: true }));
                    }

                    document
                        .getElementById("media-picker-modal")
                        .classList.add("hidden");
                });

                mediaGrid.insertBefore(div, mediaGrid.firstChild);
            }

            // 2) Featured Image dropdown
            const featuredSelect =
                document.getElementById("featured-image-select");

            if (featuredSelect)
            {
                const option =
                    document.createElement("option");

                option.value = id;
                option.dataset.image = filePath;
                option.textContent = fileName;

                // Insert right after the "Select Image" placeholder.
                featuredSelect.insertBefore(
                    option,
                    featuredSelect.options[1] || null);
            }

            // 3) Editor "Insert Image" modal grid
            const editorGrid =
                document.getElementById("editor-media-grid");

            if (editorGrid)
            {
                const div =
                    document.createElement("div");

                div.className =
                    "cursor-pointer overflow-hidden rounded-xl border " +
                    "hover:border-primary";

                div.dataset.name = fileName;

                div.addEventListener(
                    "click",
                    () => insertImageIntoEditor(filePath));

                div.innerHTML =
                    `<img src="${filePath}" class="aspect-video w-full object-cover" />` +
                    `<div class="p-2 text-xs truncate">${fileName}</div>`;

                editorGrid.insertBefore(div, editorGrid.firstChild);
            }

            // 4) Gallery picker modal grid
            const galleryGrid =
                document.getElementById("gallery-media-grid");

            if (galleryGrid)
            {
                const div =
                    document.createElement("div");

                div.className =
                    "gallery-media-item cursor-pointer overflow-hidden " +
                    "rounded-xl border-2 border-transparent transition " +
                    "hover:border-primary";

                div.dataset.id = id;
                div.dataset.image = filePath;
                div.dataset.name = fileName;

                div.innerHTML =
                    `<img src="${filePath}" class="aspect-video w-full object-cover" />` +
                    `<div class="p-2 text-xs truncate">${fileName}</div>`;

                galleryGrid.insertBefore(div, galleryGrid.firstChild);
            }
        }

        document.addEventListener("DOMContentLoaded", () => {

            function setStatus(statusEl, text, type)
            {
                if (!statusEl)
                    return;

                statusEl.classList.remove("hidden");
                statusEl.classList.remove(
                    "text-ink-muted", "text-red-500", "text-emerald-600");

                if (type === "error")
                    statusEl.classList.add("text-red-500");
                else if (type === "success")
                    statusEl.classList.add("text-emerald-600");
                else
                    statusEl.classList.add("text-ink-muted");

                statusEl.textContent = text;
            }

            function bindInlineUpload(btnId, fileId, statusId, onSuccess)
            {
                const uploadBtn =
                    document.getElementById(btnId);

                const fileInput =
                    document.getElementById(fileId);

                const statusEl =
                    document.getElementById(statusId);

                if (!uploadBtn || !fileInput)
                    return;

                uploadBtn.addEventListener("click", () =>
                    fileInput.click());

                fileInput.addEventListener("change", async () => {

                    const files =
                        Array.from(fileInput.files || []);

                    if (files.length === 0)
                        return;

                    const formData =
                        new FormData();

                    files.forEach(f =>
                        formData.append("files", f));

                    uploadBtn.disabled = true;

                    window.tgvShowLoading &&
                        window.tgvShowLoading("Uploading…");

                    setStatus(
                        statusEl,
                        "Uploading...",
                        "info");

                    try
                    {
                        const response =
                            await fetch("/Admin/Media/UploadAjax", {
                                method: "POST",
                                body: formData
                            });

                        const result =
                            await response.json();

                        if (!result.success)
                        {
                            setStatus(
                                statusEl,
                                result.message || "Upload failed.",
                                "error");

                            return;
                        }

                        result.items.forEach(addMediaItem);

                        if (onSuccess)
                            onSuccess(result);

                        setStatus(
                            statusEl,
                            result.items.length + " image(s) uploaded.",
                            "success");
                    }
                    catch (err)
                    {
                        setStatus(
                            statusEl,
                            "Upload failed.",
                            "error");
                    }
                    finally
                    {
                        uploadBtn.disabled = false;
                        fileInput.value = "";

                        window.tgvHideLoading &&
                            window.tgvHideLoading();
                    }
                });
            }

            // 1) Featured image media-library modal
            bindInlineUpload(
                "inline-media-upload-btn",
                "inline-media-file",
                "inline-media-status",
                (result) => {
                    // Auto-select the first uploaded image as featured.
                    if (result.items.length > 0)
                    {
                        const first = result.items[0];

                        const featuredSelect =
                            document.getElementById("featured-image-select");

                        if (featuredSelect)
                        {
                            featuredSelect.value = first.id;

                            featuredSelect.dispatchEvent(
                                new Event("change", { bubbles: true }));
                        }
                    }
                });

            // 2) TinyMCE editor "Insert Image" modal
            bindInlineUpload(
                "editor-media-upload-btn",
                "editor-media-file",
                "editor-media-status");
        });

        // Search filters for both media modals.
        function bindMediaSearch(inputId, itemSelector)
        {
            const input = document.getElementById(inputId);

            if (!input)
                return;

            input.addEventListener("input", () => {
                const term =
                    input.value.toLowerCase().trim();

                document
                    .querySelectorAll(itemSelector)
                    .forEach(item => {
                        const name =
                            (item.dataset.name || "").toLowerCase();

                        item.classList.toggle("hidden", !name.includes(term));
                    });
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            bindMediaSearch("media-search", ".media-item");
            bindMediaSearch("editor-media-search", "#editor-media-grid > div");
        });

    </script>
    <script>

        document.addEventListener("DOMContentLoaded", () => {

            const addVideoBtn =
                document.getElementById(
                    "add-video-btn");

            const videoContainer =
                document.getElementById(
                    "video-container");

            let videoIndex =
                videoContainer
                    .querySelectorAll(".video-item")
                    .length;

            addVideoBtn.addEventListener(
                "click",
                () =>
                {
                    const html = `
                    <div class="video-item mb-4 rounded-xl border p-4">

                        <input
                            name="Videos[${videoIndex}].Title"
                            placeholder="Video Title"
                            class="mb-3 w-full rounded-lg border px-4 py-3" />

                        <input
                            name="Videos[${videoIndex}].VideoUrl"
                            placeholder="https://youtube.com/..."
                            class="w-full rounded-lg border px-4 py-3" />

                    </div>
                    `;

                    videoContainer
                        .insertAdjacentHTML(
                            "beforeend",
                            html);

                    videoIndex++;
                });

        });

    </script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const select =
                document.getElementById(
                    "avatar-image-select");

            const image =
                document.getElementById(
                    "avatar-preview-image");

            const placeholder =
                document.getElementById(
                    "avatar-preview-placeholder");

            function updatePreview() {

                const option =
                    select.options[
                        select.selectedIndex];

                const imagePath =
                    option.dataset.image;

                if (!imagePath) {

                    image.classList.add("hidden");
                    placeholder.classList.remove("hidden");

                    return;
                }

                image.src = imagePath;

                image.classList.remove("hidden");

                placeholder.classList.add("hidden");
            }

            select.addEventListener(
                "change",
                updatePreview);

            updatePreview();

        });
    </script>

    <!-- GLOBAL LOADING OVERLAY (shown during media uploads / long actions) -->
    <div id="tgv-loading-overlay"
         class="tgv-loading-overlay"
         role="status"
         aria-live="polite">

        <div class="tgv-loading-box">

            <div class="tgv-loading-spinner"></div>

            <p class="tgv-loading-text">Uploading…</p>

        </div>

    </div>

    <script>
        window.tgvShowLoading = function (message) {
            var overlay =
                document.getElementById("tgv-loading-overlay");

            if (!overlay)
                return;

            var text =
                overlay.querySelector(".tgv-loading-text");

            if (text && message)
                text.textContent = message;

            overlay.classList.add("is-open");
        };

        window.tgvHideLoading = function () {
            var overlay =
                document.getElementById("tgv-loading-overlay");

            if (overlay)
                overlay.classList.remove("is-open");
        };

        // Any form marked with data-loading shows the overlay on submit
        // (covers the standalone Media upload page and future full-post
        // upload forms; also hides it again on back navigation).
        document.addEventListener("submit", function (event) {
            var form = event.target.closest("[data-loading]");

            if (!form)
                return;

            window.tgvShowLoading(
                form.getAttribute("data-loading") || "Uploading…");
        });

        window.addEventListener("pageshow", function (event) {
            if (event.persisted)
                window.tgvHideLoading();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>