@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html>
<head>
    <title>TheGameVoice Admin</title>

    <link rel="stylesheet"
          href="~/css/site.css" />
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css"
          rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
</head>

<body class="bg-gray-100">

    <div class="flex min-h-screen">

        <aside class="w-64 bg-gray-900 text-white">

            <div class="p-4 text-2xl font-bold">
                TGV Admin
            </div>

            <nav class="mt-6">

                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="block px-4 py-3 hover:bg-gray-800">
                    Dashboard
                </a>
                <a asp-area="Admin"
                   asp-controller="Articles"
                   asp-action="Index"
                   class="block rounded-lg px-4 py-3 hover:bg-gray-700 transition">
                    Articles
                </a>

                <a href="#"
                   class="block px-4 py-3 hover:bg-gray-800">
                    Reviews
                </a>

                <a asp-area="Admin"
                   asp-controller="Media"
                   asp-action="Index"
                   class="block rounded-lg px-4 py-3 hover:bg-gray-700 transition">
                    Media
                </a>
                <a asp-area="Admin"
                   asp-controller="Categories"
                   asp-action="Index"
                   class="block rounded-lg px-4 py-3 hover:bg-gray-700 transition">
                    Categories
                </a>
                <a asp-area="Admin"
                   asp-controller="Tags"
                   asp-action="Index"
                   class="block rounded-lg px-4 py-3 hover:bg-gray-700 transition">
                    Tags
                </a>
                <a asp-area="Admin"
                   asp-controller="Games"
                   asp-action="Index" 
                   class="block rounded-lg px-4 py-3 hover:bg-gray-700 transition">
                    Games
                </a>
                <a asp-area="Admin"
                   asp-controller="Users"
                   asp-action="Index"
                   class="block rounded-lg px-4 py-3 hover:bg-gray-700 transition">

                    Users

                </a>
            </nav>

        </aside>

        <main class="flex-1 p-6">

            @RenderBody()

        </main>

    </div>

    <script src="https://cdn.tiny.cloud/1/@Configuration["TinyMce:ApiKey"]/tinymce/8/tinymce.min.js"
            referrerpolicy="origin"
            crossorigin="anonymous">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="~/js/imagepicker.js?v=1.0"></script>
    <script src="~/js/article.js?v=1.0"></script>
    <script src="~/js/tomselect.js?v=1.0"></script>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        lucide.createIcons();
    </script>
    <script>
            const tinyMceApiKey = '@Configuration["TinyMce:ApiKey"]';
        document.addEventListener("DOMContentLoaded", function () {

            const select =
                document.getElementById("featured-image-select");

            const image =
                document.getElementById("preview-image");

            const placeholder =
                document.getElementById("preview-placeholder");

            if (!select)
                return;

            function updatePreview() {

                const option =
                    select.options[select.selectedIndex];

                const imagePath =
                    option.dataset.image;

                if (imagePath) {

                    image.src = imagePath;

                    image.classList.remove("hidden");

                    placeholder.classList.add("hidden");

                }
                else {

                    image.classList.add("hidden");

                    placeholder.classList.remove("hidden");

                }

            }

            select.addEventListener(
                "change",
                updatePreview);

            updatePreview();

        });

    </script>
    <script>

        let activeEditor = null;
        let activeVideoEditor = null;

        function openEditorMediaPicker(editor)
        {
            activeEditor = editor;

            document
                .getElementById("editor-media-modal")
                .classList.remove("hidden");
        }

        function insertImageIntoEditor(imageUrl)
        {
            if (!activeEditor)
            {
                return;
            }

            activeEditor.insertContent(
                '<figure class="article-image">' +
                '<img src="' + imageUrl + '" alt="" loading="lazy" />' +
                '</figure>' +
                '<p></p>'
            );

            document
                .getElementById("editor-media-modal")
                .classList.add("hidden");
        }

        function openVideoModal(editor)
        {
            activeVideoEditor = editor;

            document
                .getElementById("video-insert-modal")
                .classList.remove("hidden");
        }

        function getYoutubeEmbedUrl(url)
        {
            try
            {
                const parsed =
                    new URL(url);

                if (
                    parsed.hostname.includes(
                        "youtube.com"))
                {
                    const id =
                        parsed.searchParams.get("v");

                    if (!id)
                    {
                        return null;
                    }

                    return `https://www.youtube.com/embed/${id}`;
                }

                if (
                    parsed.hostname.includes(
                        "youtu.be"))
                {
                    const id =
                        parsed.pathname.replace("/", "");

                    return `https://www.youtube.com/embed/${id}`;
                }

                return null;
            }
            catch
            {
                return null;
            }
        }

        function insertVideoIntoEditor()
        {
            const url =
                document
                    .getElementById(
                        "video-url-input")
                    .value
                    .trim();

            const embedUrl =
                getYoutubeEmbedUrl(url);

            if (!embedUrl)
            {
                alert(
                    "Please enter a valid YouTube URL.");

                return;
            }

            activeVideoEditor.insertContent(
                '<div class="article-video">' +
                    '<iframe ' +
                        'src="' + embedUrl + '" ' +
                        'width="100%" ' +
                        'height="500" ' +
                        'allowfullscreen ' +
                        'loading="lazy">' +
                    '</iframe>' +
                '</div>' +
                '<p></p>'
            );

            document
                .getElementById(
                    "video-insert-modal")
                .classList.add("hidden");

            document
                .getElementById(
                    "video-url-input")
                .value = "";
        }

                tinymce.init({

            selector: '#editor',

            apiKey: 'YOUR_NEW_TINYMCE_API_KEY',

            height: 700,

            menubar: false,

            plugins: [
                'link',
                'image',
                'media',
                'table',
                'lists',
                'code',
                'fullscreen',
                'wordcount'
            ],

            toolbar:
                'undo redo | styles | bold italic underline | ' +
                'alignleft aligncenter alignright | ' +
                'bullist numlist | link image media table | ' +
                'tgvMediaLibrary tgvVideo | fullscreen code',

            setup: function (editor)
            {
                editor.ui.registry.addButton(
                    'tgvMediaLibrary',
                    {
                        text: 'Photos',

                        onAction: function ()
                        {
                            openEditorMediaPicker(editor);
                        }
                    });

                editor.ui.registry.addButton(
                    'tgvVideo',
                    {
                        text: 'Video',

                        onAction: function ()
                        {
                            openVideoModal(editor);
                        }
                    });
            }
        });

    </script>
   
 
    <script>

        document.addEventListener("DOMContentLoaded", () => {

            const openBtn =
                document.getElementById("open-media-picker");

            const closeBtn =
                document.getElementById("close-media-picker");

            const modal =
                document.getElementById("media-picker-modal");

            const featuredSelect =
                document.getElementById("featured-image-select");

            const searchInput =
                document.getElementById("media-search");

            if (!openBtn || !modal || !featuredSelect)
                return;

            // Open Modal

            openBtn.addEventListener("click", () => {

                modal.classList.remove("hidden");

            });

            // Close Modal Button

            if (closeBtn) {

                closeBtn.addEventListener("click", () => {

                    modal.classList.add("hidden");

                });

            }

            // Close Modal on Backdrop Click

            modal.addEventListener("click", (e) => {

                if (e.target === modal) {

                    modal.classList.add("hidden");

                }

            });

            // Image Selection

            document
                .querySelectorAll(".media-item")
                .forEach(item => {

                    item.addEventListener("click", () => {

                        document
                            .querySelectorAll(".media-item")
                            .forEach(x =>
                                x.classList.remove(
                                    "border-primary"));

                        item.classList.add(
                            "border-primary");

                        const mediaId =
                            item.dataset.id;

                        console.log(
                            "Selected Media:",
                            mediaId);

                        featuredSelect.value =
                            mediaId;

                        featuredSelect.dispatchEvent(
                            new Event("change", {
                                bubbles: true
                            }));

                        modal.classList.add("hidden");

                    });

                });

            // Search

            if (searchInput) {

                searchInput.addEventListener("input", () => {

                    const term =
                        searchInput.value
                            .toLowerCase()
                            .trim();

                    document
                        .querySelectorAll(".media-item")
                        .forEach(item => {

                            const name =
                                (item.dataset.name || "")
                                    .toLowerCase();

                            if (name.includes(term)) {

                                item.classList.remove(
                                    "hidden");

                            }
                            else {

                                item.classList.add(
                                    "hidden");

                            }

                        });

                });

            }

        });

    </script>
    <script>

        document.addEventListener("DOMContentLoaded", () => {

            const addVideoBtn =
                document.getElementById(
                    "add-video-btn");

            const videoContainer =
                document.getElementById(
                    "video-container");

            let videoIndex =
                videoContainer
                    .querySelectorAll(".video-item")
                    .length;

            addVideoBtn.addEventListener(
                "click",
                () =>
                {
                    const html = `
                    <div class="video-item mb-4 rounded-xl border p-4">

                        <input
                            name="Videos[${videoIndex}].Title"
                            placeholder="Video Title"
                            class="mb-3 w-full rounded-lg border px-4 py-3" />

                        <input
                            name="Videos[${videoIndex}].VideoUrl"
                            placeholder="https://youtube.com/..."
                            class="w-full rounded-lg border px-4 py-3" />

                    </div>
                    `;

                    videoContainer
                        .insertAdjacentHTML(
                            "beforeend",
                            html);

                    videoIndex++;
                });

        });

    </script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const select =
                document.getElementById(
                    "avatar-image-select");

            const image =
                document.getElementById(
                    "avatar-preview-image");

            const placeholder =
                document.getElementById(
                    "avatar-preview-placeholder");

            function updatePreview() {

                const option =
                    select.options[
                        select.selectedIndex];

                const imagePath =
                    option.dataset.image;

                if (!imagePath) {

                    image.classList.add("hidden");
                    placeholder.classList.remove("hidden");

                    return;
                }

                image.src = imagePath;

                image.classList.remove("hidden");

                placeholder.classList.add("hidden");
            }

            select.addEventListener(
                "change",
                updatePreview);

            updatePreview();

        });
    </script>
</body>
</html>