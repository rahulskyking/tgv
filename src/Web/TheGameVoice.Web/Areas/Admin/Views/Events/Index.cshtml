@model IReadOnlyList<TheGameVoice.Domain.Entities.GamingEvent>
@{ ViewData["Title"] = "Events"; }
<div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div><h1 class="text-fluid-3xl font-bold">Events</h1><p class="mt-2 text-ink-muted">Manage event hubs, banners, and navigation visibility.</p></div>
        <a asp-action="Create" class="rounded-lg bg-primary px-5 py-3 font-bold text-white">Create event</a>
    </div>
    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-default bg-surface p-8">No events yet. Create your first event, then assign articles from the article editor.</div>
    }
    else
    {
        <div class="overflow-x-auto rounded-2xl border border-default bg-surface">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-default"><tr><th class="p-4">Event</th><th class="p-4">Status</th><th class="p-4">Navigation</th><th class="p-4">Actions</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="border-b border-default">
                            <td class="p-4"><strong>@item.Name</strong><div class="mt-1 text-ink-muted">/events/@item.Slug</div></td>
                            <td class="p-4">@(item.IsActive ? "Active" : "Archived")</td>
                            <td class="p-4">@(item.IsActive && item.ShowInNavigation ? "Visible" : "Hidden") <span class="text-ink-muted">· @item.DisplayOrder</span></td>
                            <td class="p-4">
                                <div class="flex flex-wrap items-center gap-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="font-semibold text-primary">Edit</a>
                                    <a asp-area="" asp-controller="Events" asp-action="Details" asp-route-slug="@item.Slug" class="font-semibold text-primary">View</a>
                                    <form asp-action="SetActive" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="isActive" value="@((!item.IsActive).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="font-semibold underline">@(item.IsActive ? "Archive" : "Reactivate")</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <p class="text-sm text-ink-muted">Archiving hides an event from navigation, not from the web. No articles are deleted or unassigned.</p>
</div>
