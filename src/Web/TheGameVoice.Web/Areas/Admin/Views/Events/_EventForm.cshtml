@model TheGameVoice.Web.Areas.Admin.ViewModels.Events.EventFormViewModel

<div asp-validation-summary="All" class="text-sm text-red-600" role="alert"></div>
@if (Model.Id.HasValue)
{
    <input asp-for="Id" type="hidden" />
}
<div class="grid gap-6 lg:grid-cols-2">
    <section class="space-y-5 rounded-2xl border border-default bg-surface p-6">
        <h2 class="text-xl font-bold">Event details</h2>
        <div>
            <label asp-for="Name" class="mb-2 block font-medium"></label>
            <input asp-for="Name" class="w-full rounded-lg border border-default bg-surface px-4 py-3" />
            <span asp-validation-for="Name" class="text-sm text-red-600"></span>
        </div>
        <div>
            <label asp-for="Slug" class="mb-2 block font-medium">URL slug</label>
            <input asp-for="Slug" readonly="@(Model.Id.HasValue ? "readonly" : null)" class="w-full rounded-lg border border-default bg-surface px-4 py-3" />
            <p class="mt-2 text-sm text-ink-muted">Example: igdc-2026 → /events/igdc-2026. The URL stays fixed after creation.</p>
            <span asp-validation-for="Slug" class="text-sm text-red-600"></span>
        </div>
        <div>
            <label asp-for="Description" class="mb-2 block font-medium"></label>
            <textarea asp-for="Description" rows="5" class="w-full rounded-lg border border-default bg-surface px-4 py-3"></textarea>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="StartDate" class="mb-2 block font-medium"></label>
                <input asp-for="StartDate" type="date" asp-format="{0:yyyy-MM-dd}" class="w-full rounded-lg border border-default bg-surface px-4 py-3" />
            </div>
            <div>
                <label asp-for="EndDate" class="mb-2 block font-medium"></label>
                <input asp-for="EndDate" type="date" asp-format="{0:yyyy-MM-dd}" class="w-full rounded-lg border border-default bg-surface px-4 py-3" />
                <span asp-validation-for="EndDate" class="text-sm text-red-600"></span>
            </div>
        </div>
        <div>
            <label asp-for="Location" class="mb-2 block font-medium"></label>
            <input asp-for="Location" placeholder="Venue, city, or Online" class="w-full rounded-lg border border-default bg-surface px-4 py-3" />
        </div>
        <div>
            <label asp-for="OfficialWebsite" class="mb-2 block font-medium"></label>
            <input asp-for="OfficialWebsite" type="url" placeholder="https://…" class="w-full rounded-lg border border-default bg-surface px-4 py-3" />
            <span asp-validation-for="OfficialWebsite" class="text-sm text-red-600"></span>
        </div>
    </section>
    <div class="space-y-6">
        <section class="space-y-5 rounded-2xl border border-default bg-surface p-6">
            <h2 class="text-xl font-bold">Landing-page banner</h2>
            <p class="text-sm text-ink-muted">Select an image from your media library. Upload new banners under Admin → Media first. A wide landscape image works best.</p>
            <div>
                <label asp-for="BannerImageId" class="mb-2 block font-medium"></label>
                <select asp-for="BannerImageId" class="w-full rounded-lg border border-default bg-surface px-4 py-3">
                    <option value="">No banner (use default header)</option>
                    @foreach (var image in Model.BannerImages)
                    {
                        <option value="@image.Id" data-image-url="@image.FilePath">@image.FileName</option>
                    }
                </select>
                <span asp-validation-for="BannerImageId" class="text-sm text-red-600"></span>
            </div>
            <img id="event-banner-preview" alt="Selected event banner preview" class="hidden aspect-[16/9] w-full rounded-xl object-cover" />
            <div>
                <label asp-for="BannerAltText" class="mb-2 block font-medium"></label>
                <input asp-for="BannerAltText" class="w-full rounded-lg border border-default bg-surface px-4 py-3" />
                <span asp-validation-for="BannerAltText" class="text-sm text-red-600"></span>
            </div>
        </section>
        <section class="space-y-5 rounded-2xl border border-default bg-surface p-6">
            <h2 class="text-xl font-bold">Visibility</h2>
            <label class="flex items-center gap-3"><input asp-for="IsActive" class="h-5 w-5" /> Active event</label>
            <p class="text-sm text-ink-muted">Uncheck to archive. The landing page, articles, and assignments remain available. Dates do not automatically archive an event.</p>
            <label class="flex items-center gap-3"><input asp-for="ShowInNavigation" class="h-5 w-5" /> Show event name in navigation</label>
            <p class="text-sm text-ink-muted">Only active events appear in navigation. This preference is remembered when archived.</p>
            <div>
                <label asp-for="DisplayOrder" class="mb-2 block font-medium"></label>
                <input asp-for="DisplayOrder" type="number" min="0" max="9999" class="w-full rounded-lg border border-default bg-surface px-4 py-3" />
                <p class="mt-2 text-sm text-ink-muted">Lower numbers appear first.</p>
            </div>
        </section>
    </div>
</div>
<div class="flex flex-wrap gap-3">
    <button type="submit" class="rounded-lg bg-primary px-6 py-3 font-bold text-white">Save event</button>
    <a asp-action="Index" class="rounded-lg border border-default px-6 py-3">Cancel</a>
</div>
<script>
    (function () {
        const name = document.getElementById('Name');
        const slug = document.getElementById('Slug');
        if (name && slug && !slug.readOnly) {
            let manuallyEdited = slug.value.length > 0;
            slug.addEventListener('input', () => { manuallyEdited = true; });
            name.addEventListener('input', () => {
                if (!manuallyEdited) slug.value = name.value.toLowerCase()
                    .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 200).replace(/-+$/g, '');
            });
        }
        const select = document.getElementById('BannerImageId');
        const preview = document.getElementById('event-banner-preview');
        if (!select || !preview) return;
        function updatePreview() {
            const url = select.selectedOptions[0]?.dataset.imageUrl;
            preview.classList.toggle('hidden', !url);
            if (url) preview.src = url;
            else preview.removeAttribute('src');
        }
        select.addEventListener('change', updatePreview);
        updatePreview();
    })();
</script>
