@{
    ViewData["Title"] = "Review Policy";
}


<div class="bg-slate-50">

    <div class="tgv-container py-24">

        <div class="mx-auto max-w-3xl text-center">

            <span class="text-sm font-bold uppercase tracking-[0.2em] text-primary">

                REVIEW SCALE

            </span>

            <h2 class="mt-5 text-4xl font-black text-slate-900 md:text-5xl">

                Understanding Our Scores

            </h2>

            <p class="mt-6 text-lg leading-8 text-slate-600">

                Every score reflects our overall experience after considering
                gameplay, story, presentation, technical performance and value.
                The number summarizes the review, but the written review always
                provides the complete picture.

            </p>

        </div>

        <div class="mt-16 space-y-5">

            @{
                var reviewScale = new[]
                {
                        new { Score = 10, Title = "Masterpiece", Color = "bg-emerald-600", Description = "Redefines what games can be, delivering an unforgettable experience that will be remembered for years." },

                        new { Score = 9, Title = "Amazing", Color = "bg-emerald-500", Description = "Nearly flawless, exceptional in almost every aspect and an easy recommendation." },

                        new { Score = 8, Title = "Great", Color = "bg-lime-500", Description = "A genuinely impressive experience with only minor shortcomings." },

                        new { Score = 7, Title = "Good", Color = "bg-green-500", Description = "Solid and enjoyable, delivering exactly what it promises." },

                        new { Score = 6, Title = "Fair", Color = "bg-yellow-500", Description = "Has enjoyable moments but notable flaws prevent it from reaching its full potential." },

                        new { Score = 5, Title = "Average", Color = "bg-amber-500", Description = "Competent but forgettable, doing the basics without leaving a lasting impression." },

                        new { Score = 4, Title = "Bad", Color = "bg-orange-500", Description = "Weak execution and significant issues make it difficult to recommend." },

                        new { Score = 3, Title = "Poor", Color = "bg-red-500", Description = "Technical problems and poor design overshadow the overall experience." },

                        new { Score = 2, Title = "Awful", Color = "bg-red-600", Description = "Frustrating from beginning to end with very few redeeming qualities." },

                        new { Score = 1, Title = "Worst", Color = "bg-red-700", Description = "Fundamentally broken or exceptionally poor. We cannot recommend it." }
                        };
            }

            @foreach (var item in reviewScale)
            {
                <div class="flex flex-col gap-5 rounded-3xl border border-default bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl md:flex-row md:items-center">

                    <div class="@item.Color flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl text-3xl font-black text-white">

                        @item.Score

                    </div>

                    <div class="flex-1">

                        <div class="flex flex-wrap items-center gap-3">

                            <h3 class="text-2xl font-black text-slate-900">

                                @item.Title

                            </h3>

                        </div>

                        <p class="mt-3 text-lg leading-8 text-slate-600">

                            @item.Description

                        </p>

                    </div>

                </div>
            }

        </div>

    </div>

</div>
<div class="tgv-container py-20">

    <div class="grid gap-16 lg:grid-cols-2">

        <div>

            <span class="text-sm font-bold uppercase tracking-[0.2em] text-primary">

                OUR PHILOSOPHY

            </span>

            <h2 class="mt-5 text-4xl font-black text-slate-900">

                Reviews Written
                For Players.

            </h2>

            <p class="mt-8 text-lg leading-8 text-slate-600">

                We review games based on the complete experience they provide.
                Every title is judged on its own ambitions, execution and value,
                not by marketing promises or publisher expectations.

            </p>

            <p class="mt-6 text-lg leading-8 text-slate-600">

                Whenever possible, we complete the main experience before
                publishing a review and spend enough time exploring the game’s
                systems to provide meaningful impressions.

            </p>

        </div>

        <div class="grid gap-6 sm:grid-cols-2">

            <div class="rounded-3xl border border-default bg-white p-8 shadow-sm">

                <h3 class="text-xl font-bold">

                    Gameplay

                </h3>

                <p class="mt-4 text-slate-600">

                    Controls, mechanics, progression and overall fun.

                </p>

            </div>

            <div class="rounded-3xl border border-default bg-white p-8 shadow-sm">

                <h3 class="text-xl font-bold">

                    Story

                </h3>

                <p class="mt-4 text-slate-600">

                    Narrative, characters and world building.

                </p>

            </div>

            <div class="rounded-3xl border border-default bg-white p-8 shadow-sm">

                <h3 class="text-xl font-bold">

                    Technical Quality

                </h3>

                <p class="mt-4 text-slate-600">

                    Performance, bugs, stability and optimization.

                </p>

            </div>

            <div class="rounded-3xl border border-default bg-white p-8 shadow-sm">

                <h3 class="text-xl font-bold">

                    Value

                </h3>

                <p class="mt-4 text-slate-600">

                    Content, replayability and price.

                </p>

            </div>

        </div>

    </div>

</div>
