@{
    ViewData["Title"] = "About";
}

<div class="bg-gradient-to-b from-[#f8f5ff] to-white">

    <div class="tgv-container py-24">

        <div class="mx-auto max-w-5xl text-center">

            <span class="inline-flex rounded-full bg-primary/10 px-5 py-2 text-sm font-semibold uppercase tracking-wider text-primary">

                About TheGameVoice

            </span>

            <h1 class="mt-8 text-5xl font-black tracking-tight text-slate-900 md:text-6xl">

                Honest Gaming Journalism,
                Built for Players.

            </h1>

            <p class="mx-auto mt-8 max-w-3xl text-xl leading-9 text-slate-600">

                TheGameVoice is an independent gaming publication focused on
                delivering trustworthy reviews, breaking news, thoughtful
                features and comprehensive game coverage for players across
                every platform.

            </p>

        </div>

    </div>

</div>
<div class="tgv-container py-20">

    <div class="grid gap-16 lg:grid-cols-2">

        <div>

            <span class="text-sm font-bold uppercase tracking-[0.2em] text-primary">

                WHO WE ARE

            </span>

            <h2 class="mt-4 text-4xl font-black text-slate-900">

                Passionate About Games.
                Serious About Journalism.

            </h2>

            <p class="mt-8 text-lg leading-8 text-slate-600">

                TheGameVoice was created with one simple goal:
                to provide gamers with honest, reliable and engaging
                editorial content.

            </p>

            <p class="mt-6 text-lg leading-8 text-slate-600">

                We believe readers deserve transparent reviews,
                timely news coverage and thoughtful analysis free
                from unnecessary hype or outside influence.

            </p>

        </div>

        <div class="grid gap-6 sm:grid-cols-2">

            <div class="rounded-3xl border border-default bg-white p-8 shadow-sm">

                <div class="text-4xl">📰</div>

                <h3 class="mt-5 text-xl font-bold">

                    News

                </h3>

                <p class="mt-3 text-slate-600">

                    Breaking announcements,
                    updates and industry news.

                </p>

            </div>

            <div class="rounded-3xl border border-default bg-white p-8 shadow-sm">

                <div class="text-4xl">⭐</div>

                <h3 class="mt-5 text-xl font-bold">

                    Reviews

                </h3>

                <p class="mt-3 text-slate-600">

                    Honest reviews with transparent scoring.

                </p>

            </div>

            <div class="rounded-3xl border border-default bg-white p-8 shadow-sm">

                <div class="text-4xl">🎮</div>

                <h3 class="mt-5 text-xl font-bold">

                    Games

                </h3>

                <p class="mt-3 text-slate-600">

                    Dedicated game hubs with complete information.

                </p>

            </div>

            <div class="rounded-3xl border border-default bg-white p-8 shadow-sm">

                <div class="text-4xl">📖</div>

                <h3 class="mt-5 text-xl font-bold">

                    Features

                </h3>

                <p class="mt-3 text-slate-600">

                    Deep dives, editorials,
                    interviews and analysis.

                </p>

            </div>

        </div>

    </div>

</div>
<div class="bg-slate-50">

    <div class="tgv-container py-24">

        <div class="mx-auto max-w-3xl text-center">

            <span class="text-sm font-bold uppercase tracking-[0.2em] text-primary">

                OUR MISSION

            </span>

            <h2 class="mt-5 text-4xl font-black text-slate-900 md:text-5xl">

                Building Trust Through
                Honest Gaming Coverage

            </h2>

            <p class="mt-6 text-lg leading-8 text-slate-600">

                We believe gaming journalism should inform, educate and help
                players make better decisions. Every article is written with
                accuracy, transparency and respect for our readers.

            </p>

        </div>

        <div class="mt-16 grid gap-8 md:grid-cols-2 xl:grid-cols-4">

            <!-- Accuracy -->

            <div class="rounded-3xl border border-default bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-2 hover:shadow-xl">

                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-3xl">

                    🎯

                </div>

                <h3 class="mt-6 text-2xl font-bold text-slate-900">

                    Accuracy

                </h3>

                <p class="mt-4 leading-7 text-slate-600">

                    We verify facts, confirm sources and prioritize accuracy
                    before publishing.

                </p>

            </div>

            <!-- Integrity -->

            <div class="rounded-3xl border border-default bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-2 hover:shadow-xl">

                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-3xl">

                    🛡️

                </div>

                <h3 class="mt-6 text-2xl font-bold text-slate-900">

                    Integrity

                </h3>

                <p class="mt-4 leading-7 text-slate-600">

                    Reviews and opinions reflect our genuine experience,
                    never outside influence.

                </p>

            </div>

            <!-- Independence -->

            <div class="rounded-3xl border border-default bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-2 hover:shadow-xl">

                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-3xl">

                    ⚖️

                </div>

                <h3 class="mt-6 text-2xl font-bold text-slate-900">

                    Independence

                </h3>

                <p class="mt-4 leading-7 text-slate-600">

                    Editorial decisions are made independently without
                    pressure from publishers or advertisers.

                </p>

            </div>

            <!-- Community -->

            <div class="rounded-3xl border border-default bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-2 hover:shadow-xl">

                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-3xl">

                    ❤️

                </div>

                <h3 class="mt-6 text-2xl font-bold text-slate-900">

                    Community

                </h3>

                <p class="mt-4 leading-7 text-slate-600">

                    Our readers are at the center of everything we publish,
                    and their trust is our greatest responsibility.

                </p>

            </div>

        </div>

    </div>

</div>