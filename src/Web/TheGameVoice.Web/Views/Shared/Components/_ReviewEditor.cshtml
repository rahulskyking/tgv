@model TheGameVoice.Web.Areas.Admin.ViewModels.Articles.ArticleFormViewModel

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

    <!-- Header -->
    <div class="border-b border-slate-200 bg-slate-50/50 px-6 py-5 sm:px-8">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-lg font-semibold text-slate-900">
                    Review Configuration
                </h2>
                <p class="mt-1 text-sm text-slate-500">
                    Enable to add a review score, verdict, and pros/cons list.
                </p>
            </div>

            <!-- Modern Toggle Switch -->
            <label class="relative inline-flex cursor-pointer items-center">
                <input asp-for="IsReview" type="checkbox" id="is-review-checkbox" class="peer sr-only" />
                <div class="h-6 w-11 rounded-full bg-slate-200 transition-colors after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-slate-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-[#7c3aed] peer-checked:after:translate-x-full peer-checked:after:border-white peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-[#7c3aed]/20"></div>
            </label>
        </div>
    </div>

    <div id="review-editor" class="@(Model.IsReview ? "" : "hidden") space-y-8 p-6 sm:p-8">

        <!-- Top Grid: Score & Verdict -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">

            <!-- Review Score -->
            <div>
                <div class="mb-1.5 flex items-center gap-2">
                    <label asp-for="ReviewScore" class="text-sm font-semibold text-slate-700">
                        Review Score
                    </label>

                    <button type="button"
                            id="review-score-info-btn"
                            class="flex h-5 w-5 items-center justify-center rounded-full border border-slate-300 text-xs font-bold text-slate-500 transition hover:border-primary hover:text-primary">
                        i
                    </button>
                </div>

                <div class="relative">
                    <input asp-for="ReviewScore"
                           id="review-score"
                           type="number"
                           step="0.1"
                           min="1"
                           max="10"
                           placeholder="e.g. 8.5"
                           class="block w-full rounded-lg border-0 py-2.5 pl-4 pr-12 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-[#7c3aed] sm:text-sm sm:leading-6" />

                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
                        <span class="text-slate-400 sm:text-sm font-medium">/ 10</span>
                    </div>
                </div>

                <span asp-validation-for="ReviewScore" class="mt-1.5 flex text-xs font-medium text-red-500"></span>
            </div>

            <!-- Verdict -->
            <div>
                <label asp-for="ReviewVerdict" class="mb-1.5 block text-sm font-semibold text-slate-700">
                    Verdict
                </label>

                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                        Review Verdict
                    </p>

                    <p id="review-verdict" class="mt-2 text-xl font-bold text-[#7c3aed]">
                        @(Model.ReviewVerdict?.ToString() ?? "-")
                    </p>
                </div>

                <span asp-validation-for="ReviewVerdict" class="mt-1.5 flex text-xs font-medium text-red-500"></span>
            </div>
        </div>

        <!-- Summary -->
        <div>
            <div class="mb-1.5 flex items-end justify-between">
                <label asp-for="ReviewSummary" class="block text-sm font-semibold text-slate-700">
                    Review Summary
                </label>

                <span class="text-xs font-medium text-slate-400" id="summary-counter">
                    0 / 500
                </span>
            </div>

            <textarea asp-for="ReviewSummary"
                      id="review-summary"
                      rows="4"
                      maxlength="500"
                      placeholder="Briefly summarize the final thoughts..."
                      class="block w-full rounded-lg border-0 px-4 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-[#7c3aed] sm:text-sm sm:leading-6"></textarea>

            <span asp-validation-for="ReviewSummary" class="mt-1.5 flex text-xs font-medium text-red-500"></span>
        </div>

        <!-- Pros & Cons Grids -->
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">

            <!-- Pros -->
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
                <div class="mb-4 flex items-center justify-between border-b border-slate-200 pb-3">
                    <div class="flex items-center gap-2">
                        <div class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                            </svg>
                        </div>

                        <h3 class="text-sm font-bold text-slate-800">The Good</h3>
                    </div>

                    <button type="button"
                            id="add-good-point"
                            class="inline-flex items-center gap-1 rounded-lg bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 shadow-sm ring-1 ring-inset ring-slate-300 transition-colors hover:bg-slate-50 hover:text-emerald-600">
                        Add Pro
                    </button>
                </div>

                <div id="good-points" class="space-y-3">
                    @for (var i = 0; i < Model.GoodReviewPoints.Count; i++)
                    {
                        <div class="list-item-row flex items-center gap-2">
                            <input asp-for="GoodReviewPoints[i]"
                                   placeholder="e.g. Stunning graphics"
                                   class="block w-full rounded-lg border-0 px-3 py-2 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-emerald-500 sm:text-sm" />

                            <button type="button"
                                    class="remove-row flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-red-50 hover:text-red-500"
                                    data-list="good">
                                <svg class="pointer-events-none h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Cons -->
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
                <div class="mb-4 flex items-center justify-between border-b border-slate-200 pb-3">
                    <div class="flex items-center gap-2">
                        <div class="flex h-6 w-6 items-center justify-center rounded-full bg-red-100 text-red-600">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" />
                            </svg>
                        </div>

                        <h3 class="text-sm font-bold text-slate-800">The Bad</h3>
                    </div>

                    <button type="button"
                            id="add-bad-point"
                            class="inline-flex items-center gap-1 rounded-lg bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 shadow-sm ring-1 ring-inset ring-slate-300 transition-colors hover:bg-slate-50 hover:text-red-600">
                        Add Con
                    </button>
                </div>

                <div id="bad-points" class="space-y-3">
                    @for (var i = 0; i < Model.BadReviewPoints.Count; i++)
                    {
                        <div class="list-item-row flex items-center gap-2">
                            <input asp-for="BadReviewPoints[i]"
                                   placeholder="e.g. Frame rate drops"
                                   class="block w-full rounded-lg border-0 px-3 py-2 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-red-500 sm:text-sm" />

                            <button type="button"
                                    class="remove-row flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-red-50 hover:text-red-500"
                                    data-list="bad">
                                <svg class="pointer-events-none h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Review Score Modal -->
<div id="review-score-modal"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">

    <div class="max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-2xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">
            <h2 class="text-xl font-bold">
                Review Score Guide
            </h2>

            <button type="button"
                    id="close-review-score-modal"
                    class="text-3xl text-slate-400 hover:text-red-500">
                ×
            </button>
        </div>

        <div class="space-y-4 p-6">
            @{
                var scores = new[]
                {
                        new { Score = "10", Title = "Masterpiece", Color = "bg-emerald-600", Text = "Redefines what games can be. A landmark experience." },
                        new { Score = "9", Title = "Amazing", Color = "bg-emerald-500", Text = "Nearly flawless. Exceptional from beginning to end." },
                        new { Score = "8", Title = "Great", Color = "bg-lime-500", Text = "Highly recommended with only minor flaws." },
                        new { Score = "7", Title = "Good", Color = "bg-green-500", Text = "Solid and enjoyable throughout." },
                        new { Score = "6", Title = "Fair", Color = "bg-yellow-500", Text = "Enjoyable but held back by noticeable issues." },
                        new { Score = "5", Title = "Average", Color = "bg-amber-500", Text = "Perfectly acceptable but forgettable." },
                        new { Score = "4", Title = "Bad", Color = "bg-orange-500", Text = "Weak execution outweighs the positives." },
                        new { Score = "3", Title = "Poor", Color = "bg-red-500", Text = "Serious design or technical problems." },
                        new { Score = "2", Title = "Awful", Color = "bg-red-600", Text = "Frustrating and difficult to recommend." },
                        new { Score = "1", Title = "Worst", Color = "bg-red-700", Text = "Fundamentally broken or exceptionally poor." }
                        };
            }

            @foreach (var item in scores)
            {
                <div class="flex items-center gap-4 rounded-xl border border-slate-200 p-4">
                    <div class="@item.Color flex h-12 w-12 items-center justify-center rounded-xl font-bold text-white">
                        @item.Score
                    </div>

                    <div>
                        <div class="font-bold">
                            @item.Title
                        </div>

                        <div class="text-sm text-slate-600">
                            @item.Text
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        // --- 1. Toggle Editor Visibility ---
        const reviewCheckbox = document.getElementById("is-review-checkbox");
        const reviewEditor = document.getElementById("review-editor");

        function toggleReviewEditor() {
            if (!reviewCheckbox || !reviewEditor) return;

            if (reviewCheckbox.checked) {
                reviewEditor.classList.remove("hidden");
            } else {
                reviewEditor.classList.add("hidden");
            }
        }

        if (reviewCheckbox) {
            reviewCheckbox.addEventListener("change", toggleReviewEditor);
            toggleReviewEditor();
        }

        // --- 2. Live Character Counter ---
        const summaryInput = document.getElementById("review-summary");
        const summaryCounter = document.getElementById("summary-counter");

        if (summaryInput && summaryCounter) {
            const updateCounter = () => {
                summaryCounter.textContent = `${summaryInput.value.length} / 500`;
            };

            summaryInput.addEventListener("input", updateCounter);
            updateCounter();
        }

        // --- 3. Dynamic Form Lists ---
        // This prevents ASP.NET Core model binding from breaking when a middle item is deleted.
        function reindexList(containerId, listPrefix) {
            const container = document.getElementById(containerId);
            if (!container) return;

            const inputs = container.querySelectorAll("input");

            inputs.forEach((input, index) => {
                input.name = `${listPrefix}[${index}]`;
                input.id = `${listPrefix}_${index}_`;
            });
        }

        function addRow(containerId, listPrefix, placeholder, focusColor, dataListType) {
            const container = document.getElementById(containerId);
            if (!container) return;

            const index = container.querySelectorAll("input").length;

            const html = `
                <div class="list-item-row flex items-center gap-2">
                    <input name="${listPrefix}[${index}]"
                           id="${listPrefix}_${index}_"
                           placeholder="${placeholder}"
                           class="block w-full rounded-lg border-0 px-3 py-2 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-${focusColor}-500 sm:text-sm" />

                    <button type="button"
                            class="remove-row flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-red-50 hover:text-red-500"
                            data-list="${dataListType}">
                        <svg class="pointer-events-none h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>`;

            container.insertAdjacentHTML("beforeend", html);
            container.lastElementChild.querySelector("input").focus();
        }

        const addGoodPointBtn = document.getElementById("add-good-point");
        const addBadPointBtn = document.getElementById("add-bad-point");

        if (addGoodPointBtn) {
            addGoodPointBtn.addEventListener("click", () => {
                addRow("good-points", "GoodReviewPoints", "e.g. Stunning graphics", "emerald", "good");
            });
        }

        if (addBadPointBtn) {
            addBadPointBtn.addEventListener("click", () => {
                addRow("bad-points", "BadReviewPoints", "e.g. Frame rate drops", "red", "bad");
            });
        }

        // Event delegation for deleting rows
        document.addEventListener("click", function (e) {
            const btn = e.target.closest(".remove-row");
            if (!btn) return;

            const row = btn.closest(".list-item-row");
            const listType = btn.getAttribute("data-list");

            if (row) {
                row.remove();

                if (listType === "good") {
                    reindexList("good-points", "GoodReviewPoints");
                } else if (listType === "bad") {
                    reindexList("bad-points", "BadReviewPoints");
                }
            }
        });

        // --- 4. Review Verdict ---
        const scoreInput = document.getElementById("review-score");
        const verdict = document.getElementById("review-verdict");

        function updateVerdict() {
            if (!scoreInput || !verdict) return;

            const score = parseFloat(scoreInput.value);

            if (isNaN(score)) {
                verdict.innerText = "-";
                return;
            }

            if (score >= 9.5) {
                verdict.innerText = "Masterpiece";
            } else if (score >= 8.5) {
                verdict.innerText = "Amazing";
            } else if (score >= 7.5) {
                verdict.innerText = "Great";
            } else if (score >= 6.5) {
                verdict.innerText = "Good";
            } else if (score >= 5.5) {
                verdict.innerText = "Fair";
            } else if (score >= 4.5) {
                verdict.innerText = "Average";
            } else if (score >= 3.5) {
                verdict.innerText = "Bad";
            } else if (score >= 2.5) {
                verdict.innerText = "Poor";
            } else if (score >= 1.5) {
                verdict.innerText = "Awful";
            } else {
                verdict.innerText = "Worst";
            }
        }

        if (scoreInput) {
            scoreInput.addEventListener("input", updateVerdict);
            updateVerdict();
        }

        // --- 5. Review Score Modal ---
        const infoBtn = document.getElementById("review-score-info-btn");
        const modal = document.getElementById("review-score-modal");
        const closeBtn = document.getElementById("close-review-score-modal");

        if (infoBtn && modal) {
            infoBtn.addEventListener("click", () => {
                modal.classList.remove("hidden");
                modal.classList.add("flex");
            });
        }

        if (closeBtn && modal) {
            closeBtn.addEventListener("click", () => {
                modal.classList.remove("flex");
                modal.classList.add("hidden");
            });
        }

        if (modal) {
            modal.addEventListener("click", function (e) {
                if (e.target === modal) {
                    modal.classList.remove("flex");
                    modal.classList.add("hidden");
                }
            });
        }
    });
</script>