@model TheGameVoice.Domain.Entities.Article

<a asp-controller="News"
   asp-action="Details"
   asp-route-slug="@Model.Slug"
   class="group flex items-start gap-4 border-b border-slate-200 pb-5">

    @if (Model.FeaturedImage != null)
    {
        <div class="h-20 w-32 shrink-0 overflow-hidden rounded-lg border border-slate-200">

            <img src="@Model.FeaturedImage.FilePath"
                 alt="@Model.Title"
                 class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />

        </div>
    }

    <div class="min-w-0 flex-1">

        @if (Model.Category != null)
        {
            <div class="mb-2 text-[11px] font-bold uppercase tracking-[0.15em] text-primary">

                @Model.Category.Name

            </div>
        }

        <h3 class="line-clamp-3 text-sm font-semibold leading-snug text-slate-900 transition group-hover:text-primary">

            @Model.Title

        </h3>

        <div class="mt-2 text-xs text-slate-500">

            @(Model.PublishedAt?
                        .ToLocalTime()
                        .ToString("dd MMM yyyy"))

        </div>

    </div>

</a>