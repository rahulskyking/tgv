@model TheGameVoice.Domain.Entities.Article

<a asp-controller="News"
   asp-action="Details"
   asp-route-slug="@Model.Slug"
   class="group block overflow-hidden rounded-2xl border border-default bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">


    @if (Model.FeaturedImage != null)
    {
        <div class="aspect-[16/9] overflow-hidden">

            <img src="@Model.FeaturedImage.FilePath"
                 alt="@Model.Title"
                 class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />

        </div>
    }

    <div class="p-5">

        <div class="mb-3 flex items-center gap-2 text-xs">

            @if (Model.Category != null)
            {
                <span class="font-semibold uppercase tracking-[0.12em] text-primary">
                    @Model.Category.Name
                </span>
            }

            <span class="text-muted">•</span>

            <span class="text-muted">
                @(Model.PublishedAt?.ToLocalTime().ToString("dd MMM yyyy"))
            </span>

        </div>

        <h3 class="line-clamp-3 text-xl font-bold leading-tight text-slate-900 transition group-hover:text-primary">

            @Model.Title

        </h3>

        @if (!string.IsNullOrWhiteSpace(Model.Summary))
        {
            <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted">

                @Model.Summary

            </p>
        }

    </div>


</a>
