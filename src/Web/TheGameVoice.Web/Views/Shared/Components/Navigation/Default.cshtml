@model TheGameVoice.Web.ViewModels.Shared.NavigationViewModel
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentSlug = ViewContext.RouteData.Values["slug"]?.ToString();
}

<header class="tgv-site-header sticky top-0 z-50 border-b border-line bg-surface" data-site-header>
    <div class="tgv-container">
        <div class="tgv-nav-desktop hidden lg:grid">
            <a asp-controller="Home" asp-action="Index" class="tgv-nav-brand">TheGameVoice</a>

            @* One category block: compress gently before wrapping; never send overflow to a second bar. *@
            <nav aria-label="Categories" class="tgv-nav-categories" data-category-nav>
                @foreach (var category in Model.Categories)
                {
                    var active = currentController == "Categories" && string.Equals(currentSlug, category.Slug, StringComparison.OrdinalIgnoreCase);
                    <a asp-controller="Categories" asp-action="Details" asp-route-slug="@category.Slug"
                       aria-current="@(active ? "page" : null)" class="tgv-nav-category">@category.Name</a>
                }
            </nav>

            <div class="tgv-nav-tools">
                @* The existing site-mode toggle remains intentionally hidden. *@
                <form asp-controller="Search" asp-action="Index" method="get" role="search">
                    <label for="desktop-nav-search" class="sr-only">Search articles</label>
                    <div class="tgv-nav-search">
                        <input id="desktop-nav-search" type="search" name="query" placeholder="Search articles…" />
                        <button type="submit" aria-label="Search articles">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
                        </button>
                    </div>
                </form>
                <partial name="~/Views/Shared/Components/_ThemeToggle.cshtml" />
            </div>
        </div>

        <div class="flex min-h-16 items-center justify-between gap-3 py-2 lg:hidden">
            <a asp-controller="Home" asp-action="Index" class="tgv-nav-brand">TheGameVoice</a>
            <div class="flex shrink-0 items-center gap-2">
                <partial name="~/Views/Shared/Components/_ThemeToggle.cshtml" />
                <button id="mobile-menu-button" type="button" aria-label="Open navigation menu"
                        aria-controls="mobile-menu-overlay" aria-expanded="false" aria-haspopup="dialog" class="tgv-nav-menu-button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                </button>
            </div>
        </div>
    </div>

    @* Event names live only in this dedicated desktop row and the mobile menu. *@
    @if (Model.Events.Any())
    {
        <div class="tgv-events-bar hidden lg:block">
            <div class="tgv-container tgv-events-inner">
                <span class="tgv-events-label"><span class="tgv-events-marker" aria-hidden="true"></span>Events</span>
                <nav aria-label="Event coverage" class="tgv-events-links">
                    @foreach (var gamingEvent in Model.Events)
                    {
                        var active = currentController == "Events" && string.Equals(currentSlug, gamingEvent.Slug, StringComparison.OrdinalIgnoreCase);
                        <a asp-controller="Events" asp-action="Details" asp-route-slug="@gamingEvent.Slug"
                           aria-current="@(active ? "page" : null)" class="tgv-event-link">@gamingEvent.Name<span aria-hidden="true">↗</span></a>
                    }
                </nav>
            </div>
        </div>
    }
</header>

<div id="mobile-menu-overlay" role="dialog" aria-modal="true" aria-labelledby="mobile-menu-title" tabindex="-1"
     class="fixed inset-0 z-[999] hidden overflow-y-auto bg-surface lg:hidden">
    <div class="tgv-container">
        <div class="flex min-h-16 items-center justify-between gap-3 border-b border-line py-2">
            <span id="mobile-menu-title" class="tgv-nav-brand">TheGameVoice <span class="sr-only">navigation</span></span>
            <button id="mobile-menu-close" type="button" aria-label="Close navigation menu" class="tgv-nav-menu-button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
            </button>
        </div>

        <div class="space-y-7 py-6">
            <form asp-controller="Search" asp-action="Index" method="get" role="search">
                <label for="mobile-nav-search" class="sr-only">Search articles</label>
                <div class="tgv-nav-search tgv-nav-search--mobile">
                    <input id="mobile-nav-search" type="search" name="query" placeholder="Search articles…" />
                    <button type="submit" aria-label="Search articles">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
                    </button>
                </div>
            </form>

            <nav aria-label="Main navigation" class="space-y-1">
                <a asp-controller="Home" asp-action="Index" class="tgv-mobile-category">Home<span aria-hidden="true">↗</span></a>
                @foreach (var category in Model.Categories)
                {
                    var active = currentController == "Categories" && string.Equals(currentSlug, category.Slug, StringComparison.OrdinalIgnoreCase);
                    <a asp-controller="Categories" asp-action="Details" asp-route-slug="@category.Slug"
                       aria-current="@(active ? "page" : null)" class="tgv-mobile-category">@category.Name<span aria-hidden="true">↗</span></a>
                }
            </nav>

            @if (Model.Events.Any())
            {
                <section aria-labelledby="mobile-events-title" class="tgv-mobile-events">
                    <h2 id="mobile-events-title" class="tgv-events-label"><span class="tgv-events-marker" aria-hidden="true"></span>Events</h2>
                    <nav aria-label="Event coverage" class="mt-3 space-y-1">
                        @foreach (var gamingEvent in Model.Events)
                        {
                            var active = currentController == "Events" && string.Equals(currentSlug, gamingEvent.Slug, StringComparison.OrdinalIgnoreCase);
                            <a asp-controller="Events" asp-action="Details" asp-route-slug="@gamingEvent.Slug"
                               aria-current="@(active ? "page" : null)" class="tgv-mobile-event-link">@gamingEvent.Name<span aria-hidden="true">↗</span></a>
                        }
                    </nav>
                </section>
            }
        </div>
    </div>
</div>

<script src="~/js/navigation.js" asp-append-version="true" defer></script>
