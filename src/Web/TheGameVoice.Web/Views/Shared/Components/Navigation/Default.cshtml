@model TheGameVoice.Web.ViewModels.Shared.NavigationViewModel

@{
    var isMobileMode =
        Model.CurrentSegment == GameSegment.Mobile;

    var primaryCategories =
        Model.Categories
            .Take(7)
            .ToList();

    var secondaryCategories =
        Model.Categories
            .Skip(7)
            .ToList();
}

<header class="sticky top-0 z-50 border-b border-default bg-surface">

    <div class="tgv-container">

        <!-- MAIN NAVIGATION -->

        <div class="hidden lg:flex items-center justify-between py-5">

            <!-- LEFT -->

            <div class="flex items-center gap-fluid-10">

                <!-- LOGO -->

                <div class="shrink-0">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="block text-fluid-3xl font-black leading-none tracking-tight text-primary">

                        TheGameVoice

                    </a>

                </div>

                <!-- PRIMARY NAV -->

                <nav class="flex items-center gap-6">

                   @*  <a asp-controller="Home"
                       asp-action="Index"
                       class="text-sm font-bold uppercase tracking-[0.12em] text-ink transition hover:text-primary">

                        Home

                    </a> *@

                    @foreach (var category in primaryCategories)
                    {
                        <a asp-controller="Categories"
                           asp-action="Details"
                           asp-route-slug="@category.Slug"
                           class="text-sm font-bold uppercase tracking-[0.12em] text-ink transition hover:text-primary">

                            @category.Name

                        </a>
                    }

                </nav>

            </div>

            <!-- SECTION + SEARCH + THEME -->

            <div class="flex items-center gap-3">

                @*  Site-mode (PC / Mobile) toggle — hidden for now, re-enable
                    later by un-commenting this partial. *@
                @* <partial name="~/Views/Shared/Components/_SiteModeToggle.cshtml"
                         model="Model" /> *@

                <form method="get"
                      asp-controller="Search"
                      asp-action="Index">

                    <input type="text"
                           name="query"
                           placeholder="Search articles..."
                           class="w-56 rounded-full border border-default bg-surface px-5 py-2.5 text-sm text-ink outline-none transition focus:border-primary" />

                </form>

                <partial name="~/Views/Shared/Components/_ThemeToggle.cshtml" />

            </div>

        </div>

        <!-- SECONDARY NAV -->
        @if (secondaryCategories.Any())
        {
            <div class="hidden border-t border-default lg:block">

                <nav class="flex flex-wrap items-center gap-6 py-3">

                    @foreach (var category in secondaryCategories)
                    {
                        <a asp-controller="Categories"
                           asp-action="Details"
                           asp-route-slug="@category.Slug"
                           class="text-sm font-semibold uppercase tracking-[0.12em] text-ink-mid transition hover:text-primary">

                            @category.Name

                        </a>
                    }

                </nav>

            </div>
        }

        <!-- MOBILE HEADER -->

        <div class="flex h-16 items-center justify-between gap-3 lg:hidden">

            <a asp-controller="Home"
               asp-action="Index"
               class="text-2xl font-black leading-none tracking-tight text-primary">

                TheGameVoice

            </a>

            @*  Site-mode toggle hidden for now (see header note). *@
            @* <div class="max-xs:hidden">

                <partial name="~/Views/Shared/Components/_SiteModeToggle.cshtml"
                         model="Model" />

            </div> *@

            <partial name="~/Views/Shared/Components/_ThemeToggle.cshtml" />

            <button id="mobile-menu-button"
                    type="button"
                    class="flex h-10 w-10 items-center justify-center rounded-md border border-default bg-surface">

                ☰

            </button>

        </div>

    </div>

</header>

<!-- MOBILE OVERLAY -->

<div id="mobile-menu-overlay"
     class="fixed inset-0 z-[999] hidden bg-surface">

    <div class="tgv-container">

        <div class="flex h-16 items-center justify-between border-b border-default">

            <span class="text-2xl font-black text-primary">

                TheGameVoice

            </span>

            <button id="mobile-menu-close"
                    type="button"
                    class="text-fluid-3xl">

                ×

            </button>

        </div>

        <div class="py-8">

            <!-- THEME -->

            <div class="mb-6 flex items-center justify-between gap-3">

                @*  Site-mode toggle hidden for now (see header note).
                @{ ViewData["SiteModeLabels"] = true; }

                <partial name="~/Views/Shared/Components/_SiteModeToggle.cshtml"
                         model="Model" />

                @{ ViewData["SiteModeLabels"] = null; }
                *@

                <partial name="~/Views/Shared/Components/_ThemeToggle.cshtml" />

            </div>

            <!-- SEARCH -->

            <form method="get"
                  asp-controller="Search"
                  asp-action="Index"
                  class="mb-8">

                <input type="text"
                       name="query"
                       placeholder="Search articles..."
                       class="w-full rounded-full border border-default bg-surface px-5 py-3 text-ink outline-none focus:border-primary" />

            </form>

            <!-- NAVIGATION -->

            <nav class="flex flex-col gap-5">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-lg font-bold uppercase">

                    Home

                </a>

                @foreach (var category in Model.Categories)
                {
                    <a asp-controller="Categories"
                       asp-action="Details"
                       asp-route-slug="@category.Slug"
                       class="text-lg font-bold uppercase">

                        @category.Name

                    </a>
                }

            </nav>

        </div>

    </div>

</div>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const openButton =
            document.getElementById("mobile-menu-button");

        const closeButton =
            document.getElementById("mobile-menu-close");

        const overlay =
            document.getElementById("mobile-menu-overlay");

        if (openButton && overlay) {

            openButton.addEventListener("click", function () {

                overlay.classList.remove("hidden");

                document.body.style.overflow = "hidden";

            });

        }

        if (closeButton && overlay) {

            closeButton.addEventListener("click", function () {

                overlay.classList.add("hidden");

                document.body.style.overflow = "";

            });

        }

    });

</script>