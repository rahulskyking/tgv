@model TheGameVoice.Domain.Entities.Article

<article class="group min-w-0">
    <a asp-controller="News"
       asp-action="Details"
       asp-route-slug="@Model.Slug"
       class="block h-full overflow-hidden rounded-2xl border border-line bg-surface transition duration-300 hover:-translate-y-1 hover:border-line-strong hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">

        <div class="aspect-video overflow-hidden bg-surface-raised">
            @if (Model.FeaturedImage != null)
            {
                <img src="@Model.FeaturedImage.FilePath"
                     alt="@Model.Title"
                     loading="lazy"
                     class="h-full w-full object-cover object-center transition duration-500 group-hover:scale-105" />
            }
            else
            {
                <div class="flex h-full items-center justify-center text-ink-faint">
                    <i data-lucide="newspaper" class="h-8 w-8" aria-hidden="true"></i>
                </div>
            }
        </div>

        <div class="p-4 sm:p-5">
            @if (Model.Category != null)
            {
                <div class="mb-2 truncate text-[11px] font-bold uppercase tracking-[0.15em] text-primary">
                    @Model.Category.Name
                </div>
            }

            <h3 class="line-clamp-3 text-base font-semibold leading-snug text-ink transition-colors group-hover:text-primary">
                @Model.Title
            </h3>

            @if (Model.PublishedAt.HasValue)
            {
                <time datetime="@Model.PublishedAt.Value.ToString("O")"
                      class="mt-2 block text-xs text-ink-muted">
                    @Model.PublishedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                </time>
            }
        </div>
    </a>
</article>
