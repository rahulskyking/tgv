@model TheGameVoice.Domain.Entities.Article

<a asp-controller="News"
   asp-action="Details"
   asp-route-slug="@Model.Slug"
   class="group flex min-w-0 items-start gap-3 border-b border-line py-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 sm:gap-4">

    <div class="h-20 w-28 shrink-0 overflow-hidden rounded-lg border border-line bg-surface-raised sm:w-32">
        @if (Model.FeaturedImage != null)
        {
            <img src="@Model.FeaturedImage.FilePath"
                 alt="@Model.Title"
                 loading="lazy"
                 class="h-full w-full object-cover object-center transition duration-300 group-hover:scale-105" />
        }
        else
        {
            <div class="flex h-full items-center justify-center text-ink-faint">
                <i data-lucide="newspaper" class="h-6 w-6" aria-hidden="true"></i>
            </div>
        }
    </div>

    <div class="min-w-0 flex-1">
        @if (Model.Category != null)
        {
            <div class="mb-1.5 truncate text-[11px] font-bold uppercase tracking-[0.15em] text-primary">
                @Model.Category.Name
            </div>
        }

        <h3 class="line-clamp-3 text-sm font-semibold leading-snug text-ink transition-colors group-hover:text-primary">
            @Model.Title
        </h3>

        @if (Model.PublishedAt.HasValue)
        {
            <time datetime="@Model.PublishedAt.Value.ToString("O")"
                  class="mt-1.5 block text-xs text-ink-muted">
                @Model.PublishedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
            </time>
        }
    </div>
</a>
