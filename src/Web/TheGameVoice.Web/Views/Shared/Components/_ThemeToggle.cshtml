@*
    Dark / light switch.

    Stateless on the server: the current theme lives on <html data-theme>,
    is set before first paint by the inline script in the layout head, and is
    flipped client-side by wwwroot/js/theme.js. Drop this partial anywhere.
*@

<button type="button"
        class="tgv-theme-toggle @(ViewData["ThemeToggleClass"])"
        data-theme-toggle
        aria-pressed="false"
        aria-label="Switch to dark mode"
        title="Switch to dark mode">

    @* Moon — shown in light mode (click to go dark) *@
    <svg class="tgv-icon-moon"
         xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>

    @* Sun — shown in dark mode (click to go light) *@
    <svg class="tgv-icon-sun"
         xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
    </svg>

    @if (ViewData["ThemeToggleLabel"] as bool? == true)
    {
        <span data-theme-label>Dark mode</span>
    }

</button>
