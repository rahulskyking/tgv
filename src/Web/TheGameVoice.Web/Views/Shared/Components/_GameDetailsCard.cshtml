@model TheGameVoice.Domain.Entities.Game

@{
    var released =
        Model.ReleaseDate.HasValue &&
        Model.ReleaseDate.Value.Date <= DateTime.UtcNow.Date;

    var statusText = released ? "Released" : "Upcoming";
    var statusClass = released
        ? "bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/20"
        : "bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-600/20";
}

<!-- Main Card: Subtle gradient background, tinted border, and soft primary shadow -->
<div class="overflow-hidden rounded-[2rem] border border-[#7c3aed]/15 bg-gradient-to-br from-white to-[#7c3aed]/[0.04] shadow-xl shadow-[#7c3aed]/[0.03]">

    <!-- Header: Frosted effect with tinted bottom border -->
    <div class="flex items-center justify-between border-b border-[#7c3aed]/10 bg-white/40 px-6 py-5 backdrop-blur-sm">
        <div class="flex items-center gap-3">
            <!-- Glowing Accent Bar -->
            <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-[#7c3aed] to-[#6d28d9] shadow-[0_0_10px_rgba(124,58,237,0.4)]"></div>
            <div>
                <div class="text-[10px] font-bold uppercase tracking-[0.25em] text-[#7c3aed]/80">
                    Game Hub
                </div>
                <div class="flex items-center gap-2 text-lg font-bold text-slate-900">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 text-[#7c3aed]/60">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a1.5 1.5 0 0 1-1.5 1.5H6a4.5 4.5 0 0 0-4.5 4.5v6.257l1.5-1.5v-4.757a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v4.757l1.5 1.5V10.587a4.5 4.5 0 0 0-4.5-4.5h-3.75a1.5 1.5 0 0 1-1.5-1.5Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 13.5h.008v.008H6v-.008ZM6 16.5h.008v.008H6v-.008ZM9 15h.008v.008H9V15ZM15 15h.008v.008H15V15ZM18 13.5h.008v.008H18v-.008ZM18 16.5h.008v.008H18v-.008Z" />
                    </svg>
                    Game Details
                </div>
            </div>
        </div>
        <div class="rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-wide @statusClass">
            @statusText
        </div>
    </div>

    <div class="p-6 sm:p-8">
        <!-- Cover + Content -->
        <div class="flex flex-col items-start gap-6 sm:flex-row">
            @if (Model.CoverImage != null)
            {
                <a asp-controller="Games"
                   asp-action="Details"
                   asp-route-slug="@Model.Slug"
                   class="group shrink-0 relative">
                    <!-- Image gets a purple glowing shadow and border on hover -->
                    <img src="@Model.CoverImage.FilePath"
                         alt="@Model.Name"
                         class="relative z-10 h-44 w-32 rounded-2xl border border-slate-200 object-cover shadow-md transition-all duration-300 group-hover:-translate-y-1 group-hover:scale-105 group-hover:border-[#7c3aed]/40 group-hover:shadow-[0_12px_24px_-8px_rgba(124,58,237,0.5)]" />
                </a>
            }

            <div class="min-w-0 flex-1">
                <a asp-controller="Games"
                   asp-action="Details"
                   asp-route-slug="@Model.Slug"
                   class="group">
                    <h3 class="text-3xl font-extrabold leading-tight text-slate-900 transition-colors duration-300 group-hover:text-[#6d28d9]">
                        @Model.Name
                    </h3>
                </a>

                @if (!string.IsNullOrWhiteSpace(Model.Genres))
                {
                    <!-- Slightly enhanced badge with a tinted border -->
                    <div class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-[#7c3aed]/20 bg-[#7c3aed]/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-widest text-[#7c3aed]">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3 w-3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 7.5h.008v.008H6V7.5Z" />
                        </svg>
                        @Model.Genres
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Summary))
                {
                    <p class="mt-4 line-clamp-3 text-sm leading-relaxed text-slate-600">
                        @Model.Summary
                    </p>
                }
            </div>
        </div>

        <!-- Tinted divider instead of slate -->
        <div class="my-8 border-t border-[#7c3aed]/10"></div>

        <!-- Information Grid - Now uses modern "Inset Cards" -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            @if (Model.ReleaseDate.HasValue)
            {
                <div class="group flex items-start gap-3.5 rounded-2xl border border-[#7c3aed]/10 bg-white/60 p-3.5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-[#7c3aed]/30 hover:bg-white hover:shadow-md hover:shadow-[#7c3aed]/5">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#7c3aed]/10 text-[#7c3aed] transition-colors group-hover:bg-[#7c3aed] group-hover:text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                        </svg>
                    </div>
                    <div>
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Release Date</div>
                        <div class="mt-0.5 text-sm font-semibold text-slate-800">@Model.ReleaseDate.Value.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Platforms))
            {
                <div class="group flex items-start gap-3.5 rounded-2xl border border-[#7c3aed]/10 bg-white/60 p-3.5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-[#7c3aed]/30 hover:bg-white hover:shadow-md hover:shadow-[#7c3aed]/5">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#7c3aed]/10 text-[#7c3aed] transition-colors group-hover:bg-[#7c3aed] group-hover:text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25" />
                        </svg>
                    </div>
                    <div>
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Platforms</div>
                        <div class="mt-0.5 text-sm font-semibold text-slate-800">@Model.Platforms</div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Developer))
            {
                <div class="group flex items-start gap-3.5 rounded-2xl border border-[#7c3aed]/10 bg-white/60 p-3.5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-[#7c3aed]/30 hover:bg-white hover:shadow-md hover:shadow-[#7c3aed]/5">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#7c3aed]/10 text-[#7c3aed] transition-colors group-hover:bg-[#7c3aed] group-hover:text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
                        </svg>
                    </div>
                    <div>
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Developer</div>
                        <div class="mt-0.5 text-sm font-semibold text-slate-800">@Model.Developer</div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Publisher))
            {
                <div class="group flex items-start gap-3.5 rounded-2xl border border-[#7c3aed]/10 bg-white/60 p-3.5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-[#7c3aed]/30 hover:bg-white hover:shadow-md hover:shadow-[#7c3aed]/5">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#7c3aed]/10 text-[#7c3aed] transition-colors group-hover:bg-[#7c3aed] group-hover:text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />
                        </svg>
                    </div>
                    <div>
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Publisher</div>
                        <div class="mt-0.5 text-sm font-semibold text-slate-800">@Model.Publisher</div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.OfficialWebsite))
            {
                <div class="group col-span-1 flex items-start gap-3.5 rounded-2xl border border-[#7c3aed]/10 bg-white/60 p-3.5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-[#7c3aed]/30 hover:bg-white hover:shadow-md hover:shadow-[#7c3aed]/5 sm:col-span-2">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#7c3aed]/10 text-[#7c3aed] transition-colors group-hover:bg-[#7c3aed] group-hover:text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.61.476-3.11 1.284-4.418" />
                        </svg>
                    </div>
                    <div class="min-w-0">
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Official Website</div>
                        <div class="mt-0.5 truncate text-sm font-semibold text-slate-800">@Model.OfficialWebsite</div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-8 border-t border-[#7c3aed]/10 pt-8">
            @if (!string.IsNullOrWhiteSpace(Model.OfficialWebsite))
            {
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <a asp-controller="Games"
                       asp-action="Details"
                       asp-route-slug="@Model.Slug"
                       class="inline-flex h-12 items-center justify-center gap-2 rounded-xl bg-[#7c3aed] px-5 text-sm font-bold text-white shadow-lg shadow-[#7c3aed]/25 transition-all hover:-translate-y-0.5 hover:bg-[#6d28d9] hover:shadow-[#7c3aed]/40">
                        View Game Hub
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-4 w-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                        </svg>
                    </a>
                    <a href="@Model.OfficialWebsite"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="inline-flex h-12 items-center justify-center gap-2 rounded-xl border border-[#7c3aed]/20 bg-white px-5 text-sm font-bold text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-[#7c3aed]/50 hover:bg-[#7c3aed]/5 hover:text-[#7c3aed]">
                        Official Site
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-4 w-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                        </svg>
                    </a>
                </div>
            }
            else
            {
                <a asp-controller="Games"
                   asp-action="Details"
                   asp-route-slug="@Model.Slug"
                   class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#7c3aed] px-5 text-sm font-bold text-white shadow-lg shadow-[#7c3aed]/25 transition-all hover:-translate-y-0.5 hover:bg-[#6d28d9] hover:shadow-[#7c3aed]/40">
                    View Game Hub
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-4 w-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                </a>
            }
        </div>
    </div>
</div>