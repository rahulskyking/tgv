@model TheGameVoice.Domain.Entities.Game

@{
    ViewData["Title"] = Model.Name;

    var released =
        Model.ReleaseDate.HasValue &&
        Model.ReleaseDate.Value.Date <= DateTime.UtcNow.Date;

    var statusText = released ? "Released" : "Upcoming";
    var statusClass = released
        ? "bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/20"
        : "bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-600/20";

    var genres = !string.IsNullOrWhiteSpace(Model.Genres)
        ? Model.Genres.Split(',', StringSplitOptions.RemoveEmptyEntries)
        : Array.Empty<string>();

    var platforms = !string.IsNullOrWhiteSpace(Model.Platforms)
        ? Model.Platforms.Split(',', StringSplitOptions.RemoveEmptyEntries)
        : Array.Empty<string>();
}

<div class="tgv-container py-6 md:py-12">
    <div class="mx-auto max-w-4xl">

        <!-- CARD -->
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm md:rounded-2xl">

            <!-- COVER IMAGE -->
            @if (Model.CoverImage != null)
            {
                <div class="overflow-hidden">
                    <img src="@Model.CoverImage.FilePath"
                         alt="@Model.Name"
                         class="aspect-[2/1] w-full object-cover object-center md:aspect-[16/9]" />
                </div>
            }

            <!-- CONTENT -->
            <div class="p-4 sm:p-6 lg:p-8">

                <!-- KICKER -->
                <div class="mb-1.5 md:mb-2">
                    <span class="tgv-kicker text-[10px] md:text-xs">Game Profile</span>
                </div>

                <!-- TITLE -->
                <h1 class="mb-3 text-2xl font-extrabold leading-[1.1] tracking-tight text-slate-900 sm:text-3xl md:mb-4 md:text-4xl lg:text-5xl">
                    @Model.Name
                </h1>

                <!-- STATUS & GENRES -->
                <div class="mb-4 flex flex-wrap items-center gap-1.5 md:mb-6 md:gap-2">
                    <span class="@statusClass inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider md:px-3 md:py-1.5 md:text-xs">
                        <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
                        @statusText
                    </span>
                    @foreach (var genre in genres)
                    {
                        <span class="rounded-full bg-violet-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-violet-700 md:px-3 md:py-1.5 md:text-xs">
                            @genre.Trim()
                        </span>
                    }
                </div>

                <!-- SUMMARY -->
                @if (!string.IsNullOrWhiteSpace(Model.Summary))
                {
                    <p class="mb-4 text-sm leading-relaxed text-slate-600 md:mb-6 md:text-base">
                        @Model.Summary
                    </p>
                }

                <!-- DIVIDER -->
                <div class="my-4 border-t border-slate-200 md:my-6"></div>

                <!-- GAME INFO — 2-col grid on mobile to save vertical space -->
                <div class="mb-4 grid grid-cols-2 gap-x-4 gap-y-3 md:mb-6 md:gap-y-4">

                    <!-- Release Date -->
                    <div>
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 md:text-xs">
                            Release
                        </div>
                        <div class="mt-0.5 text-sm font-semibold text-slate-900 md:mt-1">
                            @(Model.ReleaseDate?.ToString("dd MMM yyyy") ?? "TBA")
                        </div>
                    </div>

                    <!-- Developer -->
                    <div>
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 md:text-xs">
                            Developer
                        </div>
                        <div class="mt-0.5 truncate text-sm font-semibold text-slate-900 md:mt-1" title="@(Model.Developer ?? "Unknown")">
                            @(string.IsNullOrWhiteSpace(Model.Developer) ? "Unknown" : Model.Developer)
                        </div>
                    </div>

                    <!-- Publisher -->
                    <div>
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 md:text-xs">
                            Publisher
                        </div>
                        <div class="mt-0.5 truncate text-sm font-semibold text-slate-900 md:mt-1" title="@(Model.Publisher ?? "Unknown")">
                            @(string.IsNullOrWhiteSpace(Model.Publisher) ? "Unknown" : Model.Publisher)
                        </div>
                    </div>

                    <!-- Website -->
                    @if (!string.IsNullOrWhiteSpace(Model.OfficialWebsite))
                    {
                        <div>
                            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 md:text-xs">
                                Website
                            </div>
                            <a href="@Model.OfficialWebsite"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="mt-0.5 inline-flex items-center gap-1 truncate text-sm font-semibold text-[#7c3aed] hover:underline md:mt-1">
                                Visit
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                </svg>
                            </a>
                        </div>
                    }

                </div>

                <!-- PLATFORMS -->
                @if (platforms.Length > 0)
                {
                    <div class="mb-4 md:mb-6">
                        <div class="mb-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400 md:mb-2 md:text-xs">
                            Platforms
                        </div>
                        <div class="flex flex-wrap gap-1.5 md:gap-2">
                            @foreach (var platform in platforms)
                            {
                                <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 md:rounded-lg md:px-3 md:py-1.5 md:text-sm">
                                    @platform.Trim()
                                </span>
                            }
                        </div>
                    </div>
                }

                <!-- ACTION BUTTONS -->
                <div class="flex flex-wrap gap-2 border-t border-slate-200 pt-4 md:gap-3 md:pt-6">
                    <a asp-controller="Games"
                       asp-action="Details"
                       asp-route-slug="@Model.Slug"
                       class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg bg-[#7c3aed] px-4 py-2.5 text-xs font-bold text-white transition hover:bg-[#6d28d9] sm:flex-none sm:px-5 sm:py-3 sm:text-sm md:rounded-xl">
                        View Game Hub
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5 sm:h-4 sm:w-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                        </svg>
                    </a>

                    @if (!string.IsNullOrWhiteSpace(Model.OfficialWebsite))
                    {
                        <a href="@Model.OfficialWebsite"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 transition hover:border-[#7c3aed] hover:text-[#7c3aed] sm:flex-none sm:px-5 sm:py-3 sm:text-sm md:rounded-xl">
                            Official Site
                        </a>
                    }
                </div>

            </div>

        </div>

    </div>
</div>
