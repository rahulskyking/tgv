@model TheGameVoice.Domain.Entities.Article

<a asp-controller="News"
   asp-action="Details"
   asp-route-slug="@Model.Slug"
   class="group block border-b border-default py-6">

    <div class="flex items-start gap-5">

        @if (Model.FeaturedImage != null)
        {
            <div class="w-60 h-32 shrink-0 overflow-hidden rounded-lg">

                <img src="@Model.FeaturedImage.FilePath"
                     alt="@Model.Title"
                     class="h-full w-full object-cover object-center transition duration-300 group-hover:scale-105" />

            </div>
        }

        <div class="min-w-0 flex-1">

            <div class="mb-2 flex items-center gap-2">

                @if (Model.Category != null)
                {
                    <span class="text-xs font-medium uppercase tracking-[0.12em] text-primary">
                        @Model.Category.Name
                    </span>
                }

                <span class="text-xs text-muted">|</span>

                <span class="text-xs text-muted">
                    @(Model.PublishedAt?.ToLocalTime().ToString("dd MMM yyyy"))
                </span>

            </div>

            <h3 class="text-xl font-medium leading-tight text-slate-900 transition group-hover:text-primary">

                @Model.Title

            </h3>

            @if (!string.IsNullOrWhiteSpace(Model.Summary))
            {
                <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">

                    @Model.Summary

                </p>
            }

        </div>

    </div>

</a>