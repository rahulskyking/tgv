@model TheGameVoice.Web.ViewModels.News.ArticleDetailsViewModel

<div class="sticky top-24 space-y-8">

    @* GAME DETAILS *@
    @if (Model.Article.ArticleGames.Any())
    {
        <section>

            <partial name="~/Views/Shared/Components/_GameDetailsCard.cshtml"
                     model="Model.Article.ArticleGames.First().Game" />

        </section>
    }

    @* TRENDING *@
    @if (Model.RelatedArticles.Any())
    {
        <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

            <div class="mb-6 flex items-center gap-4">

                <h3 class="text-xl font-bold tracking-tight text-slate-900">

                    Trending Now

                </h3>

                <div class="h-px flex-1 bg-slate-200"></div>

            </div>

            <div class="space-y-6">

                @foreach (var article in Model.RelatedArticles.Take(4))
                {
                    <partial name="~/Views/Shared/Components/_SidebarArticleCard.cshtml"
                             model="article" />
                }

            </div>

        </section>
    }

    @* TOPICS *@
    @if (Model.Article.ArticleTags.Any())
    {
        <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

            <div class="mb-6 flex items-center gap-4">

                <h3 class="text-xl font-bold tracking-tight text-slate-900">

                    Topics

                </h3>

                <div class="h-px flex-1 bg-slate-200"></div>

            </div>

            <div class="flex flex-wrap gap-2">

                @foreach (var tag in Model.Article.ArticleTags)
                {
                    <a asp-controller="Tags"
                       asp-action="Details"
                       asp-route-slug="@tag.Tag.Slug"
                       class="rounded-full border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-primary hover:text-primary">

                        @tag.Tag.Name

                    </a>
                }

            </div>

        </section>
    }

    @* FOLLOW *@
    @* FOLLOW *@
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="mb-6 flex items-center gap-4">
            <h3 class="text-xl font-bold tracking-tight text-slate-900">
                Follow TheGameVoice
            </h3>

            <div class="h-px flex-1 bg-slate-200"></div>
        </div>

        <div class="grid grid-cols-2 gap-3">

            <!-- YouTube -->
            <a href="https://www.youtube.com/%40The_GameVoice"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Follow TheGameVoice on YouTube"
               class="group inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold text-slate-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-red-500 hover:bg-red-50 hover:text-red-600 hover:shadow-md">
                <svg class="h-5 w-5 text-slate-500 transition-colors duration-200 group-hover:text-red-600"
                     viewBox="0 0 24 24"
                     fill="currentColor"
                     aria-hidden="true">
                    <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z" />
                </svg>
                YouTube
            </a>

            <!-- Instagram -->
            <a href="https://www.instagram.com/thegamevoice/"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Follow TheGameVoice on Instagram"
               class="group inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold text-slate-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-pink-500 hover:bg-pink-50 hover:text-pink-600 hover:shadow-md">
                <svg class="h-5 w-5 text-slate-500 transition-colors duration-200 group-hover:text-pink-600"
                     viewBox="0 0 24 24"
                     fill="currentColor"
                     aria-hidden="true">
                    <path d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 2A3.76 3.76 0 0 0 4 7.75v8.5A3.76 3.76 0 0 0 7.75 20h8.5A3.76 3.76 0 0 0 20 16.25v-8.5A3.76 3.76 0 0 0 16.25 4h-8.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-2.35a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z" />
                </svg>
                Instagram
            </a>

            <!-- X -->
            <a href="https://x.com/_TheGameVoice"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Follow TheGameVoice on X"
               class="group inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold text-slate-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-slate-900 hover:bg-slate-900 hover:text-white hover:shadow-md">
                <svg class="h-5 w-5 text-slate-500 transition-colors duration-200 group-hover:text-white"
                     viewBox="0 0 24 24"
                     fill="currentColor"
                     aria-hidden="true">
                    <path d="M18.9 2h3.4l-7.4 8.5L23.6 22h-6.8l-5.3-7-6.1 7H2l7.9-9.1L1.6 2h7l4.8 6.4L18.9 2Zm-1.2 18h1.9L7.6 3.9h-2L17.7 20Z" />
                </svg>
                X
            </a>

            <!-- LinkedIn -->
            <a href="https://www.linkedin.com/company/thegamevoice"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Follow TheGameVoice on LinkedIn"
               class="group inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold text-slate-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-blue-600 hover:bg-blue-50 hover:text-blue-700 hover:shadow-md">
                <svg class="h-5 w-5 text-slate-500 transition-colors duration-200 group-hover:text-blue-700"
                     viewBox="0 0 24 24"
                     fill="currentColor"
                     aria-hidden="true">
                    <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5.001 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11.5H3V9.75Zm6.25 0h3.84v1.57h.05c.54-1.02 1.85-2.1 3.81-2.1 4.08 0 4.83 2.69 4.83 6.18v5.85h-4v-5.19c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75v5.28h-4V9.75Z" />
                </svg>
                LinkedIn
            </a>

        </div>

    </section>

</div>