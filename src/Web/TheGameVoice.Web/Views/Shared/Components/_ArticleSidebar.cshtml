@model TheGameVoice.Web.ViewModels.News.ArticleDetailsViewModel

<div class="sticky top-24 space-y-8">

    @* GAME DETAILS *@
    @if (Model.Article.ArticleGames.Any())
    {
        <section>

            <partial name="~/Views/Shared/Components/_GameDetailsCard.cshtml"
                     model="Model.Article.ArticleGames.First().Game" />

        </section>
    }

    @* TRENDING — most-viewed published articles, not the related list *@
    @if (Model.TrendingArticles.Any())
    {
        <section class="rounded-3xl border border-line bg-surface p-6 shadow-sm">

            <div class="mb-6 flex items-center gap-4">

                <h3 class="text-xl font-bold tracking-tight text-ink">

                    Trending Now

                </h3>

                <div class="h-px flex-1 bg-line"></div>

            </div>

            <div class="space-y-6">

                @foreach (var article in Model.TrendingArticles.Take(4))
                {
                    <partial name="~/Views/Shared/Components/_SidebarArticleCard.cshtml"
                             model="article" />
                }

            </div>

        </section>
    }

    @* TOPICS *@
    @if (Model.Article.ArticleTags.Any())
    {
        <section class="rounded-3xl border border-line bg-surface p-6 shadow-sm">

            <div class="mb-6 flex items-center gap-4">

                <h3 class="text-xl font-bold tracking-tight text-ink">

                    Topics

                </h3>

                <div class="h-px flex-1 bg-line"></div>

            </div>

            <div class="flex flex-wrap gap-2">

                @foreach (var tag in Model.Article.ArticleTags)
                {
                    <a asp-controller="Tags"
                       asp-action="Details"
                       asp-route-slug="@tag.Tag.Slug"
                       class="rounded-full border border-line px-3 py-2 text-sm font-medium text-ink-soft transition hover:border-primary hover:text-primary">

                        @tag.Tag.Name

                    </a>
                }

            </div>

        </section>
    }

</div>
