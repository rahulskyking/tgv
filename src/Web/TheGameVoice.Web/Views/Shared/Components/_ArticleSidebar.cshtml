@model TheGameVoice.Web.ViewModels.News.ArticleDetailsViewModel

<div class="sticky top-24 space-y-8">

    @* GAME DETAILS *@
    @if (Model.Article.ArticleGames.Any())
    {
        <section>

            <partial name="~/Views/Shared/Components/_GameDetailsCard.cshtml"
                     model="Model.Article.ArticleGames.First().Game" />

        </section>
    }

    @* TRENDING *@
    @if (Model.RelatedArticles.Any())
    {
        <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

            <div class="mb-6 flex items-center gap-4">

                <h3 class="text-xl font-bold tracking-tight text-slate-900">

                    Trending Now

                </h3>

                <div class="h-px flex-1 bg-slate-200"></div>

            </div>

            <div class="space-y-6">

                @foreach (var article in Model.RelatedArticles.Take(4))
                {
                    <partial name="~/Views/Shared/Components/_SidebarArticleCard.cshtml"
                             model="article" />
                }

            </div>

        </section>
    }

    @* TOPICS *@
    @if (Model.Article.ArticleTags.Any())
    {
        <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

            <div class="mb-6 flex items-center gap-4">

                <h3 class="text-xl font-bold tracking-tight text-slate-900">

                    Topics

                </h3>

                <div class="h-px flex-1 bg-slate-200"></div>

            </div>

            <div class="flex flex-wrap gap-2">

                @foreach (var tag in Model.Article.ArticleTags)
                {
                    <a asp-controller="Tags"
                       asp-action="Details"
                       asp-route-slug="@tag.Tag.Slug"
                       class="rounded-full border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-primary hover:text-primary">

                        @tag.Tag.Name

                    </a>
                }

            </div>

        </section>
    }

    @* FOLLOW *@
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

        <div class="mb-6 flex items-center gap-4">

            <h3 class="text-xl font-bold tracking-tight text-slate-900">

                Follow TheGameVoice

            </h3>

            <div class="h-px flex-1 bg-slate-200"></div>

        </div>

        <div class="grid grid-cols-2 gap-3">

            <a href="#" class="rounded-xl border border-slate-200 px-4 py-3 text-center font-medium transition hover:border-primary hover:text-primary">
                YouTube
            </a>

            <a href="#" class="rounded-xl border border-slate-200 px-4 py-3 text-center font-medium transition hover:border-primary hover:text-primary">
                Instagram
            </a>

            <a href="#" class="rounded-xl border border-slate-200 px-4 py-3 text-center font-medium transition hover:border-primary hover:text-primary">
                X
            </a>

            <a href="#" class="rounded-xl border border-slate-200 px-4 py-3 text-center font-medium transition hover:border-primary hover:text-primary">
                LinkedIn
            </a>

        </div>

    </section>

</div>