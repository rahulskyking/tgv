@* Compact "follow us" band — a single slim horizontal strip (heading + icon
   buttons only, no description) placed between article paragraphs. *@
<section class="tgv-follow-glow my-fluid-8">

    <div class="flex items-center justify-between gap-3 rounded-[10px] bg-surface-muted px-4 py-2.5 sm:px-5">

        <span class="whitespace-nowrap text-sm font-bold text-ink">
            Follow TheGameVoice
        </span>

        <div class="flex items-center gap-1.5">

        <!-- YouTube -->
        <a href="https://www.youtube.com/%40The_GameVoice"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Follow TheGameVoice on YouTube"
           title="YouTube"
           class="group flex h-8 w-8 items-center justify-center rounded-lg text-ink-muted transition hover:bg-red-500 hover:text-white">
            <svg class="h-4 w-4"
                 viewBox="0 0 24 24"
                 fill="currentColor"
                 aria-hidden="true">
                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z" />
            </svg>
        </a>

        <!-- Instagram -->
        <a href="https://www.instagram.com/thegamevoice/"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Follow TheGameVoice on Instagram"
           title="Instagram"
           class="group flex h-8 w-8 items-center justify-center rounded-lg text-ink-muted transition hover:bg-pink-500 hover:text-white">
            <svg class="h-4 w-4"
                 viewBox="0 0 24 24"
                 fill="currentColor"
                 aria-hidden="true">
                <path d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 2A3.76 3.76 0 0 0 4 7.75v8.5A3.76 3.76 0 0 0 7.75 20h8.5A3.76 3.76 0 0 0 20 16.25v-8.5A3.76 3.76 0 0 0 16.25 4h-8.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-2.35a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z" />
            </svg>
        </a>

        <!-- X -->
        <a href="https://x.com/_TheGameVoice"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Follow TheGameVoice on X"
           title="X"
           class="group flex h-8 w-8 items-center justify-center rounded-lg text-ink-muted transition hover:bg-slate-900 hover:text-white">
            <svg class="h-4 w-4"
                 viewBox="0 0 24 24"
                 fill="currentColor"
                 aria-hidden="true">
                <path d="M18.9 2h3.4l-7.4 8.5L23.6 22h-6.8l-5.3-7-6.1 7H2l7.9-9.1L1.6 2h7l4.8 6.4L18.9 2Zm-1.2 18h1.9L7.6 3.9h-2L17.7 20Z" />
            </svg>
        </a>

        <!-- LinkedIn -->
        <a href="https://www.linkedin.com/company/thegamevoice"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Follow TheGameVoice on LinkedIn"
           title="LinkedIn"
           class="group flex h-8 w-8 items-center justify-center rounded-lg text-ink-muted transition hover:bg-blue-600 hover:text-white">
            <svg class="h-4 w-4"
                 viewBox="0 0 24 24"
                 fill="currentColor"
                 aria-hidden="true">
                <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5.001 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11.5H3V9.75Zm6.25 0h3.84v1.57h.05c.54-1.02 1.85-2.1 3.81-2.1 4.08 0 4.83 2.69 4.83 6.18v5.85h-4v-5.19c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75v5.28h-4V9.75Z" />
            </svg>
        </a>

        </div>

    </div>

</section>
