@model TheGameVoice.Domain.Entities.Article

@if (Model.IsReview)
{
    var goodPoints = Model.ReviewPoints
        .Where(x => x.Type == TheGameVoice.Domain.Enums.ReviewPointType.Good)
        .OrderBy(x => x.DisplayOrder)
        .ToList();

    var badPoints = Model.ReviewPoints
        .Where(x => x.Type == TheGameVoice.Domain.Enums.ReviewPointType.Bad)
        .OrderBy(x => x.DisplayOrder)
        .ToList();

    // Score drives the 0-10 segmented meter in the score band.
    var score = Model.ReviewScore ?? 0m;
    var filledSegments = (int)Math.Round(score);

    <section class="mt-fluid-10 overflow-hidden rounded-[28px] border border-line bg-surface shadow-xl shadow-[#7c3aed]/5">

        <!-- Header -->
        <div class="flex items-center justify-between border-b border-[#7c3aed]/10 bg-gradient-to-r from-[#7c3aed]/5 to-surface px-4 py-4 sm:px-8 sm:py-5">
            <div class="flex items-center gap-3 sm:gap-4">
                <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-[#7c3aed]/10 sm:h-14 sm:w-14">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#7c3aed] sm:h-7 sm:w-7" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M7 6h10a5 5 0 015 5v2a3 3 0 01-3 3h-1l-2 2H8l-2-2H5a3 3 0 01-3-3v-2a5 5 0 015-5z" />
                    </svg>
                </div>
                <div>
                    <div class="text-[10px] font-black uppercase tracking-[0.28em] text-[#7c3aed]">
                        TheGameVoice Review
                    </div>
                    <h2 class="mt-1 text-2xl font-black text-ink sm:text-3xl">
                        Verdict
                    </h2>
                </div>
            </div>
            <div class="hidden rounded-full border border-[#7c3aed]/20 bg-[#7c3aed]/5 px-5 py-2 text-xs font-bold text-[#7c3aed] lg:block">
                Reviewed by TheGameVoice
            </div>
        </div>

        <!-- GOOD | BAD (two columns) -->
        <div class="grid grid-cols-2 bg-surface-muted">

            <!-- GOOD -->
            <div class="border-b border-line p-4 sm:p-8 md:border-b-0 md:border-r">
                <div class="mb-4 flex items-center gap-2.5 sm:mb-6 sm:gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-emerald-100 sm:h-12 sm:w-12">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-600 sm:h-6 sm:w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 9V5a3 3 0 00-6 0v4H5v11h14V9h-5z" />
                        </svg>
                    </div>
                    <div>
                        <div class="text-[10px] font-black uppercase tracking-[0.25em] text-emerald-600 sm:text-xs">
                            GOOD
                        </div>
                        <div class="mt-1 h-1 w-6 rounded-full bg-emerald-500 sm:w-8"></div>
                    </div>
                </div>
                <div class="space-y-3 sm:space-y-4">
                    @foreach (var point in goodPoints)
                    {
                        <div class="group flex items-start gap-2.5 sm:gap-3">
                            <div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 transition-transform duration-300 group-hover:scale-110 sm:h-6 sm:w-6">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-emerald-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l5 5L20 7" />
                                </svg>
                            </div>
                            <p class="text-sm font-medium leading-relaxed text-ink-soft">
                                @point.Text
                            </p>
                        </div>
                    }
                </div>
            </div>

            <!-- BAD -->
            <div class="p-4 sm:p-8">
                <div class="mb-4 flex items-center gap-2.5 sm:mb-6 sm:gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-red-100 sm:h-12 sm:w-12">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500 sm:h-6 sm:w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 15V19a3 3 0 006 0v-4h3V4H5v11h5z" />
                        </svg>
                    </div>
                    <div>
                        <div class="text-[10px] font-black uppercase tracking-[0.25em] text-red-500 sm:text-xs">
                            BAD
                        </div>
                        <div class="mt-1 h-1 w-6 rounded-full bg-red-500 sm:w-8"></div>
                    </div>
                </div>
                <div class="space-y-3 sm:space-y-4">
                    @foreach (var point in badPoints)
                    {
                        <div class="group flex items-start gap-2.5 sm:gap-3">
                            <div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 transition-transform duration-300 group-hover:scale-110 sm:h-6 sm:w-6">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-red-500" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 6L6 18M6 6l12 12" />
                                </svg>
                            </div>
                            <p class="text-sm font-medium leading-relaxed text-ink-soft">
                                @point.Text
                            </p>
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- SCORE + SUMMARY (full-width purple band) -->
        <div class="relative overflow-hidden bg-gradient-to-r from-[#7c3aed] via-[#6d28d9] to-[#5b21b6] text-white">
            <!-- Background Decoration -->
            <div class="absolute -right-16 -top-16 h-52 w-52 rounded-full bg-surface/10 blur-3xl"></div>
            <div class="absolute -bottom-20 -left-20 h-56 w-56 rounded-full bg-black/20 blur-3xl"></div>

            <div class="relative p-5 sm:p-8">

                <!-- Verdict Summary (above the score) -->
                @if (!string.IsNullOrWhiteSpace(Model.ReviewSummary))
                {
                    <div class="mb-5 sm:mb-6">
                        <div class="mb-2 text-[10px] font-bold uppercase tracking-[0.25em] text-white/70">
                            Verdict Summary
                        </div>
                        <p class="text-sm font-medium leading-relaxed text-white/90">
                            @Model.ReviewSummary
                        </p>
                    </div>

                    <div class="mb-5 border-t border-white/20 sm:mb-6"></div>
                }

                <!-- Score + verdict + meter -->
                <div class="flex flex-col gap-5 sm:gap-6 lg:flex-row lg:items-center lg:justify-between">

                    <!-- Score + verdict -->
                    <div class="flex items-center gap-4 sm:gap-5">

                        <div class="text-5xl font-black leading-none drop-shadow-lg sm:text-7xl lg:text-8xl">
                            @(Model.ReviewScore?.ToString("0.0"))
                        </div>

                        <div>
                            <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/60 sm:text-xs">
                                out of 10
                            </div>

                            <div class="mt-1 inline-flex rounded-full bg-surface/15 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.25em]">
                                TheGameVoice Score
                            </div>

                            <div class="mt-2 text-base font-black uppercase tracking-[0.35em] text-white/90 sm:text-lg">
                                @Model.ReviewVerdict
                            </div>
                        </div>

                    </div>

                    <!-- Segmented meter -->
                    <div class="flex flex-1 items-center gap-1.5 lg:max-w-md" aria-hidden="true">
                        @for (var i = 1; i <= 10; i++)
                        {
                            <span class="h-1.5 flex-1 rounded-full sm:h-2 @(i <= filledSegments ? "bg-white" : "bg-white/20")"></span>
                        }
                    </div>

                </div>

                <!-- View Game Hub -->
                @if (Model.ArticleGames != null && Model.ArticleGames.Any())
                {
                    var game = Model.ArticleGames.First().Game;

                    <div class="mt-5 border-t border-white/20 pt-4 sm:mt-6 sm:pt-5">
                        <a asp-controller="Games"
                           asp-action="Details"
                           asp-route-slug="@game.Slug"
                           class="inline-flex items-center justify-center gap-2 rounded-xl bg-surface px-4 py-3 text-xs font-bold uppercase tracking-wide text-[#7c3aed] shadow-lg transition-transform duration-300 hover:-translate-y-0.5 hover:bg-surface-muted sm:px-5 sm:py-3.5">
                            View Game Hub
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" />
                            </svg>
                        </a>
                    </div>
                }

            </div>
        </div>

    </section>
}
