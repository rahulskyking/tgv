@{
    var pageTitle = ViewData["Title"]?.ToString();
    var metaDescription = ViewData["MetaDescription"]?.ToString();
    var canonicalUrl = ViewData["CanonicalUrl"]?.ToString();
    var ogType = ViewData["OgType"]?.ToString();

    pageTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? SeoText.DefaultTitle : pageTitle.Trim();
    metaDescription = string.IsNullOrWhiteSpace(metaDescription)
        ? SeoText.DefaultDescription : metaDescription.Trim();
    ogType = string.IsNullOrWhiteSpace(ogType) ? "website" : ogType;
}
<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>

    <meta charset="utf-8" />

    @*  THEME BOOTSTRAP — must stay first in <head>.
        Applies the saved (or OS) theme before the browser paints, so there
        is no white flash on a dark-mode page load. Keep it inline. *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem("tgv-theme");

                var theme = saved
                    || (window.matchMedia
                        && window.matchMedia("(prefers-color-scheme: dark)").matches
                            ? "dark"
                            : "light");

                document.documentElement.setAttribute("data-theme", theme);
            } catch (e) { }
        })();
    </script>

    <meta name="color-scheme" content="light dark" />

    @*  viewport-fit=cover lets .tgv-container honour the notch/safe area. *@
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    @* Shared metadata is rendered here only; views supply values via ViewData. *@
    <title>@pageTitle</title>
    <meta name="description" content="@metaDescription" />

    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="@ogType" />

    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl" />
    }

    @RenderSection("Head", required: false)

    @*  One compiled stylesheet: tailwind.config.js + wwwroot/css/app.css
        → wwwroot/css/site.css  (npm run css:build) *@
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="alternate"
          type="application/rss+xml"
          title="TheGameVoice RSS Feed"
          href="/feed" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap"
          rel="stylesheet">
</head>

<body class="bg-canvas">

    @await Component.InvokeAsync("Navigation")

    <partial name="~/Views/Shared/Components/_Alerts.cshtml" />

    <main>

        @RenderBody()

    </main>

    @await Html.PartialAsync(
        "~/Views/Shared/Layout/_Footer.cshtml")

    <script src="~/js/theme.js" asp-append-version="true"></script>
    @*  Shared UX helpers: toast dismissal + data-confirm dialogs. The dirty
        guard / bulk-select parts simply find no matching markup here. *@
    <script src="~/js/admin-ux.js" asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>