<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>

    <meta charset="utf-8" />

    @*  THEME BOOTSTRAP — must stay first in <head>.
        Applies the saved (or OS) theme before the browser paints, so there
        is no white flash on a dark-mode page load. Keep it inline. *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem("tgv-theme");

                var theme = saved
                    || (window.matchMedia
                        && window.matchMedia("(prefers-color-scheme: dark)").matches
                            ? "dark"
                            : "light");

                document.documentElement.setAttribute("data-theme", theme);
            } catch (e) { }
        })();
    </script>

    <meta name="color-scheme" content="light dark" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    @RenderSection("Head", required: false)
    <title>
        @(ViewData["Title"] ?? "TheGameVoice")
    </title>

    <meta name="description"
          content="@(ViewData["Description"] ?? "Gaming News, Reviews and Features")" />

    <meta property="og:title"
          content="@(ViewData["Title"] ?? "TheGameVoice")" />

    <meta property="og:description"
          content="@(ViewData["Description"] ?? "Gaming News, Reviews and Features")" />


@if (ViewData["CanonicalUrl"] != null)
{
    <link rel="canonical"
          href="@ViewData["CanonicalUrl"]" />
}
    <meta property="og:type"
          content="website" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
          
    <link rel="stylesheet"
          href="~/css/app.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/theme.css" />
    <link rel="stylesheet"
          href="~/css/theme-utilities.css" />
    @*  Dark theme layer — must be the LAST stylesheet. *@
    <link rel="stylesheet"
          href="~/css/theme-dark.css"
          asp-append-version="true" />
    <link rel="alternate"
          type="application/rss+xml"
          title="TheGameVoice RSS Feed"
          href="/feed" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap"
          rel="stylesheet">
</head>

<body class="bg-slate-50 color: var(--tgv-text);">

    @await Component.InvokeAsync("Navigation")

    <main>

        @RenderBody()

    </main>

    @await Html.PartialAsync(
        "~/Views/Shared/Layout/_Footer.cshtml")

    <script src="~/js/theme.js" asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>