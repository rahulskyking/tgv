<footer class="mt-24 border-t border-default bg-white">

    <div class="tgv-container py-16">

        <div class="grid gap-12 md:grid-cols-3">

            <!-- BRAND -->

            <div>

                <a asp-controller ="Home"
                                  asp-action="Index"
                                  class="text-muted transition hover:text-primary">
                    class="text-2xl font-black text-primary">

                    TheGameVoice

                </a>

                <p class="mt-4 max-w-sm text-sm leading-7 text-muted">

                    We bring you honest game reviews, previews, opinions, and podcast conversations with people from the game industry.

                </p>

            </div>

            <!-- EXPLORE -->

            <div>

                <h3 class="mb-5 text-sm font-bold uppercase tracking-[0.18em]">

                    Explore

                </h3>

                <div class="flex flex-col gap-3">

                 
                    <a asp-controller="News"
                       asp-action="Index"
                       class="text-muted transition hover:text-primary">

                        Articles

                    </a>

                @*     <a asp-controller="Games"
                       asp-action="Index"
                       class="text-muted transition hover:text-primary">

                        Games

                    </a> *@

                </div>

            </div>

            <!-- COMPANY -->

            <div>

                <h3 class="mb-5 text-sm font-bold uppercase tracking-[0.18em]">

                    Company

                </h3>

                <div class="flex flex-col gap-3">

                    <a asp-controller="Pages"
                       asp-action="About"
                       class="text-muted transition hover:text-primary">

                        About

                    </a>

                  @*   <a asp-controller="Pages"
                       asp-action="Contact"
                       class="text-muted transition hover:text-primary">

                        Contact

                    </a> *@

                    <a asp-controller="Pages"
                       asp-action="ReviewPolicy"
                       class="text-muted transition hover:text-primary">

                        Review Policy

                    </a>

                </div>

            </div>

        </div>

        <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-default pt-6 text-sm text-muted md:flex-row">

            <p>

                © @DateTime.UtcNow.Year TheGameVoice.
                All rights reserved.

            </p>

        </div>

    </div>

</footer>