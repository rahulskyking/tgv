<footer class="mt-24 border-t border-default bg-white">

    <div class="tgv-container py-16">

        <div class="grid gap-12 md:grid-cols-3">

            <!-- BRAND -->

            <div>

                <h2 class="text-2xl font-black text-primary">

                    TheGameVoice

                </h2>

              

            </div>

            <!-- CONTENT -->

            <div>


                <div class="flex flex-col gap-2">

                    <a asp-controller="News"
                       asp-action="Index"
                       class="text-muted transition hover:text-primary">
                        News
                    </a>

                    <a asp-controller="Reviews"
                       asp-action="Index"
                       class="text-muted transition hover:text-primary">
                        Reviews
                    </a>

                    <a asp-controller="Features"
                       asp-action="Index"
                       class="text-muted transition hover:text-primary">
                        Features
                    </a>

                    <a asp-controller="Games"
                       asp-action="Index"
                       class="text-muted transition hover:text-primary">
                        Games
                    </a>

                </div>

            </div>

            <!-- COMPANY -->

            <div>

               

                <div class="flex flex-col gap-2">

                    <a asp-controller="Pages"
                       asp-action="About"
                       class="text-muted transition hover:text-primary">
                        About
                    </a>

                    <a asp-controller="Pages"
                       asp-action="Contact"
                       class="text-muted transition hover:text-primary">
                        Contact
                    </a>

                    <a asp-controller="Pages"
                       asp-action="ReviewPolicy"
                       class="text-muted transition hover:text-primary">
                        Review Policy
                    </a>

                </div>

            </div>

        </div>

        <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-default pt-6 text-sm text-muted md:flex-row">

            <p>

                © @DateTime.UtcNow.Year TheGameVoice. All rights reserved.

            </p>

         

        </div>

    </div>

</footer>