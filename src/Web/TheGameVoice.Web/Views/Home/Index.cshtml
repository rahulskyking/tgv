@model TheGameVoice.Web.ViewModels.Home.HomePageViewModel

<div class="tgv-container space-y-12 py-6 md:space-y-16 md:py-10 lg:space-y-20">
    <!-- HERO + TRENDING -->
    <!-- HERO + TRENDING -->

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-4">

        
        <!-- HERO -->
        <!-- HERO -->

        <div class="lg:col-span-3 lg:border-r lg:border-slate-300 lg:pr-12">

            @{
                var hero = Model.HeroArticle;

                var secondary =
                Model.LatestNews
                .Where(x => hero == null || x.Id != hero.Id)
                .Take(5)
                .ToList();
            }

            @if (hero != null)
            {
                <div class="grid gap-4 lg:grid-cols-3">

                    <!-- MAIN HERO -->

                    <div class="lg:col-span-2">

                        <a asp-controller="News"
                           asp-action="Details"
                           asp-route-slug="@hero.Slug"
                           class="group block">

                            <div class="relative overflow-hidden rounded-2xl">

                                @if (hero.FeaturedImage != null)
                                {
                                    <img src="@hero.FeaturedImage.FilePath"
                                         alt="@hero.Title"
                                         class="h-[420px] w-full object-cover transition duration-700 group-hover:scale-105" />
                                }

                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

                                <div class="absolute bottom-0 left-0 p-8">

                                    @if (hero.Category != null)
                                    {
                                        <div class="mb-3 text-xs font-bold uppercase tracking-[0.15em] text-primary">

                                            @hero.Category.Name

                                        </div>
                                    }

                                    <h1 class="max-w-3xl text-3xl font-bold leading-tight text-white md:text-5xl">

                                        @hero.Title

                                    </h1>

                                </div>

                            </div>

                        </a>

                    </div>

                    <!-- RIGHT COLUMN -->

                    <div class="space-y-4">

                        @foreach (var article in secondary.Take(2))
                        {
                            <a asp-controller="News"
                               asp-action="Details"
                               asp-route-slug="@article.Slug"
                               class="group block">

                                <div class="relative overflow-hidden rounded-2xl">

                                    @if (article.FeaturedImage != null)
                                    {
                                        <img src="@article.FeaturedImage.FilePath"
                                             alt="@article.Title"
                                             class="h-[202px] w-full object-cover transition duration-500 group-hover:scale-105" />
                                    }

                                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>

                                    <div class="absolute bottom-0 left-0 p-4">

                                        <h3 class="line-clamp-2 text-lg font-semibold text-white">

                                            @article.Title

                                        </h3>

                                    </div>

                                </div>

                            </a>
                        }

                    </div>

                </div>

                <!-- BOTTOM ROW -->

                <div class="mt-4 grid gap-4 md:grid-cols-3">

                    @foreach (var article in secondary.Skip(2).Take(3))
                    {
                        <a asp-controller="News"
                           asp-action="Details"
                           asp-route-slug="@article.Slug"
                           class="group block">

                            <div class="relative overflow-hidden rounded-2xl">

                                @if (article.FeaturedImage != null)
                                {
                                    <img src="@article.FeaturedImage.FilePath"
                                         alt="@article.Title"
                                         class="h-[180px] w-full object-cover transition duration-500 group-hover:scale-105" />
                                }

                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>

                                <div class="absolute bottom-0 left-0 p-4">

                                    <h3 class="line-clamp-2 text-base font-semibold text-white">

                                        @article.Title

                                    </h3>

                                </div>

                            </div>

                        </a>
                    }

                </div>
            }

        </div>

        <!-- TRENDING -->

        <aside class="lg:pl-4">

            <div class="mb-8 flex items-center gap-3">

                <div class="h-6 w-1 bg-primary"></div>

                <h2 class="text-2xl font-bold tracking-tight text-slate-900">

                    Trending

                </h2>

            </div>

            @{
                var trendingItems =
                Model.TrendingArticles
                .Select((article, index) =>
                new { article, index })
                .ToList();
            }

            <div class="space-y-6">

                <div class="space-y-6">

                   
                    @foreach (var item in trendingItems)
                    {
                        <a asp-controller="News"
                           asp-action="Details"
                           asp-route-slug="@item.article.Slug"
                           class="group block border-b border-slate-200 pb-6">

                            <div class="flex items-center gap-4">

                                @if (item.article.FeaturedImage != null)
                                {
                                    <div class="h-20 w-32 shrink-0 overflow-hidden rounded-xl border border-slate-200">

                                        <img src="@item.article.FeaturedImage.FilePath"
                                             alt="@item.article.Title"
                                             class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />

                                    </div>
                                }

                                <div class="min-w-0 flex-1">

                                    <div class="mb-2 flex items-center gap-3">

                                        <span class="text-2xl font-bold text-primary/40">

                                            @((item.index + 1).ToString("D2"))

                                        </span>

                                        @if (item.article.Category != null)
                                        {
                                            <span class="text-[11px] font-bold uppercase tracking-[0.15em] text-primary">

                                                @item.article.Category.Name

                                            </span>
                                        }

                                </div>

                                <h3 class="line-clamp-3 text-sm font-semibold leading-snug text-slate-900 transition group-hover:text-primary">

                                    @item.article.Title

                                </h3>

                                <div class="mt-2 text-xs text-slate-500">

                                    @(item.article.PublishedAt?
                                                                        .ToLocalTime()
                                                                        .ToString("dd MMM yyyy"))

                                </div>

                                </div>

                            </div>

                        </a>
                    }
                    

                </div>

            </div>

        </aside>

    </div>


    <!-- LATEST NEWS -->

    <section>

        @await Html.PartialAsync(
        "~/Views/Shared/Components/_SectionHeader.cshtml",
                "Latest News")

        <div class="mt-8">

            @foreach (var article in Model.LatestNews.Take(6))
            {
                @await Html.PartialAsync(
                "~/Views/Shared/Components/_ArticleCard.cshtml",
                        article)
                        }

        </div>
        <div class="mt-10 text-center">

            <a asp-controller="News"
               asp-action="Index"
               class="inline-flex items-center rounded-full border border-primary px-6 py-3 font-medium text-primary transition hover:bg-primary hover:text-white">

                View More News

            </a>

        </div>

    </section>

    <!-- TRENDING GAMES -->

   @*  <section>

        @await Html.PartialAsync(
        "~/Views/Shared/Components/_SectionHeader.cshtml",
