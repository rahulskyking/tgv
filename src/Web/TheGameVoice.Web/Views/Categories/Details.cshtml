@model TheGameVoice.Web.ViewModels.Categories.CategoryDetailsViewModel

<div class="tgv-container py-12 space-y-20">

    
    <!-- CATEGORY HERO -->

    <section class="py-10">

        <div class="max-w-4xl">

            <div class="mb-4">

                <span class="text-sm font-black uppercase tracking-[0.3em] text-primary">

                    Category

                </span>

            </div>

            <h1 class="tgv-display text-6xl lg:text-8xl">

                @Model.Category.Name

            </h1>

            <p class="mt-6 max-w-3xl text-xl leading-relaxed text-muted">

                Latest @Model.Category.Name coverage,
                news, reviews, features and editorial content
                from TheGameVoice.

            </p>

            <div class="mt-8 flex items-center gap-6">

                <div>

                    <div class="text-3xl font-black">

                        @Model.Articles.Count

                    </div>

                    <div class="text-sm uppercase tracking-wider text-muted">

                        Articles

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- ARTICLES -->

    <section>

       

        <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">

            @foreach (var article in Model.Articles)
            {
                <partial name="~/Views/Shared/Components/_CategoryArticleCard.cshtml"
                         model="article" />
            }

        </div>

    </section>
   
</div>
