@model TheGameVoice.Web.ViewModels.Search.SearchResultsViewModel

<div class="tgv-container py-12">

    <!-- SEARCH HERO -->

    <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">

        <div class="p-8 md:p-12">

            <div class="mb-4">

                <span class="inline-flex items-center rounded-full bg-primary/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.15em] text-primary">

                    Search

                </span>

            </div>

            <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">

                Search TheGameVoice

            </h1>

            <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">

                Find gaming news, reviews, impressions, guides and features across TheGameVoice.

            </p>

            <form method="get"
                  asp-controller="Search"
                  asp-action="Index"
                  class="mt-8">

                <div class="flex flex-col gap-3 md:flex-row">

                    <input type="text"
                           name="query"
                           value="@Model.Query"
                           placeholder="Search articles..."
                           class="flex-1 rounded-2xl border border-slate-200 bg-slate-50 px-6 py-4 text-base outline-none transition focus:border-primary focus:bg-white" />

                    <button type="submit"
                            class="rounded-2xl bg-primary px-8 py-4 font-semibold text-white transition hover:opacity-90">

                        Search

                    </button>

                </div>

            </form>

        </div>

    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <section class="mt-12">

            <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 pb-4">

                <div class="text-sm text-slate-500">

                    Found

                    <span class="font-semibold text-slate-900">

                        @Model.Articles.Count

                    </span>

                    result(s) for

                    <span class="font-semibold text-primary">

                        "@Model.Query"

                    </span>

                </div>

            </div>

            @if (Model.Articles.Any())
            {
                <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

                    @foreach (var article in Model.Articles)
                    {
                        <partial name="~/Views/Shared/Components/_ArticleCard.cshtml"
                                 model="article" />
                    }

                </div>
            }
            else
            {
                <div class="rounded-3xl border border-slate-200 bg-white p-16 text-center shadow-sm">

                    <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-slate-100 text-3xl">

                        🔍

                    </div>

                    <h2 class="text-3xl font-bold text-slate-900">

                        No Results Found

                    </h2>

                    <p class="mt-4 text-slate-500">

                        We couldn't find any articles matching

                        <span class="font-semibold text-slate-700">

                            "@Model.Query"

                        </span>

                    </p>

                    <p class="mt-2 text-slate-500">

                        Try different keywords, broader terms or check your spelling.

                    </p>

                </div>
            }

        </section>
    }
    else
    {
        <section class="mt-12">

            <div class="rounded-3xl border border-slate-200 bg-white p-16 text-center shadow-sm">

                <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-slate-100 text-3xl">

                    🎮

                </div>

                <h2 class="text-3xl font-bold text-slate-900">

                    Search Gaming Content

                </h2>

                <p class="mt-4 text-slate-500">

                    Search for news, reviews, games, opinions and features from TheGameVoice.

                </p>

            </div>

        </section>
    }

</div>