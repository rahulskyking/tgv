@model TheGameVoice.Web.ViewModels.News.ArticleDetailsViewModel

<div class="tgv-container py-12">


    <div id="reading-progress"></div>

    <article class="mx-auto max-w-[1500px]">

        <!-- BREADCRUMB -->
        <nav class="mb-10 flex flex-wrap items-center text-sm text-slate-500">

            <a asp-controller="Home"
               asp-action="Index"
               class="transition hover:text-primary">

                Home

            </a>

            <span class="mx-2 opacity-40">/</span>

            @if (Model.Article.Category != null)
            {
                <a asp-controller="Categories"
                   asp-action="Details"
                   asp-route-slug="@Model.Article.Category.Slug"
                   class="transition hover:text-primary">

                    @Model.Article.Category.Name

                </a>

                <span class="mx-2 opacity-40">/</span>
            }

            <span class="max-w-[32ch] truncate font-medium text-slate-900">

                @Model.Article.Title

            </span>

        </nav>

        <!-- HERO -->
        <section class="mb-8 border-b border-slate-200 pb-8">

            <div class="mb-3">

                <partial name="~/Views/Shared/Components/_CategoryBadge.cshtml"
                         model="@Model.Article.Category.Name" />

            </div>

            <h1 class="max-w-5xl text-3xl font-extrabold leading-[1.05] tracking-tight text-slate-900 md:text-5xl xl:text-6xl">
                @Model.Article.Title

            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.Article.Summary))
            {
                <p class="mt-3 max-w-4xl text-base leading-relaxed text-slate-600 md:text-lg">
                    @Model.Article.Summary

                </p>
            }

            @{
                var wordCount =
                string.IsNullOrWhiteSpace(Model.Article.Content)
                ? 0
                : System.Text.RegularExpressions.Regex
                .Replace(Model.Article.Content, "<.*?>", "")
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Length;

                var readingTime =
                Math.Max(1, wordCount / 200);
            }

            <div class="mt-5 border-t border-slate-200 pt-4">
                <div class="flex items-center gap-4">

                    @if (Model.AuthorAvatarUrl != null)
                    {
                        <img src="@Model.AuthorAvatarUrl"
                             alt="@Model.AuthorName"
                             class="h-9 w-9 rounded-full object-cover border border-slate-200" />
                    }
                    else
                    {
                        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-sm font-bold text-slate-600">

                            @Model.AuthorName.Substring(0, 1)

                        </div>
                    }

                    <div>
                        <div class="text-sm font-semibold text-slate-900">
                            By @Model.AuthorName
                        </div>

                        <div class="text-xs text-slate-500">
                            @(Model.Article.PublishedAt?
                                                        .ToLocalTime()
                                                        .ToString("dd MMM yyyy"))
                            •
                            @readingTime min read
                        </div>

                    </div>

                </div>

            </div>

        </section>

        <!-- BODY -->
        <div class="grid gap-12 lg:grid-cols-12">

            <main class="lg:col-span-8">

                @if (Model.Article.FeaturedImage != null)
                {
                    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm lg:-mt-2">
                        <img src="@Model.Article.FeaturedImage.FilePath"
                             alt="@Model.Article.Title"
                             class="w-full object-cover transition duration-700 hover:scale-[1.02]" />

                    </div>
                }

                <div class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm md:p-10">
                    <div class="article-content">

                        @Html.Raw(Model.Article.Content)

                    </div>

                </div>

            </main>

            <aside class="lg:col-span-4">

                <partial name="~/Views/Shared/Components/_ArticleSidebar.cshtml"
                         model="Model" />

            </aside>

        </div>

        <!-- CONTINUE READING -->
        @if (Model.RelatedArticles.Any())
        {
            <section class="mt-16 border-t border-slate-200 pt-8">

                <div class="mb-8 flex items-center gap-5">

                    <h2 class="text-3xl font-bold tracking-tight text-slate-900">

                        Continue Reading

                    </h2>

                    <div class="h-px flex-1 bg-slate-200"></div>

                </div>

                <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">

                    @foreach (var article in Model.RelatedArticles)
                    {
                        <partial name="~/Views/Shared/Components/_RelatedArticleCard.cshtml"
                                 model="article" />
                    }

                </div>

            </section>
        }

    </article>


</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        const key =
            "article-view-@Model.Article.Id";

        if (localStorage.getItem(key))
            return;

        fetch(
            "/api/article-views/@Model.Article.Id",
            {
                method: "POST"
            });

        localStorage.setItem(
            key,
            new Date().toISOString());

    });
</script>

<script>
    window.addEventListener("scroll", () => {

        const article =
            document.querySelector(".article-content");

        if (!article)
            return;

        const progress =
            ((window.scrollY - article.offsetTop) /
            (article.scrollHeight - window.innerHeight))
            * 100;

        document
            .getElementById("reading-progress")
            .style.width =
            Math.min(
                100,
                Math.max(
                    0,
                    progress))
            + "%";

    });
</script>
